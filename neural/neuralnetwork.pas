    constructor Create(pStep: TNeuralFloat); reintroduce; overload;
    procedure Compute(); override;
  end;

  /// Quantization-aware training (QAT) fake-quantize of the LAYER INPUT.
  // Per-tensor SYMMETRIC int8 fake-quant (torch.ao.quantization style):
  //   scale = max|x| / qmax    (qmax = FStruct[0], default 127)
  //   x_q   = round(clip(x / scale, -qmax, qmax)) * scale
  // so FORWARD output = dequant(quant(x)), simulating int8 rounding/clamp at
  // FP32 precision. The scale convention exactly mirrors the landed int8 WEIGHT
  // path (QuantizeWeightsInt8: scale = max|row|/127, round-to-nearest, clamp to
  // [-127,127], dequant = code*scale), so a QAT-trained net's activation scales
  // line up with the weight-only int8 export format.
  //
  // OBSERVER (torch MovingAverageMinMaxObserver, simplest viable form): the
  // scale is observer-driven, NOT learned. During a TRAINING forward pass the
  // running max-abs statistic in FFloatSt[1] is updated by an EMA:
  //   r := momentum * r + (1 - momentum) * max|x|   (momentum = FFloatSt[0])
  // The very first observation seeds r directly (so a cold layer calibrates
  // immediately). At INFERENCE (FStruct[1] <> 0, "frozen", or whenever the net
  // is not training) the running statistic is FROZEN and only used to quantize.
  // scale is derived as r / qmax (1.0 when r is still zero).
  //
  // BACKWARD: straight-through estimator, reusing the same STE clamp machinery
  // as TNNetStraightThroughEstimator / TNNetSoftCapping — the rounding is
  // treated as the identity INSIDE the representable range, so the gradient
  // passes through UNCHANGED where qmin*scale <= x <= qmax*scale and is ZEROED
  // outside that clamp band. The 0/1 per-element mask is computed in Compute()
  // into FOutputErrorDeriv and applied in Backpropagate() exactly like
  // TNNetSoftCapping, then the (masked) error is added to the previous layer.
  //
  // Scope v1: per-tensor symmetric, observer-driven running max-abs, applied to
  // activations (the layer sits in the graph and fake-quantizes its input).
  // Learned scale and per-channel/asymmetric variants are follow-ups.
  // FStruct[0]=qmax, FStruct[1]=frozen flag; FFloatSt[0]=momentum,
  // FFloatSt[1]=running max-abs. All round-trip via Save/Load.
  // Coded by Claude (AI).
  TNNetFakeQuantize = class(TNNetIdentity)
  private
    function GetRunningMaxAbs(): TNeuralFloat;
    function GetScale(): TNeuralFloat;
  public
    constructor Create(); overload; override;
    constructor Create(pMomentum: TNeuralFloat); reintroduce; overload;
    constructor Create(pQMax: integer; pMomentum, pRunningMaxAbs: TNeuralFloat;
      pFrozen: integer); reintroduce; overload;
    procedure Compute(); override;
    procedure Backpropagate(); override;
    // Freezes / unfreezes the observer (stop / resume running-stat updates).
    procedure Freeze();
    procedure Unfreeze();
    // Current dequantization scale = running max-abs / qmax (1.0 if uncalibrated).
    property Scale: TNeuralFloat read GetScale;
    property RunningMaxAbs: TNeuralFloat read GetRunningMaxAbs;
  end;

