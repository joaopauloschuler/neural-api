{ TNNetLayerConcatedWeights }
procedure TNNetLayerConcatedWeights.AfterWeightUpdate();
begin
  inherited AfterWeightUpdate();
  if FNeuronWeightList.Count > 0 then
  begin
    if FShouldConcatWeights then
    begin
      BuildBiasOutput();
      // Both int8-quantized and low-memory inference need FBiasOutput (biases
      // stay FP32 and are added at compute time), so the bias is always built.
      // Only the concatenated weight cache is skipped:
      //  - int8: the per-neuron FP32 volumes are shrunk to a single element,
      //    so concatenating them would build a garbage cache (the fused int8
      //    kernels consume FQuantTable directly).
      //  - low-memory: ComputeLowMemoryCPU reads per-neuron weights directly,
      //    so the persistent cache is pure overhead.
      if not FQuantInt8 and not ActiveLowMemory() then
      begin
        FNeuronWeightList.ConcatInto(FConcatedWeights);
        if FShouldInterleaveWeights then
        begin
          FConcatedWInter.InterleaveWithXFrom(FConcatedWeights, FVectorSize);
        end;
      end;
    end;
  end;
end;

// Construction-time int8 arming (TNNet.BuildQuantInt8). Instead of sizing
// N FP32 weight rows that the next QuantizeWeightsInt8 sweep would only
// shrink again - which drives the process to the FP32 high-water mark the
// allocator keeps but never returns to the OS - the layer goes DIRECTLY
// into the quantized state: row dims recorded (DequantizeWeightsInt8 can
// restore writable rows for the loaders), codes zeroed (dequantized weight
// 0 - the same "zero weights, valid forward" contract the inference-only
// InitGlorotBengioUniform gives), scales 1 (QuantizeWeightsInt8's zero-row
// convention). The checkpoint loaders need NO change: their existing
// EnsureWritableImportWeights -> fill -> re-quantize cycle restores real
// FP32 rows one layer at a time. Returns False - the caller then runs the
// inherited FP32 sizing - whenever arming does not apply: net not flagged,
// trainable layer (quantized layers are inference-only), linked/shared
// neurons, ineligible class, or rows already sized (ResizeTokenEmbeddings
// re-attaches a DEQUANTIZED head whose refilled rows must be preserved).
// Re-arming with unchanged dims is an idempotent no-op that PRESERVES any
// loaded codes; changed dims rebuild zeroed containers, mirroring the FP32
// semantics where a resize invalidates row content. Coded by Claude (AI).
function TNNetLayerConcatedWeights.ArmBuildQuantInt8Storage(
  x, y, d: integer): boolean;
var
  V: integer;
begin
  Result := false;
  if (FNN = nil) or (not FNN.FBuildQuantInt8) then exit;
  if FIsTrainable then exit;
  if FLinkedNeurons then exit;
  if not FCanSetNumWeightsForAllNeurons then exit;
  if FNeurons.Count = 0 then exit;
  V := x * y * d;
  if V <= 1 then exit; // nothing to quantize
  if not NeuralInt8QuantizableClass(Self) then exit;
  if FNeurons[0].Weights.Size > 1 then exit; // live FP32 rows: FP32 path
  if FQuantInt8 and (FQuantVectorSize = V) then exit(true);
  FQuantVectorSize := V;
  FQuantWSizeX := x;
  FQuantWSizeY := y;
  FQuantWSizeD := d;
  // ReSize does no zero fill, so the arming state is written explicitly:
  // zero codes = zero weights, unit scales.
  FQuantTable.ReSize(FNeurons.Count, 1, V);
  FQuantTable.Fill(0);
  FQuantTable.ScaleData.Fill(1);
  FQuantInt8 := true;
  // Parity with the inherited FP32 sizing path: refresh the fast mirror and
  // run the post-sizing hook (the FQuantInt8 guard inside AfterWeightUpdate
  // keeps it away from the concatenated caches).
  BuildArrNeurons();
  AfterWeightUpdate();
  Result := true;
end;

procedure TNNetLayerConcatedWeights.SetNumWeightsForAllNeurons(
  NumWeights: integer);
begin
  if ArmBuildQuantInt8Storage(NumWeights, 1, 1) then exit;
  inherited SetNumWeightsForAllNeurons(NumWeights);
end;

procedure TNNetLayerConcatedWeights.SetNumWeightsForAllNeurons(
  x, y, d: integer);
begin
  if ArmBuildQuantInt8Storage(x, y, d) then exit;
  inherited SetNumWeightsForAllNeurons(x, y, d);
end;

// Quantizes one FP32 row (Count elements at Src) into int8 codes + a raw
// per-row scale, tolerating NON-FINITE source values: real checkpoints pad
// the vocab table with untrained rows whose bytes can decode to +/-Inf or
// NaN (Qwen2.5-7B-Instruct does), and Round() of a non-finite value raises
// EInvalidOp. The scale scan skips non-finite elements, +/-Inf lands on
// +/-127 and NaN codes as 0. A row with no finite non-zero element returns
// FALSE with zeroed codes and Scale 1 - the QuantizeWeightsInt8 zero-row
// convention. Coded by Claude (AI).
function QuantizeInt8RowTolerant(Src: TNeuralFloatArrPtr; Count: integer;
  Codes: PShortInt; out Scale: TNeuralFloat): boolean;
var
  i, CountM1: integer;
  MaxAbs: TNeuralFloat;
begin
  // Both loops are TNNetVolume primitives (rule #18): MaxAbsFinite is
  // the pointer-and-count max|row| that skips non-finite elements, and
  // QuantizeInt8 carries the same non-finite convention (NaN -> 0,
  // +/-Inf -> +/-127) into the codes. AVX2 builds run both 8 lanes at a time.
  MaxAbs := TNNetVolume.MaxAbsFinite(Src, Count);
  // Scale underflows single to 0 when MaxAbs < ~1.8e-43 - such a row
  // dequantizes to zero either way, so it takes the zero-row branch.
  Scale := MaxAbs / 127;
  Result := Scale > 0;
  if Result then
    TNNetVolume.QuantizeInt8(TNeuralInt8ArrPtr(Codes), Src, Count, MaxAbs)
  else
  begin
    // Zero row (or nothing finite): zero codes with unit scale.
    CountM1 := Count - 1;
    for i := 0 to CountM1 do Codes[i] := 0;
    Scale := 1;
  end;
end;

procedure TNNetLayerConcatedWeights.QuantizeWeightsInt8();
var
  MaxQuantNeuronPos: integer;
  MaxShrinkNeuronPos: integer;
  NeuronCnt, RowBase: integer;
  Scale: TNeuralFloat;
  W: TNNetVolume;
begin
  if FQuantInt8 then exit;          // idempotent
  if FLinkedNeurons then exit;      // shared neurons: owner layer decides
  if FNeurons.Count = 0 then exit;
  if FNeurons[0].Weights.Size <= 1 then exit; // nothing to quantize
  FQuantVectorSize := FNeurons[0].Weights.Size;
  FQuantWSizeX := FNeurons[0].Weights.SizeX;
  FQuantWSizeY := FNeurons[0].Weights.SizeY;
  FQuantWSizeD := FNeurons[0].Weights.Depth;
  FQuantTable.ReSize(FNeurons.Count, 1, FQuantVectorSize);
  MaxQuantNeuronPos := FNeurons.Count - 1;
  for NeuronCnt := 0 to MaxQuantNeuronPos do
  begin
    W := FNeurons[NeuronCnt].Weights;
    if W.Size <> FQuantVectorSize then
    begin
      FErrorProc('QuantizeWeightsInt8: neuron ' + IntToStr(NeuronCnt) +
        ' weight size ' + IntToStr(W.Size) + ' differs from ' +
        IntToStr(FQuantVectorSize) + '.');
      exit;
    end;
    RowBase := NeuronCnt * FQuantVectorSize;
    QuantizeInt8RowTolerant(TNeuralFloatArrPtr(@W.FData[0]),
      FQuantVectorSize, @FQuantTable.FData[RowBase], Scale);
    FQuantTable.Scale[NeuronCnt, 0] := Scale;
  end;
  // Free the FP32 storage only after every row quantized successfully.
  // (1,1,1) matches the pre-SetNumWeights state; SetLength inside ReSize
  // genuinely shrinks the heap allocations.
  MaxShrinkNeuronPos := FNeurons.Count - 1;
  for NeuronCnt := 0 to MaxShrinkNeuronPos do
  begin
    FNeurons[NeuronCnt].Weights.ReSize(1, 1, 1);
    FNeurons[NeuronCnt].Weights.Fill(0);
  end;
  FConcatedWeights.ReSize(1, 1, 1);
  FConcatedWInter.ReSize(1, 1, 1);
  FQuantInt8 := true;
end;

procedure TNNetLayerConcatedWeights.DequantizeWeightsInt8();
var
  MaxDequantNeuronPos: integer;
  NeuronCnt: integer;
  W: TNNetVolume;
begin
  if not FQuantInt8 then exit;
  MaxDequantNeuronPos := FNeurons.Count - 1;
  for NeuronCnt := 0 to MaxDequantNeuronPos do
  begin
    W := FNeurons[NeuronCnt].Weights;
    W.ReSize(FQuantWSizeX, FQuantWSizeY, FQuantWSizeD);
    FQuantTable.DequantizeRowTo(NeuronCnt, 0, TNeuralFloatArrPtr(@W.FData[0]));
  end;
  FQuantTable.ReSize(0, 0, 0);
  FQuantInt8 := false;
  AfterWeightUpdate(); // rebuild the concatenated cache / bias output
end;

procedure TNNetLayerConcatedWeights.ImportInt8QuantRow(NeuronIdx: integer;
  Src: TNNetVolume; SrcOffset: integer; pExtraScale: TNeuralFloat);
var
  RowBase: integer;
  Scale: TNeuralFloat;
begin
  if not FQuantInt8 then
  begin
    FErrorProc('ImportInt8QuantRow: layer is not int8 quantized.');
    exit;
  end;
  if (NeuronIdx < 0) or (NeuronIdx >= FNeurons.Count) then
  begin
    FErrorProc('ImportInt8QuantRow: neuron index ' + IntToStr(NeuronIdx) +
      ' is outside 0..' + IntToStr(FNeurons.Count - 1) + '.');
    exit;
  end;
  if (SrcOffset < 0) or (SrcOffset + FQuantVectorSize > Src.Size) then
  begin
    FErrorProc('ImportInt8QuantRow: row at offset ' + IntToStr(SrcOffset) +
      ' plus ' + IntToStr(FQuantVectorSize) + ' elements exceeds the ' +
      IntToStr(Src.Size) + '-element source.');
    exit;
  end;
  RowBase := NeuronIdx * FQuantVectorSize;
  if QuantizeInt8RowTolerant(TNeuralFloatArrPtr(@Src.FData[SrcOffset]),
       FQuantVectorSize, @FQuantTable.FData[RowBase], Scale) then
    FQuantTable.Scale[NeuronIdx, 0] := pExtraScale * Scale
  else
    // Zero row: zero codes with unit scale, matching QuantizeWeightsInt8's
    // zero-row convention (pExtraScale is irrelevant - dequant is 0 either
    // way - and scale 1 keeps requantize-after-dequantize exact).
    FQuantTable.Scale[NeuronIdx, 0] := 1;
end;

function TNNetLayerConcatedWeights.Int8QuantizedSizeBytes(): int64;
begin
  Result := FQuantTable.GetMemSize();
end;

function TNNetLayerConcatedWeights.CountWeights(): int64;
begin
  if FQuantInt8 and (not FLinkedNeurons)
  then Result := FQuantTable.Size
  else Result := inherited CountWeights();
end;

function TNNetLayerConcatedWeights.GetInt8QuantData(out pCodes: TInt8DynArr;
  out pScales: TNeuralFloatDynArr; out NumRows, VS: integer): boolean;
begin
  SetLength(pCodes, 0);
  SetLength(pScales, 0);
  NumRows := 0;
  VS := 0;
  Result := FQuantInt8;
  if not Result then exit;
  NumRows := FNeurons.Count;
  VS := FQuantVectorSize;
  FQuantTable.GetQuantData(pCodes, pScales);
end;

procedure TNNetLayerConcatedWeights.BuildBiasOutput();
var
  OutputCntX, OutputCntY: integer;
  MaxX, MaxY: integer;
  NeuronIdx: integer;
  MaxNeurons: integer;
  BiasValue: TNeuralFloatPtr;
begin
  MaxNeurons := FNeurons.Count - 1;
  FBiasOutput.ReSize(FOutputRaw);
  if High(FArrNeurons) < MaxNeurons then BuildArrNeurons();

  if (Self is TNNetConvolution) or (Self is TNNetGroupedConvolutionLinear) then
  begin
    MaxX := FOutput.SizeX - 1;
    MaxY := FOutput.SizeY - 1;

    for OutputCntX := 0 to MaxX do
    begin
      for OutputCntY := 0 to MaxY do
      begin
        BiasValue := FBiasOutput.GetRawPtr(OutputCntX, OutputCntY);
        for NeuronIdx := 0 to MaxNeurons do
        begin
          BiasValue^ := FArrNeurons[NeuronIdx].FBiasWeight;
          Inc(BiasValue);
        end;
      end;
    end;
  end
  else
  if Self is TNNetFullConnect then
  begin
    BiasValue := FBiasOutput.GetRawPtr(0, 0);
    for NeuronIdx := 0 to MaxNeurons do
    begin
      BiasValue^ := FArrNeurons[NeuronIdx].FBiasWeight;
      Inc(BiasValue);
    end;
  end
  else
  if ( not(Self is TNNetLocalConnect) and not(Self is TNNetLocalProduct) ) then
  begin
    FErrorProc('Error: bias output hasn''t been defined.');
  end;
end;

constructor TNNetLayerConcatedWeights.Create();
begin
  inherited Create();
  FNeuronWeightList := TNNetVolumeList.Create(false);
  FConcatedWeights := TNNetVolume.Create();
  FConcatedWInter := TNNetVolume.Create();
  FQuantTable := TNNetVolumeQuant8.Create();
  FBiasOutput := TNNetVolume.Create();
  FShouldConcatWeights := false;
  FShouldInterleaveWeights := false;
  FAfterWeightUpdateHasBeenCalled := false;
  FQuantInt8 := false;
  FQuantVectorSize := 0;
end;

destructor TNNetLayerConcatedWeights.Destroy();
begin
  FBiasOutput.Free;
  FQuantTable.Free;
  FConcatedWeights.Free;
  FNeuronWeightList.Free;
  FConcatedWInter.Free;
  {$IFDEF OpenCL}
  if Assigned(FNN) then
    FNN.FreeKernelIfNotShared('cai_dot_product_int8', FInt8Kernel);
  {$ENDIF}
  inherited Destroy();
end;

procedure TNNetLayerConcatedWeights.RefreshNeuronWeightList();
var
  MaxNeuronPos: integer;
  NeuronCnt: integer;
begin
  FNeuronWeightList.Clear;

  MaxNeuronPos := FNeurons.Count - 1;
  for NeuronCnt := 0 to MaxNeuronPos do
  begin
    FNeuronWeightList.Add(FNeurons[NeuronCnt].Weights);
  end;
end;

