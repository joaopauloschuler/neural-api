    constructor Create(pMaskValue: TNeuralFloat); reintroduce; overload;
    constructor Create(pMaskValue: TNeuralFloat; pOffset: integer;
      pLowerTriangle: boolean = False); reintroduce; overload;
    procedure Compute(); override;
  end;

