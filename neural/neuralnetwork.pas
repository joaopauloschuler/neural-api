function TNNetLayer.MulWeights(V: TNeuralFloat): TNNetLayer;
var
  MaxNeuronPos: integer;
  Cnt: integer;
  N: TNNetNeuron;
begin
  if FNeurons.Count > 0 then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      N := FNeurons[Cnt];  // #7: bind once
      N.Weights.Mul(V);
      {$IFDEF FPC}
      N.FBiasWeight *= V;
      {$ELSE}
      N.FBiasWeight := N.FBiasWeight * V;
      {$ENDIF}
    end;
  end;
  AfterWeightUpdate();
  Result := Self;
end;

procedure TNNetLayer.MulInertia(V: TNeuralFloat);
var
  MaxNeuronPos: integer;
  Cnt: integer;
  N: TNNetNeuron;
begin
  // Inference-only (SetTrainable(false)): the training volumes are freed.
  if not FIsTrainable then exit;
  if FNeurons.Count > 0 then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      N := FNeurons[Cnt];  // #7: bind once
      N.BackInertia.Mul(V);
      N.FBackInertia2.Mul(V);
      {$IFDEF FPC}
      N.FBiasInertia *= V;
      {$ELSE}
      N.FBiasInertia := N.FBiasInertia * V;
      {$ENDIF}
    end;
  end;
  AfterWeightUpdate();
end;

procedure TNNetLayer.MulDeltas(V: TNeuralFloat);
var
  MaxNeuronPos: integer;
  Cnt: integer;
  N: TNNetNeuron;
begin
  // Inference-only (SetTrainable(false)): the training volumes are freed.
  if not FIsTrainable then exit;
  if FNeurons.Count > 0 then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      N := FNeurons[Cnt];  // #7: bind once
      N.Delta.Mul(V);
      N.FBiasDelta := N.FBiasDelta * V;
    end;
  end;
  AfterWeightUpdate();
end;

procedure TNNetLayer.ClipDeltasToValue(MaxAbsValue: TNeuralFloat);
var
  MaxNeuronPos: integer;
  Cnt: integer;
  D: TNNetVolume;
  Neuron: TNNetNeuron;
begin
  // Inference-only (SetTrainable(false)): the training volumes are freed.
  if not FIsTrainable then exit;
  if MaxAbsValue <= 0 then exit;
  if FNeurons.Count > 0 then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      Neuron := FNeurons[Cnt];
      D := Neuron.Delta;
      // #13: the per-element saturate over the whole delta row is a bulk
      // clamp. ClampAbs leaves a NaN alone exactly as the scalar form did.
      TNNetVolume.ClampAbs(D.DataPtr, MaxAbsValue, D.Size);
      if Neuron.FBiasDelta > MaxAbsValue then
        Neuron.FBiasDelta := MaxAbsValue
      else if Neuron.FBiasDelta < -MaxAbsValue then
        Neuron.FBiasDelta := -MaxAbsValue;
    end;
  end;
  AfterWeightUpdate();
end;

procedure TNNetLayer.ClearBias();
var
  MaxNeuronPos: integer;
