  /// OpenCL forward helper for the depthwise 1-D convolution (TNNetDepthwiseConv1D).
  // Binds the cai_depthwise_conv1d entry point on the shared dot-product program's
  // device. Uploads the concatenated per-channel kernels + per-channel biases + the
  // previous layer's output, runs one work-item per output (time, channel) element
  // -- each reducing ONLY its own channel's length-K temporal kernel (zero-padding
  // OOB taps in-kernel) -- and reads the (linear, no-activation) output back.
  // Forward-only (backward stays on CPU).
  // Coded by Claude (AI).
  TNNetDepthwiseConv1DCL = class(TNNetKernelCL)
  private
    // Persistent device buffers (grow-only), reused every forward.
    FBufW, FBufBias, FBufX, FBufY: cl_mem;
    FCapW, FCapBias, FCapX, FCapY: csize_t;
  public
    constructor Create(NN: TNNet);
    destructor Destroy(); override;
    // PackedW: the C channels' length-K kernels concatenated [c*K + kk].
    // Bias: the C per-channel biases (uploaded even when suppressed; the flag
    // controls their use). X: the previous layer's output. Y receives the output.
    // Off = K-1 (causal) or K div 2 (SAME); SuppressBias = the layer's flag.
    // NewW=false keeps the resident kernel + bias buffers (weights unchanged).
    procedure Compute(PackedW, Bias, X, Y: TNNetVolume;
      SeqLen, Channels, Ksize, Off, SuppressBias: integer; NewW: boolean = true);
  end;

  /// OpenCL forward helper for the rotary positional embedding layer
  // (TNNetRotaryEmbedding). Binds the cai_rope entry point on the shared
  // dot-product program's device, uploads the previous-layer token tensor plus
  // the host-precomputed per-pair theta table (with all RoPE-scaling already
  // folded in on the host - the device only does the plain interleaved-pair
  // rotation), runs one work-item per (token, channel-pair) and reads the
  // rotated result back. Forward-only (backward stays on the CPU).
  // Coded by Claude (AI).
  TNNetRoPECL = class(TNNetKernelCL)
  private
    FTheta: TNNetVolume; // host staging for the per-pair theta table
    // Persistent device buffers (grow-only), reused every forward.
    FBufX, FBufTheta, FBufY: cl_mem;
    FCapX, FCapTheta, FCapY: csize_t;
  public
    constructor Create(NN: TNNet);
    destructor Destroy(); override;
    // X holds SeqLen*Depth values [t*Depth + c] (the previous layer's output);
    // Theta is the HalfDepth-long precomputed per-pair frequency array (already
    // RoPE-scaled). Y receives the rotated output in the same layout.
    // PositionOffset shifts the token index into the angle table; OutScale is the
    // YaRN/LongRoPE output multiplier (1.0 on the default path).
    procedure Rotate(X: TNNetVolume; const Theta: array of TNeuralFloat;
      Y: TNNetVolume; SeqLen, Depth, HalfDepth, PositionOffset: integer;
      OutScale: TNeuralFloat);
  end;

  /// OpenCL forward helper for the multimodal rotary embedding layer
  // (TNNetMRotaryEmbedding, M-RoPE). Binds the cai_mrope entry point on the
  // shared dot-product program's device. The host resolves the full per-(token,
  // channel-pair) rotation ANGLE table (each pair picks its 3-D section position
  // via SectionOfPair, then multiplies by the RoPE-scaled FTheta), so the device
  // only applies the plain interleaved-pair rotation - identical math to
  // TNNetRoPECL, just a per-(token,pair) angle table instead of a per-pair theta.
  // Runs one work-item per (token, channel-pair). Forward-only (backward on CPU).
  // Coded by Claude (AI).
  TNNetMRoPECL = class(TNNetKernelCL)
  private
    FAngle: TNNetVolume; // host staging for the per-(token,pair) angle table
    // Persistent device buffers (grow-only), reused every forward.
    FBufX, FBufAngle, FBufY: cl_mem;
    FCapX, FCapAngle, FCapY: csize_t;
  public
    constructor Create(NN: TNNet);
    destructor Destroy(); override;
    // X holds SeqLen*Depth values [t*Depth + c] (the previous layer's output);
    // Angle is the SeqLen*HalfDepth-long precomputed per-(token,pair) rotation
    // angle table [t*HalfDepth + k] (already section-resolved and RoPE-scaled).
    // Y receives the rotated output in the same layout. OutScale is the
    // YaRN/LongRoPE output multiplier (1.0 on the default path).
    procedure Rotate(X: TNNetVolume; Angle: TNNetVolume;
      Y: TNNetVolume; SeqLen, Depth, HalfDepth: integer; OutScale: TNeuralFloat);
  end;

  /// OpenCL forward helper for the token-gather embedding layer (TNNetEmbedding).
  // Binds the cai_embedding_gather entry point on the shared dot-product program's
  // device, uploads the weight table (FNeurons[0].Weights) plus a host-resolved
  // per-token source-row list, runs one work-item per (output token, depth) copying
  // a single scalar out of the table, and reads the gathered output back. The
  // EncodeZero / zero-padding decision (row = -1 leaves that token zero) stays on
  // the host, faithful to the scalar Compute(). Forward-only (backward on CPU).
  // Coded by Claude (AI).
  TNNetEmbeddingCL = class(TNNetKernelCL)
  private
    // The vocab table is large (VocabSize x EmbeddingSize) and CONSTANT across
    // forwards during inference, so it is uploaded once and kept resident here
    // instead of being re-shipped every Gather (a 65MB/forward PCIe stall on a
    // 32k x 512 table). InvalidateWeightCache (driven by the layer's
    // AfterWeightUpdate hook) forces a re-upload after the weights change.
    FWeightBuf: cl_mem;
    FWeightCached: boolean;
    // Persistent per-forward device buffers (grow-only): the token-row index
    // array and the gathered result. (FWeightBuf above is the resident table.)
    FBufRows, FBufY: cl_mem;
    FCapRows, FCapY: csize_t;
  public
    constructor Create(NN: TNNet);
    destructor Destroy(); override;
    // W is the weight table (VocabSize rows x EmbeddingSize, depth-contiguous).
    // TokenRows[c] is the vocab row to copy into output token c, or -1 to leave
    // that output token zero. Y receives the gathered NumTokens x EmbeddingSize
    // result. NumTokens = Length(TokenRows).
    procedure Gather(W: TNNetVolume; const TokenRows: array of integer;
      Y: TNNetVolume; NumTokens, EmbeddingSize: integer);
    // Drop the resident weight buffer so the next Gather re-uploads the table.
    // Called whenever the layer's weights change (training step / importer load).
    procedure InvalidateWeightCache();
  end;

  /// OpenCL forward helper for the softmax head layers (TNNetPointwiseSoftMax,
  // TNNetSoftMax). Binds the cai_softmax entry point on the shared dot-product
  // program's device, uploads the activation volume, runs one work-item per
  // contiguous normalization group of GroupLen elements (GroupLen = Depth for the
  // per-token pointwise softmax; GroupLen = FOutput.Size for the whole-volume
  // softmax) -- each doing the numerically-stable max-subtract -> exp -> sum ->
  // divide -- and reads the result back. ApplyMinScale selects the whole-volume
  // low-end rescaling variant (TVolume.SoftMax). Forward-only (backward on CPU).
  // Coded by Claude (AI).
  TNNetSoftMaxCL = class(TNNetKernelCL)
  private
    // Persistent device buffers (grow-only), reused every forward.
