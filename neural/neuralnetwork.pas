    end;
    if (pActFn<>TNNetIdentity) then
    begin
      QueryGroup := AddLayerAfter( [pActFn.Create()], QueryGroup);
      KeyGroup   := AddLayerAfter( [pActFn.Create()], KeyGroup);
      ValueGroup := AddLayerAfter( [pActFn.Create()], ValueGroup);
