// Rebuilds the variable-length quantile list of TNNetMultiQuantileLoss from a
// serialized layer: N lives in St[0], the N quantiles in Ft[0..N-1].
function BuildMultiQuantileLoss(N: integer;
  const Ft: array of TNeuralFloat): TNNetMultiQuantileLoss;
var
  Qs: array of TNeuralFloat;
  I, NM1: integer;
begin
  if (N < 1) or (N > csNNetMaxParameterIdx + 1) then N := 1;
  SetLength(Qs, N);
  NM1 := N - 1;
  for I := 0 to NM1 do Qs[I] := Ft[I];
  Result := TNNetMultiQuantileLoss.Create(Qs);
end;

// Rebuilds the per-channel level list of TNNetFiniteScalarQuant: D lives in
// St[0], the D level counts in St[1..D].
function BuildFiniteScalarQuant(
  const St: array of integer): TNNetFiniteScalarQuant;
var
  Levels: array of integer;
  D, I, DM1: integer;
begin
  D := St[0];
  if (D < 1) or (D > csNNetMaxParameterIdx) then D := 1;
  SetLength(Levels, D);
  DM1 := D - 1;
  for I := 0 to DM1 do
    if St[I + 1] >= 2 then Levels[I] := St[I + 1] else Levels[I] := 2;
  Result := TNNetFiniteScalarQuant.Create(Levels);
end;

function TNNet.CreateLayer(strData: string): TNNetLayer;
var
  MaxStructParamPos: integer;
  MaxLayerIdxPos: integer;
  MaxFloatParamPos: integer;
  S, S2: TStringList;
  St: array [0..csNNetMaxParameterIdx] of integer;
  Ft: array [0..csNNetMaxParameterIdx] of TNeuralFloat;
  aL: array of TNNetLayer;
  aIdx: TNeuralIntegerArray;
  IdxCnt: integer;
  I: integer;
  ClassNameStr: string;
  SCount: integer;
  StructCount: integer;
  SegSrc: TNNetLayer;
  StHigh, FtHigh: integer;
  StLow, FtLow: integer;
begin
  Result := nil;
  SegSrc := nil;
  StHigh := High(St);
  FtHigh := High(Ft);
  StLow := Low(St);
  FtLow := Low(Ft);
  S := CreateTokenizedStringList(strData,':');
  S2 := CreateTokenizedStringList(strData,';');

  SCount := S.Count;

  if SCount >= 2 then
  begin
    ClassNameStr := S[0];
    // This code is good for debug
    // if ClassNameStr = 'TNNetSum' then
    // begin
    //   WriteLn('hello');
