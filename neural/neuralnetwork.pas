procedure TNNetDepthwiseConvCL.Compute(PackedW, X, YRaw: TNNetVolume;
  OutW, OutH, InW, InDepth, Mult, FeatureSizeX, FeatureSizeY, Stride: integer;
  NewW: boolean = true);
var
  bufW, bufX, bufY: cl_mem;
  k: cl_kernel;
begin
  k := FKernel.Kernel;
  // Upload the padded input; allocate the device result. The packed weights are
  // kept resident and only re-uploaded when NewW (a weight update fired); see
  // TNNetDepthwiseConv.ComputeOpenCL / AfterWeightUpdate.
  bufW := FKernel.EnsureWriteBuffer(FBufW, FCapW, PackedW, NewW);
  bufX := FKernel.EnsureWriteBuffer(FBufX, FCapX, X);
  bufY := FKernel.EnsureOutputBuffer(FBufY, FCapY, YRaw);
  clSetKernelArg(k, 0, csLongintSize, @OutW);
  clSetKernelArg(k, 1, csLongintSize, @OutH);
  clSetKernelArg(k, 2, csLongintSize, @InW);
  clSetKernelArg(k, 3, csLongintSize, @InDepth);
  clSetKernelArg(k, 4, csLongintSize, @Mult);
  clSetKernelArg(k, 5, csLongintSize, @FeatureSizeX);
  clSetKernelArg(k, 6, csLongintSize, @FeatureSizeY);
  clSetKernelArg(k, 7, csLongintSize, @Stride);
  clSetKernelArg(k, 8, csCLMemSize, @bufW);
  clSetKernelArg(k, 9, csCLMemSize, @bufX);
  clSetKernelArg(k, 10, csCLMemSize, @bufY);
  // One work-item per output (x, y, output-channel) element.
  FKernel.RunKernel(k, OutW * OutH * Mult * InDepth);
  FKernel.Finish();
  FKernel.ReadBuffer(bufY, YRaw, CL_TRUE);
  // Buffers are persistent (FBuf*), reused next forward - not released here.
end;

