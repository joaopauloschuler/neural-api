  private
    // Persistent device buffers (grow-only), reused every forward.
    FBufErr, FBufIdx, FBufDst: cl_mem;
    FCapErr, FCapIdx, FCapDst: csize_t;
  public
    constructor Create(NN: TNNet);
    destructor Destroy(); override;
    // SrcIdx is the SAME NumOut-long output-element->source-offset map the
    // forward used; OutErr is the NumOut-long output gradient; Dst receives the
    // scattered source gradient (host pre-sizes it to the source element count;
    // the permutation fully covers it). NumOut = output element count.
