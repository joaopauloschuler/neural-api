begin
  inherited Create(NN, 'cai_bilinear_gather');
  FSrcBuf    := TNNetVolume.Create();
  FCornerBuf := TNNetVolume.Create();
  FWeightBuf := TNNetVolume.Create();
  FDstBuf    := TNNetVolume.Create();
end;

destructor TNNetBilinearGatherCL.Destroy();
begin
  FSrcBuf.Free;
  FCornerBuf.Free;
  FWeightBuf.Free;
  FDstBuf.Free;
  if Assigned(FBufSrcCL)    then clReleaseMemObject(FBufSrcCL);
  if Assigned(FBufCornerCL) then clReleaseMemObject(FBufCornerCL);
  if Assigned(FBufWeightCL) then clReleaseMemObject(FBufWeightCL);
  if Assigned(FBufDstCL)    then clReleaseMemObject(FBufDstCL);
  inherited Destroy();
end;

procedure TNNetBilinearGatherCL.Gather(Src: TNNetVolume;
  Corners, Weights: TNNetVolume; Dst: TNNetVolume; NumOut, Depth: integer);
var
  bufSrc, bufCorner, bufWeight, bufDst: cl_mem;
  k: cl_kernel;
begin
  k := FKernel.Kernel;
  // Upload source + the CPU-precomputed corner offsets and blend weights;
  // allocate the device result. (Each forward uploads fresh data: the source
  // changes every pass and the corners depend on the current flow/theta.)
  bufSrc    := FKernel.EnsureWriteBuffer(FBufSrcCL, FCapSrc, Src);
  bufCorner := FKernel.EnsureWriteBuffer(FBufCornerCL, FCapCorner, Corners);
  bufWeight := FKernel.EnsureWriteBuffer(FBufWeightCL, FCapWeight, Weights);
  bufDst    := FKernel.EnsureOutputBuffer(FBufDstCL, FCapDst, Dst);
  clSetKernelArg(k, 0, csLongintSize, @NumOut);
  clSetKernelArg(k, 1, csLongintSize, @Depth);
  clSetKernelArg(k, 2, csCLMemSize, @bufCorner);
  clSetKernelArg(k, 3, csCLMemSize, @bufWeight);
  clSetKernelArg(k, 4, csCLMemSize, @bufSrc);
  clSetKernelArg(k, 5, csCLMemSize, @bufDst);
  // One work-item per (output pixel, depth channel).
  FKernel.RunKernel(k, NumOut * Depth);
  FKernel.Finish();
  FKernel.ReadBuffer(bufDst, Dst, CL_TRUE);
  // Buffers are persistent (FBuf*CL), reused next forward - not released here.
end;

