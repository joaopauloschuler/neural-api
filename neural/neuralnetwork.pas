  /// Common softmax layer.
  TNNetSoftMax = class(TNNetPointwiseSoftMax)
    protected
      FSoftTotalSum: TNeuralFloat;
    public
      {$IFDEF OpenCL}
      function WillOpenCL(): boolean; override;
