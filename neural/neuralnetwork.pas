  clSetKernelArg(k, 3, csNeuralFloatSize, @fEps);
  clSetKernelArg(k, 4, csCLMemSize, @bufX);
  clSetKernelArg(k, 5, csCLMemSize, @bufY);
  // One work-item per (x,y) position.
  FKernel.RunKernel(k, NumPositions);
  FKernel.Finish();
