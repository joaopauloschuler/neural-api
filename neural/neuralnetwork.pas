{ TNNetGramMatrix }

constructor TNNetGramMatrix.Create();
begin
  inherited Create();
  FGramScratch := TNNetVolume.Create();
  FGramScratchErr := TNNetVolume.Create();
end;

destructor TNNetGramMatrix.Destroy();
begin
  {$IFDEF OpenCL}
  if Assigned(FGramResBuf) then FGramResBuf.Free;
  if Assigned(FGramTBuf) then FGramTBuf.Free;
  {$ENDIF}
  FGramScratchErr.Free;
  FGramScratch.Free;
  inherited Destroy();
end;

procedure TNNetGramMatrix.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  C, HW: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  C := pPrevLayer.Output.Depth;
  HW := pPrevLayer.Output.SizeX * pPrevLayer.Output.SizeY;
  // Output is the (C, C, 1) Gram matrix.
  FOutput.ReSize(C, C, 1);
  // Channel-major scratch: C rows of HW contiguous spatial floats. Row i lives
  // at GetRawPtr(0, i). Allocated here (per-pass scratch convention) and
  // reused each forward/backward; freed in Destroy.
  FGramScratch.ReSize(HW, C, 1);
  FGramScratchErr.ReSize(HW, C, 1);
  // Size from FOutput, not pPrevLayer's error buffer (collapsed when the prev
  // layer is inference-only).
  SetOutputErrorSize(FOutput);
end;

procedure TNNetGramMatrix.Compute;
var
  StartTime: double;
  A: TNNetVolume;
  C, HW, x, y, i, j, base, sp, iHW, iC, jCi, posJ: integer;
  ASizeXM1, ASizeYM1, CM1: integer;
  norm, acc: TNeuralFloat;
  rowI, rowJ: TNeuralFloatArrPtr;
const
  // Minimum C (channel count) to offload the Gram GEMM to OpenCL; below this the
  // kernel launch + upload cost outweighs the small symmetric matmul.
  csGramOpenCLMinC = 16;
begin
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  {$IFDEF OpenCL}
  if FHasOpenCL and (FShouldOpenCL or FForceOpenCL) and
     (FPrevLayer.FOutput.Depth >= csGramOpenCLMinC) and
     (FPrevLayer.FOutput.SizeX * FPrevLayer.FOutput.SizeY > 0) then
  begin
    Inc(FForwardGPUCnt);
    ComputeOpenCL();
    exit;
  end;
  {$ENDIF}
  StartTime := Now();
  A := FPrevLayer.FOutput;
  C := A.Depth;
  HW := A.SizeX * A.SizeY;
  FOutput.ReSize(C, C, 1);
  if (C = 0) or (HW = 0) then
  begin
    FForwardTime := FForwardTime + (Now() - StartTime);
    exit;
  end;
  norm := 1.0 / (C * HW);
  // The prev-layer activation A is depth-contiguous: A[x,y,i] lives at base+i
  // with base = (y*SizeX + x)*C, so a channel's spatial samples are strided by
  // C and NOT directly vectorizable. Transpose once into the channel-major
  // scratch (row i = channel i's HW spatial floats laid out contiguously), then
  // each Gram entry G[i,j] is a depth-contiguous DotProduct over the spatial
  // axis. The strided gather is the only scalar remainder.
  FGramScratch.ReSize(HW, C, 1);
  CM1 := C - 1;
  ASizeYM1 := A.SizeY - 1;
  ASizeXM1 := A.SizeX - 1;
  for y := 0 to ASizeYM1 do
  begin
    sp := y * A.SizeX;   // #11: row start, invariant across x; #6: sp steps by 1
    base := sp * C;      // #6: base steps by C per x
    for x := 0 to ASizeXM1 do
    begin
      iHW := sp;
      for i := 0 to CM1 do
      begin
        FGramScratch.FData[iHW] := A.FData[base + i];
        Inc(iHW, HW);
      end;
      Inc(sp);
      Inc(base, C);
    end;
  end;
  for i := 0 to CM1 do
  begin
    rowI := FGramScratch.GetRawPtr(0, i);
    iC := i * C;
    jCi := iC + i;
    posJ := i * HW; // #12: seed = GetRawPos(0, i, 0), advances by HW per j
    for j := i to CM1 do
    begin
      rowJ := FGramScratch.GetRawPtr(posJ);
      acc := TNNetVolume.DotProduct(rowI, rowJ, HW) * norm;
      FOutput.FData[iC + j] := acc;
      FOutput.FData[jCi] := acc; // symmetric
      Inc(jCi, C);
      Inc(posJ, HW); // #12: next j's row offset
    end;
  end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

{$IFDEF OpenCL}
procedure TNNetGramMatrix.EnableOpenCL(DotProductKernel: TNeuralKernel);
begin
  inherited EnableOpenCL(DotProductKernel); // sets FHasOpenCL
  if not Assigned(FDotCL) then
  begin
    FDotCL := TDotProductSharedKernel.Create(GetDotProductKernel());
    FDotCL.HideMessages();
  end;
  if not Assigned(FGramTBuf) then FGramTBuf := TNNetVolume.Create();
  if not Assigned(FGramResBuf) then FGramResBuf := TNNetVolume.Create();
  FShouldOpenCL := false; // bandwidth-bound: GPU < CPU (OpenCLForwardBenchmark ~0.77x), pin to CPU; device path now reached only via ForceOpenCL. Was: FShouldOpenCL := true;
end;

// Forward: the dense symmetric Gram GEMM on the device, the 1/(C*HW) scale and
// the upper->lower mirror on the CPU. Mirrors the CPU Compute() math exactly
// (same channel-major transpose, same norm). PoCL CPU-backed -> typically ~1e-6.
procedure TNNetGramMatrix.ComputeOpenCL();
var
  StartTime: double;
  A: TNNetVolume;
  C, HW, x, y, i, j, base, CM1, sxM1, syM1, HWM1: integer;
  sp, iHW, iC, jCi, srcIdx, dstIdx: integer;
  norm, acc: TNeuralFloat;
begin
  {$IFDEF OpenCL} FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  StartTime := Now();
  A := FPrevLayer.FOutput;
  C := A.Depth;
  HW := A.SizeX * A.SizeY;
  FOutput.ReSize(C, C, 1);
  if (C = 0) or (HW = 0) then
  begin
    FForwardTime := FForwardTime + (Now() - StartTime);
    exit;
  end;
  norm := 1.0 / (C * HW);
  CM1 := C - 1;
  HWM1 := HW - 1;
  sxM1 := A.SizeX - 1;
  syM1 := A.SizeY - 1;
  // 1) Channel-major transpose into FGramScratch exactly as the CPU path: row i
  //    = channel i's HW spatial floats laid out contiguously (Bs[i*HW + k]).
  FGramScratch.ReSize(HW, C, 1);
  for y := 0 to syM1 do
  begin
    sp := y * A.SizeX;   // #6: sp steps by 1, base steps by C per x
    base := sp * C;
    for x := 0 to sxM1 do
    begin
      iHW := sp;
      for i := 0 to CM1 do
      begin
        FGramScratch.FData[iHW] := A.FData[base + i];
        Inc(iHW, HW);
      end;
      Inc(sp);
      Inc(base, C);
    end;
  end;
  // 2) The kernel reads A column-major (As[a + i*FNumAs] with FNumAs = C), so
  //    transpose FGramScratch into FGramTBuf as [k*C + i] = channel i at spatial k.
  FGramTBuf.ReSize(HW * C, 1, 1);
  for i := 0 to CM1 do
  begin
    srcIdx := i * HW;
    dstIdx := i;
    for x := 0 to HWM1 do
    begin
      FGramTBuf.FData[dstIdx] := FGramScratch.FData[srcIdx];
      Inc(srcIdx);
      Inc(dstIdx, C);
    end;
  end;
  // 3) GEMM on device: G'[i,j] = sum_k A[k,i] * B[j,k]. A = FGramTBuf (FNumAs = C,
  //    interleaved As[i + k*C]); B = FGramScratch (FNumBs = C, contiguous
  //    Bs[j*HW + k]); contraction FSize = HW. Result[j*C + i] lands in FGramResBuf.
  FDotCL.ReallocateBuffersIfRequired(FGramTBuf, FGramScratch, HW);
  FDotCL.Compute(FGramTBuf, FGramScratch, {ActFN}0, {NewVAs}true, {NewVBs}true);
  FDotCL.FinishAndLoadResult(FGramResBuf, 0);
  // 4) Scale by 1/(C*HW) and write the symmetric Gram matrix. The device fills
  //    the full CxC result; take the upper triangle, scale, and mirror to the
  //    lower triangle to guarantee exact symmetry (parity with the CPU path).
  for i := 0 to CM1 do
  begin
    iC := i * C;
    jCi := iC + i;
    for j := i to CM1 do
    begin
      acc := FGramResBuf.FData[jCi] * norm;
      FOutput.FData[iC + j] := acc;
      FOutput.FData[jCi] := acc; // symmetric
      Inc(jCi, C);
    end;
  end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;
{$ENDIF}

procedure TNNetGramMatrix.Backpropagate;
var
  StartTime: double;
  A, PrevErr: TNNetVolume;
  C, HW, x, y, i, j, base, sp, iHW, iC, jCi, idx, posJ: integer;
  ASizeXM1, ASizeYM1, CM1: integer;
  norm, sym: TNeuralFloat;
  rowI, rowJ: TNeuralFloatArrPtr;
begin
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  StartTime := Now();
  if Assigned(FPrevLayer) and
    (FPrevLayer.OutputError.Size > 0) and
    (FPrevLayer.OutputError.Size = FPrevLayer.Output.Size) then
  begin
    A := FPrevLayer.FOutput;
    PrevErr := FPrevLayer.FOutputError;
    C := A.Depth;
    HW := A.SizeX * A.SizeY;
    if (C > 0) and (HW > 0) then
    begin
      norm := 1.0 / (C * HW);
      CM1 := C - 1;
      // G[i,j] = norm * sum_{x,y} A[x,y,i]*A[x,y,j]  (symmetric).
      // dA[x,y,i] = norm * sum_j (dG[i,j] + dG[j,i]) * A[x,y,j].
      // Build dA channel-major in the scratch (row i = channel i over HW),
      // accumulating each contribution with the depth-contiguous MulAdd
      // primitive: rowI += (norm*sym) * channelJ. The channel-major A samples
      // are taken from a transpose of A; the final strided scatter back into the
      // depth-contiguous PrevErr is the only scalar remainder.
      FGramScratch.ReSize(HW, C, 1);
      // FGramScratch first holds A transposed (reused as the source channels).
      ASizeYM1 := A.SizeY - 1;
      ASizeXM1 := A.SizeX - 1;
      for y := 0 to ASizeYM1 do
      begin
        sp := y * A.SizeX;   // #6: sp steps by 1, base steps by C per x
        base := sp * C;
        for x := 0 to ASizeXM1 do
        begin
          iHW := sp;
          for i := 0 to CM1 do
          begin
            FGramScratch.FData[iHW] := A.FData[base + i];
            Inc(iHW, HW);
          end;
          Inc(sp);
          Inc(base, C);
        end;
      end;
      // Accumulate dA channel-major into the backward scratch.
      FGramScratchErr.ReSize(HW, C, 1);
      FGramScratchErr.Fill(0);
      for i := 0 to CM1 do
      begin
        rowI := FGramScratchErr.GetRawPtr(0, i);
        iC := i * C;
        jCi := i;
        posJ := 0; // #12: seed = GetRawPos(0, 0, 0), advances by HW per j
        for j := 0 to CM1 do
        begin
          sym := FOutputError.FData[iC + j] + FOutputError.FData[jCi];
          Inc(jCi, C);
          if sym <> 0 then
          begin
            rowJ := FGramScratch.GetRawPtr(posJ);
            TNNetVolume.MulAdd(rowI, rowJ, norm * sym, HW);
          end;
          Inc(posJ, HW); // #12: advance every iteration (outside the if)
        end;
      end;
      // Scatter channel-major dA back into the depth-contiguous PrevErr.
      ASizeYM1 := A.SizeY - 1;
      ASizeXM1 := A.SizeX - 1;
      for y := 0 to ASizeYM1 do
      begin
        sp := y * A.SizeX;   // #6: sp/base carried; #4: idx carried by 1
        base := sp * C;
        for x := 0 to ASizeXM1 do
        begin
          iHW := sp;
          idx := base;
          for i := 0 to CM1 do
          begin
            PrevErr.FData[idx] := PrevErr.FData[idx] +
              FGramScratchErr.FData[iHW];
            Inc(iHW, HW);
            Inc(idx);
          end;
          Inc(sp);
          Inc(base, C);
        end;
      end;
    end;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  FPrevLayer.Backpropagate();
end;

{ TNNetReLUP }

constructor TNNetReLUP.Create();
begin
  inherited Create();
  FActivationOpcode := csActReLU; // same forward as TNNetReLU
end;

procedure TNNetReLUP.Compute;
var
  SizeM1: integer;
  LocalPrevOutput: TNNetVolume;
  OutputCnt: integer;
  StartTime: double;
begin
  StartTime := Now();
  if ComputeActivationOnOpenCL() then
  begin
    FForwardTime := FForwardTime + (Now() - StartTime);
    exit;
  end;
  LocalPrevOutput := FPrevLayer.Output;
  SizeM1 := LocalPrevOutput.Size - 1;

  if (FOutput.Size = FOutputError.Size) and (FOutputErrorDeriv.Size = FOutput.Size) then
  begin
    for OutputCnt := 0 to SizeM1 do
    begin
      if LocalPrevOutput.FData[OutputCnt] > 0 then // Positive Values Only
      begin
        FOutput.FData[OutputCnt] := LocalPrevOutput.FData[OutputCnt];
        FOutputErrorDeriv.FData[OutputCnt] := 1;
      end
      else
      begin
        FOutput.FData[OutputCnt] := 0;
        FOutputErrorDeriv.FData[OutputCnt] := 0;
      end;
    end;
  end
  else
  begin
    // can't calculate error on input layers.
    FOutput.CopyRelu(LocalPrevOutput);
  end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

{ TNNetMaxPoolWithPosition }

procedure TNNetMaxPoolWithPosition.ComputeDefaultStride;
begin
  inherited ComputeDefaultStride();
  ComputePositions();
end;

procedure TNNetMaxPoolWithPosition.ComputeWithStride;
begin
  inherited ComputeWithStride();
  ComputePositions();
end;

function TNNetMaxPoolWithPosition.NeedsArgMax(): boolean;
begin
  Result := True;
end;

procedure TNNetMaxPoolWithPosition.ComputePositions;
var
  CntOutputX, CntOutputY, CntD: integer;
  OutputMaxX, OutputMaxY, MaxD: integer;
  OutputRawPos, Pos, RowStride: integer;
  PrevDepth: integer;
  OffX, OffY: integer;
begin
  // #12/#5: both position flags are loop-invariant; when neither is set this
  // procedure writes nothing, so early-exit and hoist the flag test above the nest.
  if not (FLogPosX or FLogPosY) then exit;
  OutputMaxX := Output.SizeX - 1;
  OutputMaxY := Output.SizeY - 1;
  PrevDepth := FPrevLayer.Output.Depth;
  MaxD := PrevDepth - 1;
  // #5: the position-block offsets are fully determined by the loop-invariant
  // flags (X block => PrevDepth*1; Y block => PrevDepth*(1+Ord(FLogPosX))).
  OffX := PrevDepth;
  OffY := PrevDepth * (1 + Ord(FLogPosX));
  // #12: row start seeded per Y; the per-X step is the full output depth stride.
  RowStride := Output.GetRawPos(1, 0);
  for CntOutputY := 0 to OutputMaxY do
  begin
    OutputRawPos := Output.GetRawPos(0, CntOutputY);
    for CntOutputX := 0 to OutputMaxX do
    begin
      Pos := OutputRawPos;
      if FLogPosX and FLogPosY then
        for CntD := 0 to MaxD do
        begin
          FOutput.FData[Pos + OffX] := FPosX[FMaxPosX[Pos]];
          FOutput.FData[Pos + OffY] := FPosY[FMaxPosY[Pos]];
          Inc(Pos);
        end
      else if FLogPosX then
        for CntD := 0 to MaxD do
        begin
          FOutput.FData[Pos + OffX] := FPosX[FMaxPosX[Pos]];
          Inc(Pos);
        end
      else
        for CntD := 0 to MaxD do
        begin
          FOutput.FData[Pos + OffY] := FPosY[FMaxPosY[Pos]];
          Inc(Pos);
        end;
      Inc(OutputRawPos, RowStride);
    end;
  end;
end;

constructor TNNetMaxPoolWithPosition.Create(pPoolSize: integer;
  pStride: integer; pPadding: integer;
  pLogPosX: integer; pLogPosY: integer;
  pMaxBackpropX: integer);
begin
  inherited Create(pPoolSize, pStride, pPadding);
  FStruct[3] := pLogPosX;
  FStruct[4] := pLogPosY;
  FStruct[5] := pMaxBackpropX;
  FLogPosX := (pLogPosX>0);
  FLogPosY := (pLogPosY>0);
  FExtraSize := 0;
  FMaxBackpropX := pMaxBackpropX;
  if FLogPosX then Inc(FExtraSize);
  if FLogPosY then Inc(FExtraSize);
end;

destructor TNNetMaxPoolWithPosition.Destroy;
begin
  SetLength(FPosX, 0);
  SetLength(FPosY, 0);
  inherited Destroy;
end;

procedure TNNetMaxPoolWithPosition.Backpropagate;
var
  CntOutputX, CntOutputY, CntD: integer;
  OutputMaxX, OutputMaxY, MaxD: integer;
  OutputRawPos: integer;
  PrevDepth, RowStride: integer;
begin
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  if FMaxBackpropX < Output.SizeX then
  begin
    OutputMaxX := Output.SizeX - 1;
    OutputMaxY := Output.SizeY - 1;
    PrevDepth := FPrevLayer.Output.Depth;
    MaxD := PrevDepth - 1;
    // #12: consecutive X advance the flat offset by one full output row
    // stride (Output.Depth); carry it instead of recomputing GetRawPos per X.
    RowStride := Output.GetRawPos(1, 0);
    for CntOutputY := 0 to OutputMaxY do
    begin
      OutputRawPos := Output.GetRawPos(FMaxBackpropX, CntOutputY);
      for CntOutputX := FMaxBackpropX to OutputMaxX do
      begin
        // #13: the value channels 0..MaxD are contiguous at each (X,Y);
        // zero them in one FillChar (position channels beyond MaxD untouched).
        FillChar(FOutput.FData[OutputRawPos], PrevDepth * csNeuralFloatSize, 0);
        Inc(OutputRawPos, RowStride);
      end;
    end;
  end;
  BackpropagateNoTest();
end;

procedure TNNetMaxPoolWithPosition.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  MaxPrevOutputX: integer;
  MaxPrevOutputY: integer;
  CntSizeX, CntSizeY: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  if FExtraSize > 0 then
  begin
    FOutput.ReSize(FOutputSizeX, FOutputSizeY, FOutputSizeD * (1+FExtraSize));
    SetOutputErrorSize(FOutputSizeX, FOutputSizeY, FOutputSizeD * (1+FExtraSize));
    SetLength(FMaxPosX, FOutput.Size);
    SetLength(FMaxPosY, FOutput.Size);
    SetLength(FPosX, FPrevLayer.Output.SizeX);
    SetLength(FPosY, FPrevLayer.Output.SizeY);
    MaxPrevOutputX := FPrevLayer.Output.SizeX - 1;
    for CntSizeX := 0 to MaxPrevOutputX do
    begin
      FPosX[CntSizeX] := CntSizeX/FPrevLayer.Output.SizeX;
    end;
    MaxPrevOutputY := FPrevLayer.Output.SizeY - 1;
    for CntSizeY := 0 to MaxPrevOutputY do
    begin
      FPosY[CntSizeY] := CntSizeY/FPrevLayer.Output.SizeY;
    end;
    if FMaxBackpropX = 0 then
    begin
      FMaxBackpropX := FOutputSizeX;
    end;
    FMaxBackpropX := Min(FOutputSizeX, FMaxBackpropX);
    FStruct[5] := FMaxBackpropX;
  end;
end;

{ TNNetCrop }

procedure TNNetCrop.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  FOutput.ReSize(FLenX, FLenY, pPrevLayer.FOutput.Depth);
  if (pPrevLayer.FOutputError.Size = pPrevLayer.FOutput.Size) then
    SetOutputErrorSize(FOutput);
end;

constructor TNNetCrop.Create(StartX, StartY, LenX, LenY: integer);
begin
  inherited Create();
  FStartX := StartX;
  FStartY := StartY;
  FLenX := Max(LenX, 1);
  FLenY := Max(LenY, 1);
  FStruct[0] := StartX;
  FStruct[1] := StartY;
  FStruct[2] := FLenX;
  FStruct[3] := FLenY;
end;

procedure TNNetCrop.Compute;
var
  StartTime: double;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  if
    (FPrevLayer.FOutputError.Size = FPrevLayer.FOutput.Size) and
    (FOutput.Size <> FOutputError.Size)
    then
    SetOutputErrorSize(FOutput);
  FOutput.CopyCropping(FPrevLayer.FOutput, FStartX, FStartY, FLenX, FLenY);
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

procedure TNNetCrop.Backpropagate;
var
  StartTime: double;
begin
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  if (FPrevLayer.Output.Size > 0) and (FPrevLayer.Output.Size = FPrevLayer.OutputError.Size) then
  begin
    StartTime := Now();
    FPrevLayer.FOutputError.AddArea
    (
      {DestX=}FStartX,
      {DestY=}FStartY,
      {OriginX=}0,
      {OriginY=}0,
      {LenX=}FLenX,
      {LenY=}FLenY,
      FOutputError
    );
    FBackwardTime := FBackwardTime + (Now() - StartTime);
  end;
  if Assigned(FPrevLayer) then FPrevLayer.Backpropagate();
end;

// Maps an output coordinate Pos (0..outLen-1) of a padding layer back onto the
// source coordinate (0..SrcLen-1) it was copied from, for a given border-fill
// mode. Returns -1 for pmZero border cells (those are filled with zeros and
// have no source). Used by both forward (copy) and backward (scatter) so the
// two are exact adjoints of each other. SrcLen must be >= 1.
// Coded by Claude (AI).
function NeuralPadSourceIndex(Pos, Pad, SrcLen: integer;
  PadMode: TNNetPadMode): integer;
var
  Idx, Period: integer;
begin
  Idx := Pos - Pad;
  if (Idx >= 0) and (Idx < SrcLen) then
  begin
    Result := Idx;
    exit;
  end;
  case PadMode of
    pmReplicate:
    begin
      if Idx < 0 then Result := 0 else Result := SrcLen - 1;
    end;
    pmCircular:
    begin
      Result := ((Idx mod SrcLen) + SrcLen) mod SrcLen;
    end;
    pmReflect:
    begin
      if SrcLen = 1 then
      begin
        Result := 0;
      end
      else
      begin
        // Reflect without repeating the edge sample (torch ReflectionPad2d):
        // period 2*(SrcLen-1) triangle wave.
        Period := 2 * (SrcLen - 1);
        Idx := ((Idx mod Period) + Period) mod Period;
        if Idx >= SrcLen then Idx := Period - Idx;
        Result := Idx;
      end;
    end;
  else
    // pmZero: border cell has no source.
    Result := -1;
  end;
end;

{ TNNetPadXY }

procedure TNNetPadXY.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  FOutput.ReSize(pPrevLayer.FOutput.SizeX + FPaddingX*2, pPrevLayer.FOutput.SizeY + FPaddingY*2, pPrevLayer.FOutput.Depth);
  if (pPrevLayer.FOutputError.Size = pPrevLayer.FOutput.Size) then SetOutputErrorSize(FOutput);
end;

constructor TNNetPadXY.Create(PaddingX, PaddingY: integer);
begin
  Create(PaddingX, PaddingY, pmZero);
end;

constructor TNNetPadXY.Create(PaddingX, PaddingY: integer; PadMode: TNNetPadMode);
begin
  inherited Create();
  FStruct[0] := PaddingX;
  FStruct[1] := PaddingY;
  FStruct[2] := Ord(PadMode);
  FPaddingX := PaddingX;
  FPaddingY := PaddingY;
  FPadMode := PadMode;
end;

procedure TNNetPadXY.Compute;
var
  StartTime: double;
  OutX, OutY, D, SrcX, SrcY: integer;
  MaxX, MaxY, MaxD: integer;
  basePrev0, baseOut0: integer;
  RowBytes, SrcW, SrcH: integer;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  if
    (FPrevLayer.FOutputError.Size = FPrevLayer.FOutput.Size) and
    (FOutput.Size <> FOutputError.Size)
    then
    SetOutputErrorSize(FOutput);
  if FPadMode = pmZero then
  begin
    FOutput.CopyPadding(FPrevLayer.FOutput, FPaddingX, FPaddingY);
  end
  else
  begin
    MaxX := FOutput.SizeX - 1;
    MaxY := FOutput.SizeY - 1;
    MaxD := FOutput.Depth - 1;
    // #5: row byte count and source dims are loop-invariant.
    RowBytes := (MaxD + 1) * csNeuralFloatSize;
    SrcW := FPrevLayer.FOutput.SizeX;
    SrcH := FPrevLayer.FOutput.SizeY;
    for OutY := 0 to MaxY do
    begin
      SrcY := NeuralPadSourceIndex(OutY, FPaddingY, SrcH, FPadMode);
      for OutX := 0 to MaxX do
      begin
        SrcX := NeuralPadSourceIndex(OutX, FPaddingX, SrcW, FPadMode);
        basePrev0 := FPrevLayer.FOutput.GetRawPos(SrcX, SrcY);
        baseOut0  := FOutput.GetRawPos(OutX, OutY);
        Move(FPrevLayer.FOutput.FData[basePrev0], FOutput.FData[baseOut0],
          RowBytes);
      end;
    end;
  end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

procedure TNNetPadXY.Backpropagate;
var
  StartTime: double;
  OutX, OutY, D, SrcX, SrcY: integer;
  MaxX, MaxY, MaxD: integer;
  basePrevErr0, baseErr0: integer;
  SrcW, SrcH, RowLen: integer;
begin
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  if (FPrevLayer.Output.Size > 0) and (FPrevLayer.Output.Size = FPrevLayer.OutputError.Size) then
  begin
    StartTime := Now();
    if FPadMode = pmZero then
    begin
      FPrevLayer.FOutputError.AddArea
      (
        {DestX=}0,
        {DestY=}0,
        {OriginX=}FPaddingX,
        {OriginY=}FPaddingY,
        {LenX=}FPrevLayer.OutputError.SizeX,
        {LenY=}FPrevLayer.OutputError.SizeY,
        FOutputError
      );
    end
    else
    begin
      // Scatter each output cell's gradient back onto the source cell it was
      // copied from. Reflect/replicate accumulate onto interior/edge cells,
      // circular wraps -- exact adjoint of the forward copy above.
      MaxX := FOutput.SizeX - 1;
      MaxY := FOutput.SizeY - 1;
      MaxD := FOutput.Depth - 1;
      // #5: source dims and per-row element count are loop-invariant.
      SrcW := FPrevLayer.FOutput.SizeX;
      SrcH := FPrevLayer.FOutput.SizeY;
      RowLen := MaxD + 1;
      for OutY := 0 to MaxY do
      begin
        SrcY := NeuralPadSourceIndex(OutY, FPaddingY, SrcH, FPadMode);
        for OutX := 0 to MaxX do
        begin
          SrcX := NeuralPadSourceIndex(OutX, FPaddingX, SrcW, FPadMode);
          basePrevErr0 := FPrevLayer.FOutputError.GetRawPos(SrcX, SrcY);
          baseErr0     := FOutputError.GetRawPos(OutX, OutY);
          TNNetVolume.Add(FPrevLayer.FOutputError.GetRawPtr(basePrevErr0),
            FOutputError.GetRawPtr(baseErr0), RowLen);
        end;
      end;
    end;
    FBackwardTime := FBackwardTime + (Now() - StartTime);
  end;
  if Assigned(FPrevLayer) then FPrevLayer.Backpropagate();
end;

