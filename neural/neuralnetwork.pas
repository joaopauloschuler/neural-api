      Dst: TNNetVolume; NumOut: integer);
  end;

  /// OpenCL BACKWARD helper for TNNetBicubicUpsample, the transpose of
  // TNNetBicubicGatherCL. The forward reads a 4x4 clamped source neighbourhood
  // per output pixel; the backward scatters each output pixel's gradient into
  // those 16 corners with the same wy[r]*wx[c] weights. To match the codebase's
  // atomic-free gather style (border clamping makes several output pixels write
  // the same source pixel), the CALLING layer builds a CSR contribution table
  // per SOURCE pixel ON THE CPU (offsets + flat (outpix,weight) entries,
  // byte-identical weights to the scalar backward) and this helper runs one
  // work-item per (source pixel, depth) gathering every landing contribution.
  // Binds the cai_bicubic_scatter entry point on the shared dot-product
  // program's device. Backward-only.
  // Coded by Claude (AI).
  TNNetBicubicScatterCL = class(TNNetKernelCL)
  private
    // Persistent device buffers (grow-only), reused every forward.
    FBufErr, FBufRow, FBufIdx, FBufWeight, FBufDst: cl_mem;
    FCapErr, FCapRow, FCapIdx, FCapWeight, FCapDst: csize_t;
  public
    constructor Create(NN: TNNet);
    destructor Destroy(); override;
    // RowOff is the NumSrc+1 CSR row-offset array; OutIdx/Weights are the flat
    // per-entry output-pixel index + weight arrays; OutErr is the output
    // gradient [outpix*Depth + d]; Dst receives the scattered source gradient
    // [srcpix*Depth + d]. NumSrc = source pixel count.
    procedure Scatter(OutErr: TNNetVolume; RowOff, OutIdx, Weights: TNNetVolume;
      Dst: TNNetVolume; NumSrc, Depth: integer);
  end;

  /// OpenCL forward helper for the per-token depth-axis normalization layers
