constructor TNNetAddNoiseBase.Create;
begin
  inherited Create;
  FEnabled := false;
end;

procedure TNNetInputBase.Compute;
begin
  FOutputError.Fill(0);
  FOutputErrorDeriv.Fill(0);
end;

