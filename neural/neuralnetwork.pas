constructor TNNetCharbonnierLoss.Create();
begin
  Create(0.001);
end;

constructor TNNetCharbonnierLoss.Create(pEpsilon: TNeuralFloat);
begin
  inherited Create();
  if pEpsilon <= 0 then
    FErrorProc('TNNetCharbonnierLoss epsilon must be > 0.');
  FFloatSt[0] := pEpsilon;
end;

procedure TNNetCharbonnierLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1: integer;
  Eps, EpsSq, V: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Eps := FFloatSt[0];
  if Eps <= 0 then Eps := 0.001;
  EpsSq := Eps * Eps;
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    V := FOutputError.FData[Idx];
    FOutputError.FData[Idx] := V / pcr_sqrtf(V * V + EpsSq);
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetQuantileLoss }

constructor TNNetQuantileLoss.Create();
begin
  Create(0.5);
end;

constructor TNNetQuantileLoss.Create(Quantile: TNeuralFloat);
begin
  inherited Create();
  if (Quantile <= 0) or (Quantile >= 1) then
    FErrorProc('TNNetQuantileLoss quantile must be in (0, 1).');
  FFloatSt[0] := Quantile;
end;

procedure TNNetQuantileLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1: integer;
  Q, V: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Q := FFloatSt[0];
  if (Q <= 0) or (Q >= 1) then Q := 0.5;
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    // V = prediction - target = -e (e = target - prediction).
    // e > 0 (V < 0): dL/dprediction = -q
    // e < 0 (V > 0): dL/dprediction =  1 - q
    // e = 0 (V = 0): subgradient 0
    V := FOutputError.FData[Idx];
    if V > 0 then
      FOutputError.FData[Idx] := 1.0 - Q
    else if V < 0 then
      FOutputError.FData[Idx] := -Q
    else
      FOutputError.FData[Idx] := 0.0;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetMultiQuantileLoss }

constructor TNNetMultiQuantileLoss.Create();
begin
  // Default joint head: the classic 10% / 50% / 90% prediction-interval trio.
  Create([0.1, 0.5, 0.9]);
end;

constructor TNNetMultiQuantileLoss.Create(const Quantiles: array of TNeuralFloat);
var
  I, N, NM1: integer;
begin
  inherited Create();
  N := Length(Quantiles);
  NM1 := N - 1;
  if (N < 1) or (N > csNNetMaxParameterIdx + 1) then
    FErrorProc('TNNetMultiQuantileLoss needs 1..' +
      IntToStr(csNNetMaxParameterIdx + 1) + ' quantiles.');
  for I := 0 to NM1 do
    if (Quantiles[I] <= 0) or (Quantiles[I] >= 1) then
      FErrorProc('TNNetMultiQuantileLoss quantiles must be in (0, 1).');
  FStruct[0] := N;
  for I := 0 to NM1 do
    FFloatSt[I] := Quantiles[I];
end;

function TNNetMultiQuantileLoss.QuantileCount(): integer;
begin
  Result := FStruct[0];
  if (Result < 1) or (Result > csNNetMaxParameterIdx + 1) then Result := 1;
end;

function TNNetMultiQuantileLoss.GetQuantile(Index: integer): TNeuralFloat;
begin
  Result := FFloatSt[Index];
  if (Result <= 0) or (Result >= 1) then Result := 0.5;
end;

procedure TNNetMultiQuantileLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1, N, NM1, Ch: integer;
  Q, V: TNeuralFloat;
  // N is validated to 1..csNNetMaxParameterIdx+1 in the constructor and clamped
  // by QuantileCount, so these fixed-size stack tables never allocate (#17).
  QHi, QLo: array[0..csNNetMaxParameterIdx] of TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  N := QuantileCount();
  NM1 := N - 1;
  // Per-quantile gradient constants, resolved once instead of once per element.
  for Ch := 0 to NM1 do
  begin
    Q := GetQuantile(Ch);
    QHi[Ch] := 1.0 - Q;
    QLo[Ch] := -Q;
  end;
  SizeM1 := FOutputError.Size - 1;
  // Data is depth-contiguous, so the channel (and thus the quantile) is the
  // position within each consecutive N-wide group. Carried counter instead of
  // Idx mod N (#6): the group index advances by 1 and wraps.
  Ch := 0;
  for Idx := 0 to SizeM1 do
  begin
    // V = prediction - target = -e (e = target - prediction).
    // e > 0 (V < 0): dL/dprediction = -q_i
    // e < 0 (V > 0): dL/dprediction =  1 - q_i
    // e = 0 (V = 0): subgradient 0
    V := FOutputError.FData[Idx];
    if V > 0 then
      FOutputError.FData[Idx] := QHi[Ch]
    else if V < 0 then
      FOutputError.FData[Idx] := QLo[Ch]
    else
      FOutputError.FData[Idx] := 0.0;
    Inc(Ch);
    if Ch > NM1 then Ch := 0;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

class procedure TNNetMultiQuantileLoss.SortAscending(AOutput: TNNetVolume;
  N: integer);
var
  Base, I, J, GroupCnt, GroupCntM1, NM1, G: integer;
  Tmp: TNeuralFloat;
begin
  // Monotonicity guard (non-differentiable, inference-time): sort each
  // consecutive N-channel group ascending so lower quantiles never exceed
  // higher ones (removes "quantile crossing"). Insertion sort: N is tiny.
  if N < 2 then exit;
  GroupCnt := AOutput.Size div N;
  GroupCntM1 := GroupCnt - 1;
  NM1 := N - 1;
  for G := 0 to GroupCntM1 do
  begin
    Base := G * N;
    for I := 1 to NM1 do
    begin
      Tmp := AOutput.FData[Base + I];
      J := I - 1;
      while (J >= 0) and (AOutput.FData[Base + J] > Tmp) do
      begin
        AOutput.FData[Base + J + 1] := AOutput.FData[Base + J];
        Dec(J);
      end;
      AOutput.FData[Base + J + 1] := Tmp;
    end;
  end;
end;

{ TNNetFocalLoss }

constructor TNNetFocalLoss.Create();
begin
  Create(0.25, 2.0);
end;

constructor TNNetFocalLoss.Create(pAlpha, pGamma: TNeuralFloat);
begin
  inherited Create();
  if pAlpha <= 0 then
    FErrorProc('TNNetFocalLoss alpha must be > 0.');
  if pGamma < 0 then
    FErrorProc('TNNetFocalLoss gamma must be >= 0.');
  FFloatSt[0] := pAlpha;
  FFloatSt[1] := pGamma;
end;

procedure TNNetFocalLoss.Backpropagate();
const
  cFocalEps = 1e-7;
var
  StartTime: double;
  Idx, SizeM1: integer;
  Alpha, Gamma, P, Seeded, Target, OneMinusP, Grad: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Alpha := FFloatSt[0];
  if Alpha <= 0 then Alpha := 0.25;
  Gamma := FFloatSt[1];
  if Gamma < 0 then Gamma := 2.0;
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    P := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    // Framework seeds FOutputError := output - target. Recover target.
    Target := P - Seeded;
    if Target > 0.5 then
    begin
      // True-class position. Clamp p_t to [eps, 1-eps].
      if P < cFocalEps then P := cFocalEps
      else if P > 1.0 - cFocalEps then P := 1.0 - cFocalEps;
      OneMinusP := 1.0 - P;
      // dL/dp_t = alpha * (1-p)^(gamma-1) * [gamma * p * log(p) - (1-p)] / p
      Grad := Alpha * pcr_powf(OneMinusP, Gamma - 1.0) *
              (Gamma * P * pcr_logf(P) - OneMinusP) / P;
      FOutputError.FData[Idx] := Grad;
    end
    else
    begin
      FOutputError.FData[Idx] := 0;
    end;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetSSIMLoss }

constructor TNNetSSIMLoss.Create();
begin
  Create(1.0);
end;

constructor TNNetSSIMLoss.Create(pDataRange: TNeuralFloat);
begin
  inherited Create();
  if pDataRange <= 0 then
    FErrorProc('TNNetSSIMLoss DataRange must be > 0.');
  FFloatSt[0] := pDataRange;
end;

procedure TNNetSSIMLoss.Backpropagate();
var
  StartTime: double;
  H, W, Channels, n, Idx, SizeM1: integer;
  DataRange: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  if not Assigned(NeuralSSIMLossGradientHook) then
    FErrorProc('TNNetSSIMLoss requires the SSIM kernel: add ''neuralimagemetrics'' to your uses clause to enable TNNetSSIMLoss.');
  DataRange := FFloatSt[0];
  if DataRange <= 0 then DataRange := 1.0;
  // The volume is one image: SizeX = width, SizeY = height, Depth = channels.
  // The volume's raw layout ((SizeX*y)+x)*Depth+d is bit-identical to the
  // helper's channel-last (y*W+x)*Channels+c, so the copy is a straight
  // element-for-element transfer (no index remapping).
  W := FOutput.SizeX;
  H := FOutput.SizeY;
  Channels := FOutput.Depth;
  n := FOutput.Size;
  SizeM1 := n - 1;
  // Persistent lazily-sized scratch (rule #17). The hook's GradA is an OPEN-array
  // out param that does NOT resize the caller's array, so it must be pre-sized to
  // the image length here; the two input arrays are fully overwritten below.
  if Length(FImgPred) <> n then SetLength(FImgPred, n);
  if Length(FImgTarget) <> n then SetLength(FImgTarget, n);
  if Length(FGradA) <> n then SetLength(FGradA, n);
  // FOutput is the prediction; the framework seeded FOutputError with
  // (prediction - target), so target := prediction - FOutputError.
  for Idx := 0 to SizeM1 do
  begin
    FImgPred[Idx]   := FOutput.FData[Idx];
    FImgTarget[Idx] := FOutput.FData[Idx] - FOutputError.FData[Idx];
  end;
  // Loss = 1 - mean(SSIM); GradA = +d(1-SSIM)/dprediction. Overwrite the
  // seeded residual with this analytic loss gradient so the optimizer descends
  // 1-SSIM (matching the sibling +dL/dprediction sign convention).
  NeuralSSIMLossGradientHook(FImgPred, FImgTarget, H, W, Channels, FGradA, DataRange);
  for Idx := 0 to SizeM1 do
    FOutputError.FData[Idx] := FGradA[Idx];
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetNLLLoss }

constructor TNNetNLLLoss.Create();
begin
  inherited Create();
end;

procedure TNNetNLLLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1: integer;
  LogP, Seeded, Target: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    LogP := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    // Framework seeds FOutputError := output - target = logp - target.
    // Recover target, then set the exact NLL gradient dL/d(logp) = -target.
    Target := LogP - Seeded;
    FOutputError.FData[Idx] := -Target;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetCTCLoss }

constructor TNNetCTCLoss.Create();
begin
  Create(-1);
end;

constructor TNNetCTCLoss.Create(Blank: integer);
begin
  inherited Create();
  // -1 is the sentinel meaning "last vocabulary index" (resolved at runtime).
  FStruct[0] := Blank;
  FCTCTarget := TNNetVolume.Create();
  FCTCGrad := TNNetVolume.Create();
end;

destructor TNNetCTCLoss.Destroy();
begin
  FCTCTarget.Free;
  FCTCGrad.Free;
  inherited Destroy();
end;

function TNNetCTCLoss.BlankIndex(): integer;
begin
  Result := FStruct[0];
  if Result < 0 then Result := FOutput.Depth - 1;
end;

class procedure TNNetCTCLoss.EncodeTarget(ATarget: TNNetVolume;
  const Labels: array of integer; T, Vocab: integer);
var
  L, LM1, i: integer;
begin
  L := Length(Labels);
  LM1 := L - 1;
  ATarget.ReSize(T, 1, Vocab);
  ATarget.Fill(0);
  // Frame 0 carries L then the labels. There must be room for L+1 entries.
  if (L + 1) > Vocab then
    raise Exception.Create('TNNetCTCLoss.EncodeTarget: vocab too small to hold label header.');
  ATarget[0, 0, 0] := L;
  for i := 0 to LM1 do
    ATarget[0, 0, 1 + i] := Labels[i];
end;

class procedure TNNetCTCLoss.DecodeTarget(ATarget: TNNetVolume;
  out Labels: TNeuralIntegerArray);
var
  L, LM1, i: integer;
begin
  L := Round(ATarget[0, 0, 0]);
  if L < 0 then L := 0;
  LM1 := L - 1;
  SetLength(Labels, L);
  for i := 0 to LM1 do
    Labels[i] := Round(ATarget[0, 0, 1 + i]);
end;

class procedure TNNetCTCLoss.DecodeTargetInto(ATarget: TNNetVolume;
  var ALabels: TNeuralIntegerArray; out ACount: integer);
var
  L, LM1, i: integer;
begin
  L := Round(ATarget[0, 0, 0]);
  if L < 0 then L := 0;
  LM1 := L - 1;
  // Keep the buffer non-empty so an L=0 target still yields a valid Slice base.
  if Length(ALabels) <= L then SetLength(ALabels, L + 1);
  for i := 0 to LM1 do
    ALabels[i] := Round(ATarget[0, 0, 1 + i]);
  ACount := L;
end;

function TNNetCTCLoss.ForwardBackwardLogLoss(ALogProbs: TNNetVolume;
  const Labels: array of integer; Blank: integer; AGrad: TNNetVolume): TNeuralFloat;
const
  cCTCUnalignable = 1e30; // returned when L*2+1 > T (target cannot be aligned)
  cNegInf = -1e30;
var
  NT, L, NS, NTM1, NSM1, VocabM1, LM1, ti, si, i: integer;
  NTM2, GradBase, GradIdx, Cells, Row, RowPrev, RowNext: integer;
  LogLike, av, bv, occ: double;
  function LP(volume: TNNetVolume; tt, kk: integer): double; inline;
  begin
    Result := volume[tt, 0, kk];
  end;
  function LogAdd(x, y: double): double; inline;
  begin
    if x <= cNegInf then Result := y
    else if y <= cNegInf then Result := x
    else if x > y then Result := x + pcr_logf(1 + NeuralExp(y - x))
    else Result := y + pcr_logf(1 + NeuralExp(x - y));
  end;
begin
  NT := ALogProbs.SizeX;
  L := Length(Labels);
  NTM1 := NT - 1;
  LM1 := L - 1;
  if Assigned(AGrad) then
  begin
    AGrad.ReSize(ALogProbs);
    AGrad.Fill(0);
  end;
  // Build extended label sequence: blank l_0 blank l_1 ... l_{L-1} blank.
  NS := 2 * L + 1;
  if NS > NT then
  begin
    Result := cCTCUnalignable;
    Exit;
  end;
  NSM1 := NS - 1;
  // #17: lazy, amortized growth of the persistent scratch - never a per-call
  // allocation. The lattices are FLAT (ti*NS + si), which also removes the
  // double indirection Alpha[ti][si] paid on every access of three O(NT*NS)
  // nests.
  if Length(FExtBuf) < NS then SetLength(FExtBuf, NS);
  Cells := NT * NS;
  if Length(FAlphaFlat) < Cells then SetLength(FAlphaFlat, Cells);
  if Length(FBetaFlat) < Cells then SetLength(FBetaFlat, Cells);
  for i := 0 to LM1 do
  begin
    FExtBuf[2 * i] := Blank;
    FExtBuf[2 * i + 1] := Labels[i];
  end;
  FExtBuf[NSM1] := Blank;
  // Clamp the symbol ids into the vocabulary once, so both the lattice reads
  // (LP indexes by Ext[si]) and the gradient scatter below stay in bounds
  // without a per-element range test.
  VocabM1 := ALogProbs.Depth - 1;
  for i := 0 to NSM1 do
  begin
    if FExtBuf[i] < 0 then FExtBuf[i] := 0
    else if FExtBuf[i] > VocabM1 then FExtBuf[i] := VocabM1;
  end;

  // Only two rows can ever be read un-written: the alpha recurrence below
  // assigns every si of every row ti >= 1, and the beta recurrence assigns
  // every si of every row ti <= NT-2. So seeding alpha row 0 and beta row
  // NT-1 covers every cell the boundary inits do not set, and the remaining
  // 2*(NT-1)*NS cells need no pre-pass.
  Row := NTM1 * NS;
  for i := 0 to NSM1 do
  begin
    FAlphaFlat[i] := cNegInf;
    FBetaFlat[Row + i] := cNegInf;
  end;

  // Forward (alpha). Init: at ti=0 only the first blank or first label.
  FAlphaFlat[0] := LP(ALogProbs, 0, FExtBuf[0]);
  if NS > 1 then FAlphaFlat[1] := LP(ALogProbs, 0, FExtBuf[1]);
  Row := NS;          // #6: carry ti*NS instead of re-multiplying it
  RowPrev := 0;
  for ti := 1 to NTM1 do
  begin
    for si := 0 to NSM1 do
    begin
      av := FAlphaFlat[RowPrev + si];
      if si >= 1 then av := LogAdd(av, FAlphaFlat[RowPrev + si - 1]);
      // Skip transition allowed only between two DISTINCT non-blank labels.
      if (si >= 2) and (FExtBuf[si] <> Blank) and
         (FExtBuf[si] <> FExtBuf[si - 2]) then
        av := LogAdd(av, FAlphaFlat[RowPrev + si - 2]);
      FAlphaFlat[Row + si] := av + LP(ALogProbs, ti, FExtBuf[si]);
    end;
    RowPrev := Row;
    Inc(Row, NS);
  end;

  // Backward (beta). Init: at ti=NT-1 only the last blank or last label.
  Row := NTM1 * NS;
  FBetaFlat[Row + NSM1] := 0;
  if NS > 1 then FBetaFlat[Row + NSM1 - 1] := 0;
  NTM2 := NT - 2;
  RowNext := Row;
  Dec(Row, NS);
  for ti := NTM2 downto 0 do
  begin
    for si := NSM1 downto 0 do
    begin
      bv := FBetaFlat[RowNext + si] + LP(ALogProbs, ti + 1, FExtBuf[si]);
      if si + 1 <= NSM1 then
        bv := LogAdd(bv, FBetaFlat[RowNext + si + 1] +
          LP(ALogProbs, ti + 1, FExtBuf[si + 1]));
      if (si + 2 <= NSM1) and (FExtBuf[si] <> Blank) and
         (FExtBuf[si] <> FExtBuf[si + 2]) then
        bv := LogAdd(bv, FBetaFlat[RowNext + si + 2] +
          LP(ALogProbs, ti + 1, FExtBuf[si + 2]));
      FBetaFlat[Row + si] := bv;
    end;
    RowNext := Row;
    Dec(Row, NS);
  end;

  // Total log-likelihood = LogAdd of the two valid end states (last blank and
  // last label) at ti=NT-1 via alpha.
  Row := NTM1 * NS;
  LogLike := FAlphaFlat[Row + NSM1];
  if NS > 1 then LogLike := LogAdd(LogLike, FAlphaFlat[Row + NSM1 - 1]);

  Result := -LogLike;

  if not Assigned(AGrad) then Exit;
  if LogLike <= cNegInf then Exit; // degenerate, leave grad at zero

  // Posterior occupancy gamma[ti][si] = exp(alpha+beta-LogLike); per symbol k,
  // dL/d(logp_{ti,k}) = -sum_{si: Ext[si]=k} gamma[ti][si]. Scatter each
  // occupancy straight into its own symbol slot instead of scanning the whole
  // vocabulary per frame: AGrad was zero-filled above, so a symbol that never
  // appears in Ext keeps the 0 the empty sum would have produced, and the
  // ascending-si accumulation order is unchanged. O(NT*NS), not O(NT*Vocab*NS).
  Row := 0;   // #6: carry ti*NS
  for ti := 0 to NTM1 do
  begin
    GradBase := AGrad.GetRawPos(ti, 0);
    for si := 0 to NSM1 do
    begin
      occ := FAlphaFlat[Row + si] + FBetaFlat[Row + si] - LogLike;
      if occ > cNegInf then
      begin
        GradIdx := GradBase + FExtBuf[si];
        AGrad.FData[GradIdx] := AGrad.FData[GradIdx] - NeuralExp(occ);
      end;
    end;
    Inc(Row, NS);
  end;
end;

procedure TNNetCTCLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1, LabelCnt: integer;
  LogP, Seeded: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  // Recover the target volume (target = output - seeded error), then the labels
  // from its frame-0 header. Persistent lazily-sized scratch (rule #17); the
  // loop below overwrites every element, so only the shape must match.
  if FCTCTarget.Size <> FOutput.Size then FCTCTarget.ReSize(FOutput);
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    LogP := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    FCTCTarget.FData[Idx] := LogP - Seeded;
  end;
  TNNetCTCLoss.DecodeTargetInto(FCTCTarget, FLabelsBuf, LabelCnt);

  // Run the log-space forward-backward and write -gamma into FOutputError.
  // ForwardBackwardLogLoss ReSizes+Fills FCTCGrad internally (rule #17 scratch).
  {$IFDEF FPC}
  ForwardBackwardLogLoss(FOutput, Slice(FLabelsBuf, LabelCnt), BlankIndex(), FCTCGrad);
  {$ELSE}
  ForwardBackwardLogLoss(FOutput, Copy(FLabelsBuf, 0, LabelCnt), BlankIndex(), FCTCGrad);
  {$ENDIF}
  FOutputError.Copy(FCTCGrad);

  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetKLDivergence }

constructor TNNetKLDivergence.Create();
begin
  inherited Create();
end;

procedure TNNetKLDivergence.Backpropagate();
const
  cKLEps = 1e-7;
var
  StartTime: double;
  Idx, SizeM1: integer;
  Q, Seeded, Target: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    Q := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    // Framework seeds FOutputError := output - target = q - p. Recover p.
    Target := Q - Seeded;
    if Target <= cKLEps then
    begin
      // 0 * log 0 := 0, so target=0 terms contribute no gradient.
      FOutputError.FData[Idx] := 0;
    end
    else
    begin
      // Clamp q into [eps, 1] before the division.
      if Q < cKLEps then Q := cKLEps
      else if Q > 1.0 then Q := 1.0;
      // dL/dq_i = -p_i / q_i.
      FOutputError.FData[Idx] := -Target / Q;
    end;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetPonderCostLoss }

constructor TNNetPonderCostLoss.Create();
begin
  Create(0.2);
end;

constructor TNNetPonderCostLoss.Create(pPriorLambda: TNeuralFloat);
begin
  inherited Create();
  if (pPriorLambda <= 0) or (pPriorLambda >= 1) then
    FErrorProc('TNNetPonderCostLoss prior_lambda must be in (0,1).');
  FFloatSt[0] := pPriorLambda;
end;

procedure TNNetPonderCostLoss.Backpropagate();
const
  cEps = 1e-7;
var
  StartTime: double;
  Idx, SizeM1: integer;
  Prior, PNorm, GeoSum, Gn: TNeuralFloat;
  P: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  SizeM1 := FOutputError.Size - 1;
  Prior := FFloatSt[0];
  // Geometric prior over the SizeM1+1 steps: g_n = prior*(1-prior)^n, renormalised
  // over the finite horizon so the tail mass beyond the last step does not bias the
  // target (sum of the truncated geometric series).
  GeoSum := 0;
  Gn := Prior;
  for Idx := 0 to SizeM1 do
  begin
    GeoSum := GeoSum + Gn;
    Gn := Gn * (1.0 - Prior);
  end;
  if GeoSum < cEps then GeoSum := cEps;
  // This is a self-contained penalty head with NO external target: read p straight
  // from FOutput and overwrite the seeded residual with the analytic KL gradient.
  // dL/dp_n = log(p_n) - log(g_n) + 1  (the +gradient, so the optimizer descends).
  Gn := Prior;
  for Idx := 0 to SizeM1 do
  begin
    P := FOutput.FData[Idx];
    if P < cEps then P := cEps
    else if P > 1.0 then P := 1.0;
    PNorm := Gn / GeoSum;            // renormalised geometric prior at step Idx
    if PNorm < cEps then PNorm := cEps;
    FOutputError.FData[Idx] := pcr_logf(P) - pcr_logf(PNorm) + 1.0;
    Gn := Gn * (1.0 - Prior);
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetTverskyLoss }

constructor TNNetTverskyLoss.Create();
begin
  Create(0.5, 0.5, 1.0);
end;

constructor TNNetTverskyLoss.Create(pAlpha, pBeta, pSmooth: TNeuralFloat);
begin
  inherited Create();
  if pAlpha < 0 then
    FErrorProc('TNNetTverskyLoss alpha must be >= 0.');
  if pBeta < 0 then
    FErrorProc('TNNetTverskyLoss beta must be >= 0.');
  if pSmooth <= 0 then
    FErrorProc('TNNetTverskyLoss smooth must be > 0.');
  FFloatSt[0] := pAlpha;
  FFloatSt[1] := pBeta;
  FFloatSt[2] := pSmooth;
end;

procedure TNNetTverskyLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1: integer;
  Alpha, Beta, Smooth: TNeuralFloat;
  P, Seeded, G: TNeuralFloat;
  TP, FP, FN, Numer, D, DSq, dDdp: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Alpha := FFloatSt[0];
  if Alpha < 0 then Alpha := 0.5;
  Beta := FFloatSt[1];
  if Beta < 0 then Beta := 0.5;
  Smooth := FFloatSt[2];
  if Smooth <= 0 then Smooth := 1.0;
  SizeM1 := FOutputError.Size - 1;
  // First pass: accumulate set-level TP, FP, FN over the whole volume.
  // The framework seeds FOutputError := output - target, so g = p - seeded.
  TP := 0; FP := 0; FN := 0;
  for Idx := 0 to SizeM1 do
  begin
    P := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    G := P - Seeded;
    TP := TP + P * G;
    FP := FP + P * (1.0 - G);
    FN := FN + (1.0 - P) * G;
  end;
  Numer := TP + Smooth;                       // numerator of the Tversky index
  D  := TP + Alpha * FP + Beta * FN + Smooth; // denominator
  DSq := D * D;
  if DSq <= 0 then DSq := 1e-12;
  // Second pass: replace each residual with the analytic dL/dp_i.
  // dTP/dp_i = g_i, dD/dp_i = g_i + alpha*(1-g_i) - beta*g_i, L = 1 - Nn/D.
  // dL/dp_i = -( g_i*D - Nn*dD/dp_i ) / D^2.
  for Idx := 0 to SizeM1 do
  begin
    P := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    G := P - Seeded;
    dDdp := G + Alpha * (1.0 - G) - Beta * G;
    FOutputError.FData[Idx] := -(G * D - Numer * dDdp) / DSq;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetDiceLoss }

constructor TNNetDiceLoss.Create();
begin
  inherited Create(0.5, 0.5, 1.0);
end;

{ TNNetTripletLoss }

constructor TNNetTripletLoss.Create();
begin
  Create(1.0);
end;

constructor TNNetTripletLoss.Create(pMargin: TNeuralFloat);
begin
  inherited Create();
  if pMargin < 0 then
    FErrorProc('TNNetTripletLoss margin must be >= 0.');
  FFloatSt[0] := pMargin;
end;

procedure TNNetTripletLoss.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  if (pPrevLayer.FOutput.Depth mod 3) <> 0 then
  begin
    FErrorProc('TNNetTripletLoss requires input depth divisible by 3. ' +
      'Input depth: ' + IntToStr(pPrevLayer.FOutput.Depth));
  end;
end;

procedure TNNetTripletLoss.Backpropagate();
var
  StartTime: double;
  Margin, a, p, n, DistAP, DistAN, Hinge: TNeuralFloat;
  MaxX, MaxY, D, ChunkD, ChunkDM1, X, Y, base, baseOut0, TwoChunkD, bP, bN: integer;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Margin := FFloatSt[0];
  if Margin < 0 then Margin := 1.0;
  ChunkD := FOutput.Depth div 3;
  ChunkDM1 := ChunkD - 1;
  TwoChunkD := 2 * ChunkD;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Per spatial cell: accumulate the squared distances over the chunk, decide
  // whether the hinge is active, then write the 3 gradient slices (or zeros).
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      DistAP := 0;
      DistAN := 0;
      baseOut0 := FOutput.GetRawPos(X, Y);
      for D := 0 to ChunkDM1 do
      begin
        base := baseOut0 + D;
        a := FOutput.FData[base];
        p := FOutput.FData[base + ChunkD];
        n := FOutput.FData[base + TwoChunkD];
        DistAP := DistAP + (a - p) * (a - p);
        DistAN := DistAN + (a - n) * (a - n);
      end;
      Hinge := DistAP - DistAN + Margin;
      if Hinge > 0 then
      begin
        for D := 0 to ChunkDM1 do
        begin
          base := baseOut0 + D;
          bP := base + ChunkD;
          bN := base + TwoChunkD;
          a := FOutput.FData[base];
          p := FOutput.FData[bP];
          n := FOutput.FData[bN];
          // dL/da = 2*(n - p), dL/dp = -2*(a - p), dL/dn = 2*(a - n)
          FOutputError.FData[base] := 2.0 * (n - p);
          FOutputError.FData[bP]   := -2.0 * (a - p);
          FOutputError.FData[bN]   := 2.0 * (a - n);
        end;
      end
      else
        // All 3 slices over D=0..ChunkDM1 cover baseOut0..baseOut0+3*ChunkD-1.
        FillChar(FOutputError.FData[baseOut0], 3 * ChunkD * csNeuralFloatSize, 0);
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetLoadBalanceLoss }

constructor TNNetLoadBalanceLoss.Create();
begin
  Create(1, 0.01);
end;

constructor TNNetLoadBalanceLoss.Create(TopCnt: integer; Coeff: TNeuralFloat);
begin
  inherited Create();
  if TopCnt < 1 then TopCnt := 1;
  if Coeff < 0 then
    FErrorProc('TNNetLoadBalanceLoss coeff must be >= 0.');
  FStruct[0] := TopCnt;
  FFloatSt[0] := Coeff;
end;

procedure TNNetLoadBalanceLoss.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  E: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  E := pPrevLayer.FOutput.Depth; // number of experts
  SetLength(FFBuf, E);
  SetLength(FKeptBuf, E);
  SetLength(FTopIdx, E);
  SetLength(FTopVal, E);
end;

destructor TNNetLoadBalanceLoss.Destroy();
begin
  SetLength(FFBuf, 0);
  SetLength(FKeptBuf, 0);
  SetLength(FTopIdx, 0);
  SetLength(FTopVal, 0);
  inherited Destroy();
end;

procedure TNNetLoadBalanceLoss.Backpropagate();
var
  StartTime: double;
  Coeff, InvT, kScale: TNeuralFloat;
  E, EM1, T, TopCnt, MaxX, MaxY, X, Y, D, baseOut0, baseErr0,
  RowBytes: integer;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  E := FOutput.Depth;
  EM1 := E - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  T := FOutput.SizeX * FOutput.SizeY;       // number of tokens (cells)
  TopCnt := FStruct[0];
  if TopCnt > E then TopCnt := E;
  Coeff := FFloatSt[0];
  if T < 1 then T := 1;
  InvT := 1.0 / T;
  FillChar(FFBuf[0], E * csNeuralFloatSize, 0);
  // Aggregate f_i (mean top-k touch fraction) over all tokens (cells). P_i (the
  // mean gate probability) is not aggregated: the gradient below carries only
  // the stop-gradient f_i, so no P_i quantity is ever read.
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      FillChar(FKeptBuf[0], E, 0); // Boolean = 1 byte
      // Hard top-TopCnt assignment for this token (#22: one pass, not TopCnt).
      NeuralMarkTopK(FOutput.DataPtr, nil, baseOut0, 1, E, TopCnt,
        FKeptBuf, FTopIdx, FTopVal);
      for D := 0 to EM1 do
        if FKeptBuf[D] then FFBuf[D] := FFBuf[D] + 1;
    end;
  TNNetVolume.Mul(@FFBuf[0], InvT, E);
  // dL_aux/dg_t[i] = coeff * E * f_i / T  (f_i is stop-gradient), the same row
  // for every token. kScale is invariant across the nest, so fold it into FFBuf
  // once and leave the per-token body a pure Move. FFBuf is re-zeroed at the top
  // of every call and read nowhere after this nest, so scaling in place is safe.
  kScale := Coeff * E * InvT;
  TNNetVolume.Mul(@FFBuf[0], kScale, E);
  RowBytes := E * csNeuralFloatSize;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseErr0 := FOutputError.GetRawPos(X, Y);
      Move(FFBuf[0], FOutputError.FData[baseErr0], RowBytes);
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetDETRSetPredictionLoss }

// Sub-gradient of |x| at 0 taken as 0 (standard L1 convention).
function DETRSign(x: TNeuralFloat): TNeuralFloat;
begin
  if x > 0 then Result := 1.0
  else if x < 0 then Result := -1.0
  else Result := 0.0;
end;

constructor TNNetDETRSetPredictionLoss.Create();
begin
  // DETR default: a single foreground class is meaningless, so require an
  // explicit count via the other constructor; pick 1 as a harmless fallback.
  Create(1, 1.0, 5.0, 2.0, 0.1);
end;

constructor TNNetDETRSetPredictionLoss.Create(NumLabels: integer);
begin
  // transformers DetrConfig defaults: class_cost=1, bbox_cost=5, giou_cost=2,
  // eos_coefficient=0.1 (the box loss coefficients reuse the cost weights).
  Create(NumLabels, 1.0, 5.0, 2.0, 0.1);
end;

constructor TNNetDETRSetPredictionLoss.Create(NumLabels: integer;
  ClassCost, BBoxCost, GIoUCost, EosCoef: TNeuralFloat);
begin
  inherited Create();
  if NumLabels < 1 then
    FErrorProc('TNNetDETRSetPredictionLoss requires NumLabels >= 1.');
  if (ClassCost < 0) or (BBoxCost < 0) or (GIoUCost < 0) then
    FErrorProc('TNNetDETRSetPredictionLoss cost weights must be >= 0.');
  if (EosCoef <= 0) then
    FErrorProc('TNNetDETRSetPredictionLoss eos_coef must be > 0.');
  FStruct[0]  := NumLabels;
  FFloatSt[0] := ClassCost;
  FFloatSt[1] := BBoxCost;
  FFloatSt[2] := GIoUCost;
  FFloatSt[3] := EosCoef;
end;

function TNNetDETRSetPredictionLoss.NumLabels(): integer;
begin Result := FStruct[0]; end;

function TNNetDETRSetPredictionLoss.ClassCost(): TNeuralFloat;
begin Result := FFloatSt[0]; end;

function TNNetDETRSetPredictionLoss.BBoxCost(): TNeuralFloat;
begin Result := FFloatSt[1]; end;

function TNNetDETRSetPredictionLoss.GIoUCost(): TNeuralFloat;
begin Result := FFloatSt[2]; end;

function TNNetDETRSetPredictionLoss.EosCoef(): TNeuralFloat;
begin Result := FFloatSt[3]; end;

procedure TNNetDETRSetPredictionLoss.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  D, LblCnt, N: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  LblCnt := FStruct[0];
  D := pPrevLayer.FOutput.Depth;
  if D <> LblCnt + 1 + 4 then
    FErrorProc('TNNetDETRSetPredictionLoss input depth must be LblCnt+1+4 (' +
      IntToStr(LblCnt + 5) + '); got ' + IntToStr(D) + '.');
  FTargetGT := TNNetVolume.Create(pPrevLayer.FOutput);
  FTargetGT.Fill(0);
  N := pPrevLayer.FOutput.SizeX * pPrevLayer.FOutput.SizeY; // # queries
  SetLength(FMatchGT, N);
end;

destructor TNNetDETRSetPredictionLoss.Destroy();
begin
  SetLength(FMatchGT, 0);
  if Assigned(FTargetGT) then FTargetGT.Free;
  inherited Destroy();
end;

procedure TNNetDETRSetPredictionLoss.ComputeOutputErrorWith(pOutput: TNNetVolume);
begin
  // Capture the RAW ground-truth target (the matcher needs it); do NOT seed
  // FOutputError := output - target. Backpropagate overwrites FOutputError with
  // the analytic DETR gradient from scratch.
  if (pOutput.Size = FTargetGT.Size) then
    FTargetGT.CopyNoChecks(pOutput)
  else
    FErrorProc('TNNetDETRSetPredictionLoss target size mismatch: got ' +
      IntToStr(pOutput.Size) + ' expected ' + IntToStr(FTargetGT.Size) + '.');
end;

// Reads query q's LblCnt+1 class logits from V into the caller's Probs
// buffer as a numerically-stable softmax.
procedure DETRSoftMaxQuery(V: TNNetVolume; X, Y, LblCnt: integer;
  var Probs: array of TNeuralFloat; DstBase: integer);
var
  K1, base: integer;
  MaxL, S: TNeuralFloat;
begin
  K1 := LblCnt + 1;         // LblCnt classes + the no-object slot at index LblCnt
  base := V.GetRawPos(X, Y);
  // #18/#19: the LblCnt+1 class logits are contiguous along depth and the
  // caller's destination slice is contiguous too, so the max, the fused
  // exp-and-sum and the normalize are all vectorized passes.
  MaxL := TNNetVolume.MaxValue(Addr(V.FData[base]), K1);
  S := TNNetVolume.ExpShiftSum(Addr(Probs[DstBase]), Addr(V.FData[base]),
    MaxL, K1);
  if S <= 0 then S := 1e-12;
  TNNetVolume.Mul(Addr(Probs[DstBase]), 1.0 / S, K1);
end;

function TNNetDETRSetPredictionLoss.SolveMatching(pOut: TNNetVolume): integer;
var
  LblCnt, N, M, BoxBase, q, mc, gtRows, X, Y, gtCls, iter: integer;
  qM, K1, ProbBase: integer;
  bestQ, bestM: integer;
  NM1, MM1: integer;
  TgtSizeXM1, TgtSizeYM1, OutSizeXM1, OutSizeYM1: integer;
  pCx, pCy, pW, pH, L1, GIoU, ClassTerm: TNeuralFloat;
  ax1, ay1, ax2, ay2, bx1, by1, bx2, by2, bestVal, v: TNeuralFloat;
  gcx, gcy, gw, gh, wCls, wBox, wGiou: TNeuralFloat;
begin
  LblCnt := FStruct[0];
  BoxBase := LblCnt + 1;               // first box channel
  N := pOut.SizeX * pOut.SizeY;
  NM1 := N - 1;
  for q := 0 to NM1 do FMatchGT[q] := -1;
  // Softmax every query once, before the M=0 exit: both callers read this
  // cache for every query whether or not any ground truth survived.
  K1 := LblCnt + 1;
  if Length(FProbsCache) < N * K1 then SetLength(FProbsCache, N * K1); // rule #17: grow-only
  q := 0;
  OutSizeXM1 := pOut.SizeX - 1;
  OutSizeYM1 := pOut.SizeY - 1;
  for X := 0 to OutSizeXM1 do
    for Y := 0 to OutSizeYM1 do
    begin
      DETRSoftMaxQuery(pOut, X, Y, LblCnt, FProbsCache, q * K1);
      Inc(q);
    end;
  // Collect the valid (non-padding) ground-truth objects.
  gtRows := FTargetGT.SizeX * FTargetGT.SizeY;
  // Persistent lazily-sized scratch (rule #17): grow only when a larger pass needs it.
  if Length(FgtClass) < gtRows then
  begin
    SetLength(FgtClass, gtRows);
    SetLength(FgtCx, gtRows); SetLength(FgtCy, gtRows);
    SetLength(FgtW, gtRows); SetLength(FgtH, gtRows);
  end;
  M := 0;
  TgtSizeXM1 := FTargetGT.SizeX - 1;
  TgtSizeYM1 := FTargetGT.SizeY - 1;
  for X := 0 to TgtSizeXM1 do
    for Y := 0 to TgtSizeYM1 do
    begin
      gtCls := Round(FTargetGT[X, Y, 0]);
      if gtCls < 0 then Continue;         // padding row
      if gtCls > LblCnt - 1 then gtCls := LblCnt - 1;
      FgtClass[M] := gtCls;
      FgtCx[M] := FTargetGT[X, Y, BoxBase + 0];
      FgtCy[M] := FTargetGT[X, Y, BoxBase + 1];
      FgtW[M]  := FTargetGT[X, Y, BoxBase + 2];
      FgtH[M]  := FTargetGT[X, Y, BoxBase + 3];
      Inc(M);
    end;
  Result := M;
  if M = 0 then Exit;
  MM1 := M - 1;
  // Build the N x M cost matrix (class + L1 + GIoU terms, DETR weights).
  if Length(FCost) < N * M then SetLength(FCost, N * M); // rule #17: grow-only
  q := 0;
  wCls := FFloatSt[0]; wBox := FFloatSt[1]; wGiou := FFloatSt[2];
  for X := 0 to OutSizeXM1 do
    for Y := 0 to OutSizeYM1 do
    begin
      ProbBase := q * K1;
      pCx := pOut[X, Y, BoxBase + 0];
      pCy := pOut[X, Y, BoxBase + 1];
      pW  := pOut[X, Y, BoxBase + 2];
      pH  := pOut[X, Y, BoxBase + 3];
      ax1 := pCx - pW * 0.5; ay1 := pCy - pH * 0.5;
      ax2 := pCx + pW * 0.5; ay2 := pCy + pH * 0.5;
      qM := q * M;
      for mc := 0 to MM1 do
      begin
        gcx := FgtCx[mc]; gcy := FgtCy[mc]; gw := FgtW[mc]; gh := FgtH[mc];
        ClassTerm := -FProbsCache[ProbBase + FgtClass[mc]];
        L1 := Abs(pCx - gcx) + Abs(pCy - gcy) +
              Abs(pW - gw) + Abs(pH - gh);
        bx1 := gcx - gw * 0.5; by1 := gcy - gh * 0.5;
        bx2 := gcx + gw * 0.5; by2 := gcy + gh * 0.5;
        GIoU := NeuralBoxGIoU(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2);
        FCost[qM + mc] := wCls * ClassTerm + wBox * L1 +
             wGiou * (-GIoU);
      end;
      Inc(q);
    end;
  // Greedy assignment: repeatedly take the globally-smallest unmatched cell.
  if Length(FqUsed) < N then SetLength(FqUsed, N); // rule #17: grow-only
  if Length(FmUsed) < M then SetLength(FmUsed, M); // rule #17: grow-only
  for q := 0 to NM1 do FqUsed[q] := False;
  for mc := 0 to MM1 do FmUsed[mc] := False;
  for iter := 1 to M do                   // exactly M matches to make
  begin
    bestQ := -1; bestM := -1; bestVal := 0;
    for q := 0 to NM1 do
    begin
      if FqUsed[q] then Continue;
      qM := q * M;
      for mc := 0 to MM1 do
      begin
        if FmUsed[mc] then Continue;
        v := FCost[qM + mc];
        if (bestQ < 0) or (v < bestVal) then
        begin bestVal := v; bestQ := q; bestM := mc; end;
      end;
    end;
    if bestQ < 0 then Break;
    FqUsed[bestQ] := True; FmUsed[bestM] := True;
    FMatchGT[bestQ] := bestM;
  end;
end;

function TNNetDETRSetPredictionLoss.DETRSetPredictionLoss(
  pOut, pTarget: TNNetVolume): TNeuralFloat;
var
  LblCnt, N, M, BoxBase, q, X, Y, tgtCls: integer;
  NM1: integer;
  Loss, Eos, w, p, pCx, pCy, pW, pH: TNeuralFloat;
  ax1, ay1, ax2, ay2, bx1, by1, bx2, by2, GIoU, L1: TNeuralFloat;
  gcx, gcy, gw, gh: TNeuralFloat;
  mi, K1, ProbBase: integer;
  OutSizeXM1, OutSizeYM1: integer;
begin
  // Self-contained: capture pTarget then run the same greedy match used in
  // Backpropagate, so a finite-difference probe sees the identical loss.
  if (pTarget.Size = FTargetGT.Size) then
    FTargetGT.CopyNoChecks(pTarget)
  else
    FErrorProc('DETRSetPredictionLoss target size mismatch.');
  LblCnt := FStruct[0];
  BoxBase := LblCnt + 1;
  Eos := FFloatSt[3];
  N := pOut.SizeX * pOut.SizeY;
  M := SolveMatching(pOut);
  // Map query -> its matched gt class (or no-object).
  if Length(FqMatch) < N then SetLength(FqMatch, N); // rule #17: grow-only
  NM1 := N - 1;
  for q := 0 to NM1 do FqMatch[q] := FMatchGT[q];
  K1 := LblCnt + 1;
  Loss := 0;
  q := 0;
  OutSizeXM1 := pOut.SizeX - 1;
  OutSizeYM1 := pOut.SizeY - 1;
  for X := 0 to OutSizeXM1 do
    for Y := 0 to OutSizeYM1 do
    begin
      ProbBase := q * K1;
      if FqMatch[q] >= 0 then
      begin
        // matched: CE to gt class (weight 1) + box L1 + (1-GIoU).
        mi := FqMatch[q];
        gcx := FgtCx[mi]; gcy := FgtCy[mi]; gw := FgtW[mi]; gh := FgtH[mi];
        tgtCls := FgtClass[mi];
        w := 1.0;
        p := FProbsCache[ProbBase + tgtCls];
        if p < 1e-12 then p := 1e-12;
        Loss := Loss - w * pcr_logf(p);
        pCx := pOut[X, Y, BoxBase + 0]; pCy := pOut[X, Y, BoxBase + 1];
        pW  := pOut[X, Y, BoxBase + 2]; pH  := pOut[X, Y, BoxBase + 3];
        L1 := Abs(pCx - gcx) + Abs(pCy - gcy) +
              Abs(pW - gw) + Abs(pH - gh);
        ax1 := pCx - pW * 0.5; ay1 := pCy - pH * 0.5;
        ax2 := pCx + pW * 0.5; ay2 := pCy + pH * 0.5;
        bx1 := gcx - gw * 0.5;
        by1 := gcy - gh * 0.5;
        bx2 := gcx + gw * 0.5;
        by2 := gcy + gh * 0.5;
        GIoU := NeuralBoxGIoU(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2);
        Loss := Loss + FFloatSt[1] * L1 + FFloatSt[2] * (1.0 - GIoU);
      end
      else
      begin
        // unmatched: CE to no-object class (index LblCnt), eos-weighted.
        p := FProbsCache[ProbBase + LblCnt];
        if p < 1e-12 then p := 1e-12;
        Loss := Loss - Eos * pcr_logf(p);
      end;
      Inc(q);
    end;
  // Normalize the per-pair terms by M (= #gt), DETR convention. Guard M=0.
  if M < 1 then M := 1;
  Result := Loss / M;
end;

procedure TNNetDETRSetPredictionLoss.Backpropagate();
const
  cFD = 1e-4;  // central-difference step for the GIoU box gradient
var
  StartTime: double;
  LblCnt, N, M, BoxBase, q, X, Y, C, tgtCls, k: integer;
  Eos, w, InvM, target, grad, wInvM, bboxInvM, giouInvM: TNeuralFloat;
  pBox: array[0..3] of TNeuralFloat;
  bx1, by1, bx2, by2, ax1, ay1, ax2, ay2, gP, gM, gGrad, half: TNeuralFloat;
  midx, K1, ProbBase: integer;
  FOutSizeXM1, FOutSizeYM1, baseErr0, bb: integer;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  LblCnt := FStruct[0];
  BoxBase := LblCnt + 1;
  Eos := FFloatSt[3];
  N := FOutput.SizeX * FOutput.SizeY;
  M := SolveMatching(FOutput);
  if M < 1 then InvM := 1.0 else InvM := 1.0 / M;
  FOutputError.Fill(0);
  K1 := LblCnt + 1;
  bboxInvM := FFloatSt[1] * InvM;   // #5: invariant across the whole X/Y/C nest
  giouInvM := FFloatSt[2] * InvM;
  q := 0;
  FOutSizeXM1 := FOutput.SizeX - 1;
  FOutSizeYM1 := FOutput.SizeY - 1;
  for X := 0 to FOutSizeXM1 do
    for Y := 0 to FOutSizeYM1 do
    begin
      ProbBase := q * K1;
      baseErr0 := FOutputError.GetRawPos(X, Y);
      midx := FMatchGT[q];
      if midx >= 0 then
      begin
        tgtCls := FgtClass[midx];
        w := 1.0;                          // matched CE weight
      end
      else
      begin
        tgtCls := LblCnt;               // no-object slot
        w := Eos;
      end;
      // Classification CE gradient: w*(softmax - onehot)/M into logit channels.
      wInvM := w * InvM;   // #5: invariant across the C loop
      for C := 0 to LblCnt do
      begin
        if C = tgtCls then target := 1.0 else target := 0.0;
        FOutputError.FData[baseErr0 + C] :=
          wInvM * (FProbsCache[ProbBase + C] - target);
      end;
      // Box gradient (matched queries only).
      if midx >= 0 then
      begin
        // FOutput/FOutputError share this layer's shape, so baseErr0 = GetRawPos(X,Y)
        // indexes both; the box channels live at [bb .. bb+3] (#3/#4).
        bb := baseErr0 + BoxBase;
        pBox[0] := FOutput.FData[bb + 0];
        pBox[1] := FOutput.FData[bb + 1];
        pBox[2] := FOutput.FData[bb + 2];
        pBox[3] := FOutput.FData[bb + 3];
        bx1 := FgtCx[midx] - FgtW[midx] * 0.5; by1 := FgtCy[midx] - FgtH[midx] * 0.5;
        bx2 := FgtCx[midx] + FgtW[midx] * 0.5; by2 := FgtCy[midx] + FgtH[midx] * 0.5;
        // L1 term: bbox*sign(pBox-gt)/M.
        grad := bboxInvM * DETRSign(pBox[0] - FgtCx[midx]);
        FOutputError.FData[bb + 0] := FOutputError.FData[bb + 0] + grad;
        grad := bboxInvM * DETRSign(pBox[1] - FgtCy[midx]);
        FOutputError.FData[bb + 1] := FOutputError.FData[bb + 1] + grad;
        grad := bboxInvM * DETRSign(pBox[2] - FgtW[midx]);
        FOutputError.FData[bb + 2] := FOutputError.FData[bb + 2] + grad;
        grad := bboxInvM * DETRSign(pBox[3] - FgtH[midx]);
        FOutputError.FData[bb + 3] := FOutputError.FData[bb + 3] + grad;
        // GIoU term: loss = giou*(1 - GIoU)/M. d/dpBox via central difference of
        // NeuralBoxGIoU over each of the four cxcywh channels.
        for k := 0 to 3 do
        begin
          half := pBox[k];
          pBox[k] := half + cFD;
          ax1 := pBox[0] - pBox[2] * 0.5; ay1 := pBox[1] - pBox[3] * 0.5;
          ax2 := pBox[0] + pBox[2] * 0.5; ay2 := pBox[1] + pBox[3] * 0.5;
          gP := NeuralBoxGIoU(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2);
          pBox[k] := half - cFD;
          ax1 := pBox[0] - pBox[2] * 0.5; ay1 := pBox[1] - pBox[3] * 0.5;
          ax2 := pBox[0] + pBox[2] * 0.5; ay2 := pBox[1] + pBox[3] * 0.5;
          gM := NeuralBoxGIoU(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2);
          pBox[k] := half;
          // d(1-GIoU)/dpBox[k] = -dGIoU/dpBox[k].
          gGrad := -(gP - gM) / (2.0 * cFD);
          FOutputError.FData[bb + k] :=
            FOutputError.FData[bb + k] + giouInvM * gGrad;
        end;
      end;
      Inc(q);
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetCosineEmbeddingLoss }

constructor TNNetCosineEmbeddingLoss.Create();
begin
  Create(0.0);
end;

constructor TNNetCosineEmbeddingLoss.Create(pMargin: TNeuralFloat);
begin
  inherited Create();
  if (pMargin < -1) or (pMargin > 1) then
    FErrorProc('TNNetCosineEmbeddingLoss margin must be in [-1, 1].');
  FFloatSt[0] := pMargin;
end;

procedure TNNetCosineEmbeddingLoss.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  if (pPrevLayer.FOutput.Depth < 3) or
     ((pPrevLayer.FOutput.Depth and 1) = 0) then
  begin
    FErrorProc('TNNetCosineEmbeddingLoss requires odd input depth >= 3 ' +
      '(layout a|b|y). Input depth: ' +
      IntToStr(pPrevLayer.FOutput.Depth));
  end;
end;

procedure TNNetCosineEmbeddingLoss.Backpropagate();
var
  StartTime: double;
  Margin, Eps, YLabel, AVal, BVal, Dot, NormASq, NormBSq: TNeuralFloat;
  InvDenom, CosVal, dLdCos, NormA, NormB, HingeArg: TNeuralFloat;
  invA, invB: TNeuralFloat;
  aPtr, bPtr: TNeuralFloatArrPtr;
  MaxX, MaxY, ChunkD, ChunkDM1, X, Y, D, baseOut0, baseErr0, twoChunkD: integer;
  idxA, idxB, eA, eB: integer;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Margin := FFloatSt[0];
  if (Margin < -1) or (Margin > 1) then Margin := 0.0;
  Eps := 1e-12;
  ChunkD := (FOutput.Depth - 1) shr 1; // #15: div 2, dimension is non-negative
  ChunkDM1 := ChunkD - 1;
  twoChunkD := 2 * ChunkD;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Per spatial cell: read the a|b slabs and the y label, compute the cosine
  // similarity, then write the +gradient into the a and b slices (0 into y).
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      YLabel := FOutput.FData[baseOut0 + twoChunkD];
      // #13: Dot / NormASq / NormBSq are three pure reductions (as
      // TNNetCosineSimilarity.Compute does).
      aPtr := FOutput.GetRawPtr(baseOut0);
      bPtr := FOutput.GetRawPtr(baseOut0 + ChunkD);
      Dot := TNNetVolume.DotProduct(aPtr, bPtr, ChunkD);
      NormASq := TNNetVolume.DotProduct(aPtr, aPtr, ChunkD);
      NormBSq := TNNetVolume.DotProduct(bPtr, bPtr, ChunkD);
      NormA := Sqrt(NormASq);
      NormB := Sqrt(NormBSq);
      InvDenom := 1.0 / (NormA * NormB + Eps);
      CosVal := Dot * InvDenom;
      HingeArg := CosVal - Margin;
      if HingeArg < 0 then HingeArg := 0;
      // dL/dcos = -y + (1-y)*2*max(0, cos - m)
      dLdCos := -YLabel + (1.0 - YLabel) * 2.0 * HingeArg;
      invA := CosVal / (NormASq + Eps);
      invB := CosVal / (NormBSq + Eps);
      for D := 0 to ChunkDM1 do
      begin
        idxA := baseOut0 + D;
        idxB := idxA + ChunkD;
        eA := baseErr0 + D;
        eB := eA + ChunkD;
        AVal := FOutput.FData[idxA];
        BVal := FOutput.FData[idxB];
        // dcos/da = b/(||a||*||b||) - cos * a/||a||^2 (symmetric for b)
        FOutputError.FData[eA] :=
          dLdCos * (BVal * InvDenom - AVal * invA);
        FOutputError.FData[eB] :=
          dLdCos * (AVal * InvDenom - BVal * invB);
      end;
      FOutputError.FData[baseErr0 + twoChunkD] := 0;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetInfoNCELoss }

constructor TNNetInfoNCELoss.Create();
begin
  Create(1, 0.07);
end;

constructor TNNetInfoNCELoss.Create(EmbeddingDim: integer; Temperature: TNeuralFloat);
begin
  inherited Create();
  if EmbeddingDim < 1 then
    FErrorProc('TNNetInfoNCELoss embedding dim must be >= 1.');
  if Temperature <= 0 then
    FErrorProc('TNNetInfoNCELoss temperature must be > 0.');
  FStruct[0] := EmbeddingDim;
  FFloatSt[0] := Temperature;
end;

procedure TNNetInfoNCELoss.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  D, NumSlabs: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  D := FStruct[0];
  if D < 1 then
    FErrorProc('TNNetInfoNCELoss embedding dim must be >= 1.');
  if (pPrevLayer.FOutput.Depth mod D) <> 0 then
  begin
    FErrorProc('TNNetInfoNCELoss requires input depth divisible by the ' +
      'embedding dim. Input depth: ' + IntToStr(pPrevLayer.FOutput.Depth) +
      ', embedding dim: ' + IntToStr(D));
  end;
  NumSlabs := pPrevLayer.FOutput.Depth div D;
  if NumSlabs < 3 then
  begin
    FErrorProc('TNNetInfoNCELoss requires at least 3 slabs (1 query + 2 ' +
      'keys). Slabs: ' + IntToStr(NumSlabs));
  end;
  // Backward scratch sized K = number of keys (NumSlabs - 1).
  SetLength(FSimsBuf, NumSlabs - 1);
  SetLength(FProbsBuf, NumSlabs - 1);
end;

destructor TNNetInfoNCELoss.Destroy();
begin
  SetLength(FSimsBuf, 0);
  SetLength(FProbsBuf, 0);
  inherited Destroy();
end;

procedure TNNetInfoNCELoss.Backpropagate();
var
  StartTime: double;
  Tau, InvTau, MaxS, SumExp, coef: TNeuralFloat;
  EmbDim, K, KM1, NumSlabs, X, Y, MaxX, MaxY, J, baseOut0, baseErr0: integer;
  kBase, errKBase: integer;
  qPtr, errQPtr: TNeuralFloatArrPtr;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Tau := FFloatSt[0];
  if Tau <= 0 then Tau := 0.07;
  InvTau := 1.0 / Tau;
  EmbDim := FStruct[0];
  if EmbDim < 1 then EmbDim := 1;
  NumSlabs := FOutput.Depth div EmbDim;
  K := NumSlabs - 1; // number of key vectors (positive + negatives)
  KM1 := K - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Per spatial cell: q is slab 0 (channels 0..EmbDim-1), key j is slab (1+j)
  // occupying channels [EmbDim*(1+j) .. EmbDim*(2+j)-1]. Compute similarities
  // s_j = <q, k_j>/tau, softmax over j, then write the analytic +gradient.
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      qPtr := FOutput.GetRawPtr(baseOut0);
      // similarities s_j = <q, k_j> / tau  (#13: pure reduction)
      kBase := baseOut0 + EmbDim;
      for J := 0 to KM1 do
      begin
        FSimsBuf[J] := TNNetVolume.DotProduct(qPtr, FOutput.GetRawPtr(kBase), EmbDim) * InvTau;
        Inc(kBase, EmbDim);
      end;
      // softmax over similarities (stable via max subtraction)
      MaxS := FSimsBuf[0];
      for J := 1 to KM1 do
        if FSimsBuf[J] > MaxS then MaxS := FSimsBuf[J];
      SumExp := 0;
      for J := 0 to KM1 do
      begin
        FProbsBuf[J] := NeuralExp(FSimsBuf[J] - MaxS);
        SumExp := SumExp + FProbsBuf[J];
      end;
      for J := 0 to KM1 do
        FProbsBuf[J] := FProbsBuf[J] / SumExp;
      // Gradients (#13): reorder to J-outer channel-vector ops. For each key J,
      // coef_j = InvTau*p_j, with j=0 folded to InvTau*(p_0-1) (the -k_0 / onehot
      // term). Both dL/dq's accumulation and the dL/dk_j row use the SAME coef:
      //   dL/dq   = sum_j coef_j * k_j   (accumulated into a zeroed row)
      //   dL/dk_j = coef_j * q           (assigned)
      errQPtr := FOutputError.GetRawPtr(baseErr0);
      FillChar(FOutputError.FData[baseErr0], EmbDim * csNeuralFloatSize, 0);
      kBase := baseOut0 + EmbDim;       // FOutput key-J slab
      errKBase := baseErr0 + EmbDim;    // FOutputError key-J slab
      for J := 0 to KM1 do
      begin
        coef := InvTau * FProbsBuf[J];
        if J = 0 then coef := InvTau * (FProbsBuf[0] - 1.0); // fold -k_0 / onehot
        TNNetVolume.MulAdd(errQPtr, FOutput.GetRawPtr(kBase), coef, EmbDim);
        Move(FOutput.FData[baseOut0], FOutputError.FData[errKBase], EmbDim * csNeuralFloatSize);
        TNNetVolume.Mul(FOutputError.GetRawPtr(errKBase), coef, EmbDim);
        Inc(kBase, EmbDim);
        Inc(errKBase, EmbDim);
      end;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetCenterLoss }

constructor TNNetCenterLoss.Create();
begin
  // Default K from FStruct[0] is 0 before InitStruct; mirror the documented
  // default of K = 2 classes and lambda = 1.0.
  Create(2, 1.0);
end;

constructor TNNetCenterLoss.Create(NumClasses: integer; Lambda: TNeuralFloat);
begin
  inherited Create();
  if NumClasses < 1 then
    FErrorProc('TNNetCenterLoss number of classes must be >= 1.');
  if Lambda <= 0 then
    FErrorProc('TNNetCenterLoss lambda must be > 0.');
  FStruct[0] := NumClasses;
  FFloatSt[0] := Lambda;
end;

procedure TNNetCenterLoss.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  K, D: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  if pPrevLayer.FOutput.Depth < 2 then
  begin
    FErrorProc('TNNetCenterLoss requires input depth >= 2 (layout x|y). ' +
      'Input depth: ' + IntToStr(pPrevLayer.FOutput.Depth));
  end;
  K := FStruct[0];
  if K < 1 then
    FErrorProc('TNNetCenterLoss number of classes must be >= 1.');
  D := pPrevLayer.FOutput.Depth - 1; // feature dimension
  // Allocate K class centers as K neurons, each holding a d-length weight
  // vector. They serialize automatically through the base neuron save/load.
  AddMissingNeurons(K);
  SetNumWeightsForAllNeurons(D, 1, 1);
  // Centers start at zero so the initial pull is simply toward the origin
  // before training drives them toward the per-class feature means.
  InitDefault();
end;

procedure TNNetCenterLoss.Backpropagate();
var
  StartTime: double;
  Lambda: TNeuralFloat;
  K, D, LabelIdx, ClassC, X, Y, MaxX, MaxY, baseOut0, baseErr0: integer;
  CenterNeuron: TNNetNeuron;
  W: TNNetVolume;
  xPtr, errPtr, wPtr, deltaPtr: TNeuralFloatArrPtr;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Lambda := FFloatSt[0];
  if Lambda <= 0 then Lambda := 1.0;
  K := FStruct[0];
  if K < 1 then K := 1;
  D := FOutput.Depth - 1;       // feature dimension (count of feature channels)
  LabelIdx := FOutput.Depth - 1; // label channel index (last channel)
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Per spatial cell: read the active class label, then pull both the feature
  // (via FOutputError) and the class center (via the neuron delta) together.
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      ClassC := Round(FOutput.FData[baseOut0 + LabelIdx]);
      // Clamp the class index into the valid center range.
      if ClassC < 0 then ClassC := 0;
      if ClassC > K - 1 then ClassC := K - 1;
      CenterNeuron := FArrNeurons[ClassC];
      W := CenterNeuron.FWeights;
      xPtr := FOutput.GetRawPtr(X, Y);
      errPtr := FOutputError.GetRawPtr(X, Y);
      wPtr := W.GetRawPtr(0, 0);
      deltaPtr := CenterNeuron.FDelta.GetRawPtr(0, 0);
      // feature gradient dL/dx = lambda*(x - c) over the D feature channels (#13):
      // err := x; err := x - c; err := lambda*(x - c).
      Move(xPtr^, errPtr^, D * csNeuralFloatSize);
      TNNetVolume.MulAdd(errPtr, wPtr, -1.0, D);
      TNNetVolume.Mul(errPtr, Lambda, D);
      // center gradient: the center is pulled toward the feature, so the optimizer
      // move (+FDelta after -FLearningRate idiom) accumulates (c - x). As two AVX
      // MulAdds (#13): delta += -LR*c + LR*x = -LR*(c - x).
      TNNetVolume.MulAdd(deltaPtr, wPtr, -FLearningRate, D);
      TNNetVolume.MulAdd(deltaPtr, xPtr, FLearningRate, D);
      // The label channel carries no gradient.
      FOutputError.FData[baseErr0 + LabelIdx] := 0;
    end;
  if (not FBatchUpdate) then
  begin
    UpdateWeights();
    AfterWeightUpdate();
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetVectorQuantizer }

constructor TNNetVectorQuantizer.Create();
begin
  // Defaults: K = 8 codebook entries, commitment cost beta = 0.25 (paper).
  Create(8, 0.25);
end;

constructor TNNetVectorQuantizer.Create(NumCodes: integer; Commitment: TNeuralFloat);
begin
  inherited Create();
  if NumCodes < 1 then
    FErrorProc('TNNetVectorQuantizer number of codes must be >= 1.');
  if Commitment <= 0 then
    FErrorProc('TNNetVectorQuantizer commitment cost must be > 0.');
  FStruct[0] := NumCodes;
  FFloatSt[0] := Commitment;
end;

procedure TNNetVectorQuantizer.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  K, D: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  K := FStruct[0];
  if K < 1 then
    FErrorProc('TNNetVectorQuantizer number of codes must be >= 1.');
  D := pPrevLayer.FOutput.Depth; // codebook vector dimension
  // Allocate K codebook vectors as K neurons, each holding a Depth-length
  // weight vector. They serialize automatically through the base neuron
  // save/load (no custom Save/Load), exactly like TNNetCenterLoss centers.
  AddMissingNeurons(K);
  SetNumWeightsForAllNeurons(D, 1, 1);
  InitDefault();
  // One cached argmin index per spatial (X,Y) position.
  SetLength(FChosenIdx, FOutput.SizeX * FOutput.SizeY);
  // One usage counter per code; allocate and zero (runtime probe, not saved).
  SetLength(FUsageCount, K);
  // Per-code ||w||^2 scratch, one slot per code (rule #17 persistent field).
  SetLength(FWSqBuf, K);
  ResetCodebookUsage();
end;

procedure TNNetVectorQuantizer.Compute();
var
  StartTime: double;
  K, KM1, D, DM1, X, Y, MaxX, MaxY, I, Code, BestCode, PosIdx: integer;
  baseOut0: integer;
  Dist, BestDist, Diff, zew, wsq: TNeuralFloat;
  W: TNNetVolume;
  zePtr, wPtr: TNeuralFloatArrPtr;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  // Identity copy first so the input z_e is available in FOutput; we then
  // overwrite each position with its nearest codebook vector z_q.
  FOutput.CopyNoChecks(FPrevLayer.FOutput);
  K := FStruct[0];
  if K < 1 then K := 1;
  KM1 := K - 1;
  D := FOutput.Depth;
  DM1 := D - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // #11: ||w||^2 for each code depends only on the (fixed-per-call) codebook,
  // not on (X,Y). Compute it once per call into the persistent FWSqBuf.
  for Code := 0 to KM1 do
  begin
    wPtr := FArrNeurons[Code].FWeights.GetRawPtr(0, 0);
    FWSqBuf[Code] := TNNetVolume.DotProduct(wPtr, wPtr, D);
  end;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      // Find the codebook entry with smallest squared-L2 distance to z_e.
      // ||z_e - w||^2 = ||z_e||^2 - 2*(z_e . w) + ||w||^2. ||z_e||^2 is a
      // positive constant shared by every code at this position, so it does not
      // change the argmin (#14: adding a shared constant preserves the ordering)
      // and is dropped entirely; rank on Dist = ||w||^2 - 2*(z_e . w). The inner
      // product z_e . w is a depth-contiguous AVX dot product (#13); ||w||^2 is
      // precomputed. Dist can be negative, so seed BestDist above any real value.
      zePtr := FPrevLayer.FOutput.GetRawPtr(X, Y);
      BestCode := 0;
      BestDist := 1e30;
      for Code := 0 to KM1 do
      begin
        W := FArrNeurons[Code].FWeights;
        wPtr := W.GetRawPtr(0, 0);
        zew := TNNetVolume.DotProduct(zePtr, wPtr, D);
        wsq := FWSqBuf[Code];
        Dist := wsq - 2 * zew;
        if Dist < BestDist then
        begin
          BestDist := Dist;
          BestCode := Code;
        end;
      end;
      PosIdx := X * FOutput.SizeY + Y;
      FChosenIdx[PosIdx] := BestCode;
      // Accumulate codebook-usage probe (pure bookkeeping: does not affect the
      // quantization math, the cached argmin, or any gradient).
      if (BestCode >= 0) and (BestCode < Length(FUsageCount)) then
        Inc(FUsageCount[BestCode]);
      // Write the chosen code z_q into the output at this position.
      W := FArrNeurons[BestCode].FWeights;
      Move(W.FData[0], FOutput.FData[baseOut0], D * csNeuralFloatSize);
    end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

procedure TNNetVectorQuantizer.Backpropagate();
var
  StartTime: double;
  Beta: TNeuralFloat;
  K, D, X, Y, MaxX, MaxY, BestCode, PosIdx: integer;
  CodeNeuron: TNNetNeuron;
  W: TNNetVolume;
  zePtr, errPtr, wPtr, deltaPtr: TNeuralFloatArrPtr;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Beta := FFloatSt[0];
  if Beta <= 0 then Beta := 0.25;
  K := FStruct[0];
  if K < 1 then K := 1;
  D := FOutput.Depth;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Per spatial cell: FOutputError already holds the gradient of z_q. We add
  // the commitment term so the FOutputError passed to the previous layer
  // (via inherited BackpropagateNoTest's Add) becomes the straight-through
  // gradient plus 2*beta*(z_e - z_q). We also pull the chosen code toward z_e.
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      PosIdx := X * FOutput.SizeY + Y;
      BestCode := FChosenIdx[PosIdx];
      if BestCode < 0 then BestCode := 0;
      if BestCode > K - 1 then BestCode := K - 1;
      CodeNeuron := FArrNeurons[BestCode];
      W := CodeNeuron.FWeights;
      zePtr := FPrevLayer.FOutput.GetRawPtr(X, Y);  // encoder output z_e
      errPtr := FOutputError.GetRawPtr(X, Y);
      wPtr := W.GetRawPtr(0, 0);                     // chosen code z_q
      deltaPtr := CodeNeuron.FDelta.GetRawPtr(0, 0);
      // Commitment gradient added to the straight-through gradient (#13):
      // dL_commit/dz_e = 2*beta*(z_e - z_q).
      TNNetVolume.MulAdd(errPtr, zePtr, 2 * Beta, D);
      TNNetVolume.MulAdd(errPtr, wPtr, -2 * Beta, D);
      // Codebook gradient: pull the code toward z_e. The optimizer move
      // (+FDelta after the -FLearningRate idiom) accumulates 2*(z_q - z_e), i.e.
      // delta += -2*LR*z_q + 2*LR*z_e (#13).
      TNNetVolume.MulAdd(deltaPtr, wPtr, -2 * FLearningRate, D);
      TNNetVolume.MulAdd(deltaPtr, zePtr, 2 * FLearningRate, D);
    end;
  if (not FBatchUpdate) then
  begin
    UpdateWeights();
    AfterWeightUpdate();
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  // Straight-through estimator: the (now commitment-augmented) FOutputError is
  // added to the previous layer's error unchanged — z_q's gradient flows to
  // z_e as identity, like TNNetBitLinear treats round/clip in backward.
  inherited BackpropagateNoTest();
end;

procedure TNNetVectorQuantizer.ResetCodebookUsage();
var
  I, UsageMaxIdx: integer;
begin
  UsageMaxIdx := Length(FUsageCount) - 1;
  for I := 0 to UsageMaxIdx do
    FUsageCount[I] := 0;
end;

function TNNetVectorQuantizer.ActiveCodeCount(): integer;
var
  I, UsageMaxIdx: integer;
begin
  Result := 0;
  UsageMaxIdx := Length(FUsageCount) - 1;
  for I := 0 to UsageMaxIdx do
    if FUsageCount[I] > 0 then Inc(Result);
end;

function TNNetVectorQuantizer.CodebookUsageCount(Index: integer): integer;
begin
  if (Index >= 0) and (Index < Length(FUsageCount)) then
    Result := FUsageCount[Index]
  else
    Result := 0;
end;

function TNNetVectorQuantizer.ChosenCodeIndex(X, Y: integer): integer;
var
  PosIdx: integer;
begin
  Result := 0;
  if (X < 0) or (X > FOutput.SizeX - 1) or (Y < 0) or (Y > FOutput.SizeY - 1) then
    Exit;
  PosIdx := X * FOutput.SizeY + Y;
  if (PosIdx >= 0) and (PosIdx < Length(FChosenIdx)) then
    Result := FChosenIdx[PosIdx];
end;

{ TNNetFiniteScalarQuant }

constructor TNNetFiniteScalarQuant.Create();
var
  DefaultLevels: array[0..3] of integer;
begin
  // Default implicit codebook 8*5*5*5 = 1000 (the FSQ paper's small config).
  DefaultLevels[0] := 8;
  DefaultLevels[1] := 5;
  DefaultLevels[2] := 5;
  DefaultLevels[3] := 5;
  Create(DefaultLevels);
end;

constructor TNNetFiniteScalarQuant.Create(const pLevels: array of integer);
var
  D, I, DM1: integer;
begin
  inherited Create();
  D := Length(pLevels);
  if D < 1 then
    FErrorProc('TNNetFiniteScalarQuant needs at least one level entry.');
  if D > csNNetMaxParameterIdx then
    FErrorProc('TNNetFiniteScalarQuant supports at most ' +
      IntToStr(csNNetMaxParameterIdx) + ' quantized channels.');
  DM1 := D - 1;
  for I := 0 to DM1 do
    if pLevels[I] < 2 then
      FErrorProc('TNNetFiniteScalarQuant level counts must be >= 2.');
  // D in FStruct[0], the L_i in FStruct[1..D] (variable-length-in-FStruct,
  // same convention as TNNetMultiQuantileLoss).
  FStruct[0] := D;
  for I := 0 to DM1 do
    FStruct[I + 1] := pLevels[I];
  BuildDerivedFromLevels();
  FTanhArg := TNNetVolume.Create();
end;

destructor TNNetFiniteScalarQuant.Destroy();
begin
  if Assigned(FTanhArg) then FTanhArg.Free;
  inherited Destroy();
end;

procedure TNNetFiniteScalarQuant.BuildDerivedFromLevels();
var
  D, I, L: integer;
  DM1: integer;
  HalfL, Off, R: TNeuralFloat;
begin
  // Rebuild FLevels + the cached bound constants (half_l, offset, shift) from
  // FStruct (called from Create and after a Save/Load reconstruction).
  D := FStruct[0];
  if D < 1 then D := 1;
  if D > csNNetMaxParameterIdx then D := csNNetMaxParameterIdx;
  SetLength(FLevels, D);
  SetLength(FHalfL, D);
  SetLength(FOffset, D);
  SetLength(FShift, D);
  DM1 := D - 1;
  for I := 0 to DM1 do
  begin
    L := FStruct[I + 1];
    if L < 2 then L := 2;
    FLevels[I] := L;
    HalfL := (L - 1) / 2;             // half_l = (L-1)/2
    FHalfL[I] := HalfL;
    if (L mod 2) = 0 then Off := 0.5 else Off := 0.0;
    FOffset[I] := Off;
    // shift = atanh(offset/half_l); atanh(x) = 0.5*ln((1+x)/(1-x)).
    if Off = 0.0 then
      FShift[I] := 0.0
    else
    begin
      R := Off / HalfL;
      FShift[I] := 0.5 * Ln((1 + R) / (1 - R));
    end;
  end;
end;

procedure TNNetFiniteScalarQuant.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  BuildDerivedFromLevels();
  if Length(FLevels) > pPrevLayer.FOutput.Depth then
    FErrorProc('TNNetFiniteScalarQuant has more quantized channels than the ' +
      'input Depth.');
  // Per-position cache of tanh(z+shift) for the quantized channels, reused by
  // Backpropagate for the analytic bound derivative.
  FTanhArg.ReSize(FOutput.SizeX, FOutput.SizeY, Length(FLevels));
end;

procedure TNNetFiniteScalarQuant.Compute();
var
  StartTime: double;
  D, DM1, X, Y, MaxX, MaxY, I, basePrev0, baseTanh0, baseOut0: integer;
  Z, T, Bounded: TNeuralFloat;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  // Identity copy first so pass-through channels (>= D) keep their values; we
  // then overwrite the first D channels with their quantized integer level.
  FOutput.CopyNoChecks(FPrevLayer.FOutput);
  D := Length(FLevels);
  DM1 := D - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      baseTanh0 := FTanhArg.GetRawPos(X, Y);
      baseOut0 := FOutput.GetRawPos(X, Y);
      for I := 0 to DM1 do
      begin
        Z := FPrevLayer.FOutput.FData[basePrev0 + I];
        T := pcr_tanhf(Z + FShift[I]);       // #16: fast tanh(z + shift)
        FTanhArg.FData[baseTanh0 + I] := T;  // cache for the backward bound deriv
        Bounded := T * FHalfL[I] - FOffset[I]; // f(z) = bound, in [-half..+half]
        // round_ste forward = round(f(z)); Round() is banker's-rounding in FPC,
        // but f(z) lands on an exact half only at measure-zero inputs.
        FOutput.FData[baseOut0 + I] := Round(Bounded);
      end;
    end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

procedure TNNetFiniteScalarQuant.Backpropagate();
var
  StartTime: double;
  D, DM1, X, Y, MaxX, MaxY, I, baseTanh0, baseErr0, idx: integer;
  T, Deriv: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  D := Length(FLevels);
  DM1 := D - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Straight-through estimator: the round is identity in backward, so the
  // gradient flowing into channel i is the output gradient times the analytic
  // derivative of the tanh bound, df/dz = half_l * (1 - tanh(z+shift)^2). The
  // pass-through channels (>= D) keep their gradient unchanged (identity).
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseTanh0 := FTanhArg.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      for I := 0 to DM1 do
      begin
        T := FTanhArg.FData[baseTanh0 + I];
        Deriv := FHalfL[I] * (1 - T * T);
        idx := baseErr0 + I; // #4 RMW
        FOutputError.FData[idx] := FOutputError.FData[idx] * Deriv;
      end;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  // Add the (STE-scaled) FOutputError into the previous layer's error.
  inherited BackpropagateNoTest();
end;

function TNNetFiniteScalarQuant.NumChannels(): integer;
begin
  Result := Length(FLevels);
end;

function TNNetFiniteScalarQuant.LevelCount(Index: integer): integer;
begin
  if (Index >= 0) and (Index < Length(FLevels)) then
    Result := FLevels[Index]
  else
    Result := 0;
end;

function TNNetFiniteScalarQuant.CodebookSize(): integer;
var
  I: integer;
  LevelsCntM1: integer;
begin
  Result := 1;
  LevelsCntM1 := Length(FLevels) - 1;
  for I := 0 to LevelsCntM1 do
    Result := Result * FLevels[I];
end;

function TNNetFiniteScalarQuant.CodeIndex(X, Y: integer): integer;
var
  D, DM1, I, Zhat, PerCh: integer;
begin
  Result := 0;
  if (X < 0) or (X > FOutput.SizeX - 1) or (Y < 0) or (Y > FOutput.SizeY - 1) then
    Exit;
  D := Length(FLevels);
  DM1 := D - 1;
  // Mixed-radix combine, channel 0 most significant. The output already holds
  // the symmetric integer level zhat; the per-channel index is zhat + L div 2
  // in 0..L-1 (the lucidrains half_width shift).
  for I := 0 to DM1 do
  begin
    Zhat := Round(FOutput[X, Y, I]);
    PerCh := Zhat + (FLevels[I] div 2);
    if PerCh < 0 then PerCh := 0;
    if PerCh > FLevels[I] - 1 then PerCh := FLevels[I] - 1;
    Result := Result * FLevels[I] + PerCh;
  end;
end;

{ TNNetLookupFreeQuant }

constructor TNNetLookupFreeQuant.Create();
begin
  // Default: 10 binary channels (implicit codebook 2^10 = 1024), inverse-
  // temperature 1.0, diversity weight 1.0 (the lucidrains defaults).
  Create(10, 1.0, 1.0);
end;

constructor TNNetLookupFreeQuant.Create(pNumChannels: integer;
  pInvTemp: TNeuralFloat; pDiversity: TNeuralFloat);
begin
  inherited Create();
  if pNumChannels < 1 then
    FErrorProc('TNNetLookupFreeQuant needs at least one quantized channel.');
  if pInvTemp <= 0 then
    FErrorProc('TNNetLookupFreeQuant inverse-temperature must be > 0.');
  FNumCh := pNumChannels;
  FInvTemp := pInvTemp;
  FDiversity := pDiversity;
  FStruct[0] := pNumChannels;
  FFloatSt[0] := pInvTemp;
  FFloatSt[1] := pDiversity;
  FPerSampleEntropy := 0;
  FCodebookEntropy := 0;
end;

procedure TNNetLookupFreeQuant.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  // Rebuild from FStruct/FFloatSt (covers a Save/Load reconstruction).
  FNumCh := FStruct[0];
  if FNumCh < 1 then FNumCh := 1;
  FInvTemp := FFloatSt[0];
  if FInvTemp <= 0 then FInvTemp := 1.0;
  FDiversity := FFloatSt[1];
  if FNumCh > pPrevLayer.FOutput.Depth then
    FErrorProc('TNNetLookupFreeQuant has more quantized channels than the ' +
      'input Depth.');
end;

procedure TNNetLookupFreeQuant.Compute();
var
  StartTime: double;
  DM1, X, Y, MaxX, MaxY, I, basePrev0, baseOut0: integer;
  Z: TNeuralFloat;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  // Identity copy first so pass-through channels (>= D) keep their values; the
  // first D channels are then overwritten with their +/-1 sign code.
  FOutput.CopyNoChecks(FPrevLayer.FOutput);
  DM1 := FNumCh - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      baseOut0 := FOutput.GetRawPos(X, Y);
      for I := 0 to DM1 do
      begin
        Z := FPrevLayer.FOutput.FData[basePrev0 + I];
        if Z > 0 then FOutput.FData[baseOut0 + I] := 1.0   // map 0 -> +1 like lucidrains
        else FOutput.FData[baseOut0 + I] := -1.0;
      end;
    end;
  ComputeEntropyTerms();
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

procedure TNNetLookupFreeQuant.ComputeEntropyTerms();
var
  DM1, X, Y, MaxX, MaxY, I, NPos, basePrev0: integer;
  Z, E, PNeg, PPos, H, Acc, FourT: TNeuralFloat;
const
  cEps = 1e-12;
begin
  // Factorized binary entropy_aux_loss (lucidrains LFQ). Per channel, per
  // spatial position the soft assignment to {-1,+1} is
  //   logits = -t*[(z+1)^2, (z-1)^2];  p = softmax(logits).
  // #14: a 2-logit softmax is a sigmoid. The logit gap collapses to
  //   d(+1) - d(-1) = -t*[(z-1)^2 - (z+1)^2] = 4*t*z,
  // so p(+1) = 1/(1 + exp(-4*t*z)) - one exp and one divide instead of a max,
  // two exps and two divides. The exponent is taken on the sign of z so its
  // argument is never positive (the role the max played) and the small
  // probability is formed as E*P, never as 1-P, keeping both tails accurate.
  FourT := 4 * FInvTemp;
  DM1 := FNumCh - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  NPos := FOutput.SizeX * FOutput.SizeY; // samples averaged per channel
  if Length(FMeanPNeg) <> FNumCh then SetLength(FMeanPNeg, FNumCh); // rule #17: lazy amortized resize
  FillChar(FMeanPNeg[0], FNumCh * csNeuralFloatSize, 0);
  Acc := 0; // sum of per-sample H(p) over all (X,Y,channel)
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      for I := 0 to DM1 do
      begin
        Z := FPrevLayer.FOutput.FData[basePrev0 + I];
        if Z >= 0 then
        begin
          E := NeuralExp(-FourT * Z);  // <= 1
          PPos := 1.0 / (1.0 + E);
          PNeg := E * PPos;
        end
        else
        begin
          E := NeuralExp(FourT * Z);   // <= 1
          PNeg := 1.0 / (1.0 + E);
          PPos := E * PNeg;
        end;
        // per-sample entropy H(p) = -sum p*ln(p)
        H := 0;
        if PNeg > cEps then H := H - PNeg * pcr_logf(PNeg); // #16 (metric only)
        if PPos > cEps then H := H - PPos * pcr_logf(PPos);
        Acc := Acc + H;
        FMeanPNeg[I] := FMeanPNeg[I] + PNeg;
      end;
    end;
  if (NPos * FNumCh) > 0 then
    FPerSampleEntropy := Acc / (NPos * FNumCh)
  else
    FPerSampleEntropy := 0;
  // Codebook (batch) entropy: H of the batch-averaged assignment, per channel.
  Acc := 0;
  for I := 0 to DM1 do
  begin
    PNeg := FMeanPNeg[I] / NPos;
    PPos := 1 - PNeg;
    H := 0;
    if PNeg > cEps then H := H - PNeg * pcr_logf(PNeg); // #16 (metric only)
    if PPos > cEps then H := H - PPos * pcr_logf(PPos);
    Acc := Acc + H;
  end;
  if FNumCh > 0 then FCodebookEntropy := Acc / FNumCh
  else FCodebookEntropy := 0;
end;

procedure TNNetLookupFreeQuant.Backpropagate();
var
  StartTime: double;
  DM1, X, Y, MaxX, MaxY, I, basePrev0, baseErr0: integer;
  Z: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  DM1 := FNumCh - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  // Straight-through estimator with the lucidrains |z| <= 1 clip: the sign is
  // identity in backward inside the band, zeroed outside. Pass-through channels
  // (>= D) keep their gradient (identity).
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      for I := 0 to DM1 do
      begin
        Z := FPrevLayer.FOutput.FData[basePrev0 + I];
        if Abs(Z) > 1.0 then FOutputError.FData[baseErr0 + I] := 0;
      end;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

function TNNetLookupFreeQuant.NumChannels(): integer;
begin
  Result := FNumCh;
end;

function TNNetLookupFreeQuant.CodebookSize(): integer;
var
  I: integer;
begin
  Result := 1;
  for I := 1 to FNumCh do Result := Result * 2; // 2^D
end;

function TNNetLookupFreeQuant.CodeIndex(X, Y: integer): integer;
var
  DM1, I: integer;
begin
  Result := 0;
  if (X < 0) or (X > FOutput.SizeX - 1) or (Y < 0) or (Y > FOutput.SizeY - 1) then
    Exit;
  DM1 := FNumCh - 1;
  // Bit-pack: channel 0 most significant, bit = 1 iff z_i > 0 (output = +1).
  for I := 0 to DM1 do
  begin
    Result := Result shl 1;
    if FOutput[X, Y, I] > 0 then Result := Result or 1;
  end;
end;

function TNNetLookupFreeQuant.PerSampleEntropy(): TNeuralFloat;
begin
  Result := FPerSampleEntropy;
end;

function TNNetLookupFreeQuant.CodebookEntropy(): TNeuralFloat;
begin
  Result := FCodebookEntropy;
end;

function TNNetLookupFreeQuant.EntropyAuxLoss(): TNeuralFloat;
begin
  Result := FPerSampleEntropy - FDiversity * FCodebookEntropy;
end;

{ TNNetArcFace }

constructor TNNetArcFace.Create();
begin
  // Defaults: K = 2 classes, margin m = 0.5 rad, scale s = 30.0 (paper).
  Create(2, 0.5, 30.0);
end;

constructor TNNetArcFace.Create(NumClasses: integer; Margin, Scale: TNeuralFloat);
begin
  inherited Create();
  if NumClasses < 1 then
    FErrorProc('TNNetArcFace number of classes must be >= 1.');
  if Margin < 0 then
    FErrorProc('TNNetArcFace margin must be >= 0.');
  if Scale <= 0 then
    FErrorProc('TNNetArcFace scale must be > 0.');
  FStruct[0] := NumClasses;
  FFloatSt[0] := Margin;
  FFloatSt[1] := Scale;
end;

procedure TNNetArcFace.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  K, D: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  if pPrevLayer.FOutput.Depth < 2 then
  begin
    FErrorProc('TNNetArcFace requires input depth >= 2 (layout x|y). ' +
      'Input depth: ' + IntToStr(pPrevLayer.FOutput.Depth));
  end;
  K := FStruct[0];
  if K < 1 then
    FErrorProc('TNNetArcFace number of classes must be >= 1.');
  D := pPrevLayer.FOutput.Depth - 1; // embedding dimension
  // Allocate K class weight vectors as K neurons, each holding a d-length
  // weight vector. They serialize automatically through the base neuron
  // save/load. InitDefault seeds small random weights so the initial class
  // directions are non-degenerate (a zero weight has an undefined direction).
  AddMissingNeurons(K);
  SetNumWeightsForAllNeurons(D, 1, 1);
  InitDefault();
  // Backward scratch: K-sized per-class arrays and a D-sized feature gradient.
  // Backprop-only: skip on inference-only layers.
  if FIsTrainable then
  begin
    SetLength(FCosArrBuf, K);
    SetLength(FANormBuf, K);
    SetLength(FProbArrBuf, K);
    SetLength(FInvWNormArrBuf, K);
    SetLength(FGradXBuf, D);
  end;
end;

procedure TNNetArcFace.FreeBackpropScratch();
begin
  SetLength(FCosArrBuf, 0);
  SetLength(FANormBuf, 0);
  SetLength(FProbArrBuf, 0);
  SetLength(FInvWNormArrBuf, 0);
  SetLength(FGradXBuf, 0);
end;

destructor TNNetArcFace.Destroy();
begin
  FreeBackpropScratch();
  inherited Destroy();
end;

function TNNetArcFace.SetTrainable(pTrainable: boolean; pLowMemory: boolean): TNNetLayer;
begin
  Result := inherited SetTrainable(pTrainable, pLowMemory);
  if not pTrainable then FreeBackpropScratch();
end;

procedure TNNetArcFace.Backpropagate();
var
  StartTime: double;
  Margin, Scale, CosM, SinM, InvXNorm: TNeuralFloat;
  XNorm, WNorm, Dot, CosT, MaxLogit, SumExp, ProbY: TNeuralFloat;
  SinTheta, CosMargined, DMarginDCos, AK, GK, InvW: TNeuralFloat;
  c1, c2, d1, d2: TNeuralFloat;
  K, KM1, D, LabelIdx, ClassC, X, Y, MaxX, MaxY, Kk, baseOut0, baseErr0: integer;
  WeightNeuron: TNNetNeuron;
  W: TNNetVolume;
  xPtr, wPtr, deltaPtr: TNeuralFloatArrPtr;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Margin := FFloatSt[0];
  if Margin < 0 then Margin := 0.5;
  Scale := FFloatSt[1];
  if Scale <= 0 then Scale := 30.0;
  K := FStruct[0];
  if K < 1 then K := 1;
  KM1 := K - 1;
  D := FOutput.Depth - 1;        // embedding dimension
  LabelIdx := FOutput.Depth - 1; // label channel index (last channel)
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  pcr_sincosf(Margin, SinM, CosM);
  // Class-weight norms depend only on the (fixed-during-pass) weights, so
  // compute them once for all spatial cells (#5) via a single dot each (#13).
  for Kk := 0 to KM1 do
  begin
    W := FArrNeurons[Kk].FWeights;
    WNorm := Sqrt(TNNetVolume.DotProduct(W.GetRawPtr(0), W.GetRawPtr(0), D));
    if WNorm < 1e-12 then WNorm := 1e-12;
    // Store the RECIPROCAL: every consumer below divides by the norm, so the
    // whole X/Y/class nest turns two divides per class into two multiplies.
    FInvWNormArrBuf[Kk] := 1.0 / WNorm;
  end;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      xPtr := FOutput.GetRawPtr(baseOut0); // #8/#11: embedding base, invariant per cell
      baseErr0 := FOutputError.GetRawPos(X, Y);
      ClassC := Round(FOutput.FData[baseOut0 + LabelIdx]);
      if ClassC < 0 then ClassC := 0;
      if ClassC > K - 1 then ClassC := K - 1;

      // Embedding L2 norm (#13: single contiguous dot).
      XNorm := Sqrt(TNNetVolume.DotProduct(xPtr, xPtr, D));
      if XNorm < 1e-12 then XNorm := 1e-12;
      InvXNorm := 1.0 / XNorm;

      // cos(theta_k) for every class and the margined logit cosines.
      for Kk := 0 to KM1 do
      begin
        W := FArrNeurons[Kk].FWeights;
        InvW := FInvWNormArrBuf[Kk];
        Dot := TNNetVolume.DotProduct(xPtr, W.GetRawPtr(0), D);
        CosT := Dot * InvXNorm * InvW;
        // Clamp for numerical safety (acos/sqrt domain).
        if CosT > 1.0 then CosT := 1.0;
        if CosT < -1.0 then CosT := -1.0;
        FCosArrBuf[Kk] := CosT;
        if Kk = ClassC then
        begin
          // cos(theta_y + m) = cos*cosM - sin*sinM
          SinTheta := 1.0 - CosT * CosT;
          if SinTheta < 0 then SinTheta := 0;
          SinTheta := Sqrt(SinTheta);
          CosMargined := CosT * CosM - SinTheta * SinM;
          FANormBuf[Kk] := CosMargined;
        end
        else
          FANormBuf[Kk] := CosT;
      end;

      // Softmax over the scaled (margined) logits.
      // #18/#19: Scale > 0, so the max over the scaled logits is the max of
      // FANormBuf scaled; the K-long copy plus scale then feeds one fused pass
      // that exponentiates and sums. The normalize below stays an exact divide
      // (#21: a gradient check watches this softmax).
      MaxLogit := TNNetVolume.MaxValue(Addr(FANormBuf[0]), K) * Scale;
      Move(FANormBuf[0], FProbArrBuf[0], K * csNeuralFloatSize);
      TNNetVolume.Mul(Addr(FProbArrBuf[0]), Scale, K);
      SumExp := TNNetVolume.ExpShiftSum(Addr(FProbArrBuf[0]),
        Addr(FProbArrBuf[0]), MaxLogit, K);
      if SumExp < 1e-30 then SumExp := 1e-30;
      ProbY := 0;
      for Kk := 0 to KM1 do
      begin
        FProbArrBuf[Kk] := FProbArrBuf[Kk] / SumExp;
        if Kk = ClassC then ProbY := FProbArrBuf[Kk];
      end;

      // Accumulate feature gradient dL/dx and weight gradients.
      FillChar(FGradXBuf[0], D * csNeuralFloatSize, 0); // #13
      for Kk := 0 to KM1 do
      begin
        // dL/dz_k = p_k - [k==y]; z_k = s * cos-term.
        GK := FProbArrBuf[Kk];
        if Kk = ClassC then GK := GK - 1.0;
        // a_k = dL/d(cos(theta_k)) folding in the margin chain for the true
        // class. For k=y: d(cos(theta'_y))/d(cos(theta_y)) =
        //   cosM + sinM * cos / sqrt(1 - cos^2).
        CosT := FCosArrBuf[Kk];
        if Kk = ClassC then
        begin
          SinTheta := 1.0 - CosT * CosT;
          if SinTheta < 1e-12 then SinTheta := 1e-12;
          DMarginDCos := CosM + SinM * CosT / Sqrt(SinTheta);
          AK := Scale * GK * DMarginDCos;
        end
        else
          AK := Scale * GK;

        WeightNeuron := FArrNeurons[Kk];
        W := WeightNeuron.FWeights;
        InvW := FInvWNormArrBuf[Kk];
        wPtr := W.GetRawPtr(0);
        deltaPtr := WeightNeuron.FDelta.GetRawPtr(0);
        // d(cos)/dx   = (W_hat - cos * x_hat) / ||x||
        // d(cos)/dW_k = (x_hat - cos * W_k_hat) / ||W_k||
        // #13: distribute the per-element formula into two uniform axpy calls.
        // dL/dx += AK*InvXNorm*(W*InvW - cos*x*InvXNorm)
        //        = (AK*InvW*InvXNorm)*W + (-AK*cos*InvXNorm^2)*x
        c1 := AK * InvW * InvXNorm;
        c2 := -AK * CosT * InvXNorm * InvXNorm;
        TNNetVolume.MulAdd(@FGradXBuf[0], wPtr, c1, D);
        TNNetVolume.MulAdd(@FGradXBuf[0], xPtr, c2, D);
        // delta += (-LR)*AK*InvW*(x*InvXNorm - cos*W*InvW)
        //        = (-LR*AK*InvW*InvXNorm)*x + (LR*AK*cos*InvW^2)*W
        d1 := (-FLearningRate) * AK * InvW * InvXNorm;
        d2 := FLearningRate * AK * CosT * InvW * InvW;
        TNNetVolume.MulAdd(deltaPtr, xPtr, d1, D);
        TNNetVolume.MulAdd(deltaPtr, wPtr, d2, D);
      end;

      Move(FGradXBuf[0], FOutputError.FData[baseErr0], D * csNeuralFloatSize); // #13
      // The label channel carries no gradient.
      FOutputError.FData[baseErr0 + LabelIdx] := 0;
    end;
  if (not FBatchUpdate) then
  begin
    UpdateWeights();
    AfterWeightUpdate();
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetMixtureDensity }

constructor TNNetMixtureDensity.Create();
begin
  // Default: K = 2 mixture components over a D = 1 dimensional target.
  Create(2, 1);
end;

constructor TNNetMixtureDensity.Create(NumComponents, TargetDim: integer);
begin
  inherited Create();
  if NumComponents < 1 then
    FErrorProc('TNNetMixtureDensity number of components must be >= 1.');
  if TargetDim < 1 then
    FErrorProc('TNNetMixtureDensity target dimension must be >= 1.');
  FStruct[0] := NumComponents;
  FStruct[1] := TargetDim;
end;

procedure TNNetMixtureDensity.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  Kcomp, Dim, Expected: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  Kcomp := FStruct[0];
  Dim := FStruct[1];
  if Kcomp < 1 then
    FErrorProc('TNNetMixtureDensity number of components must be >= 1.');
  if Dim < 1 then
    FErrorProc('TNNetMixtureDensity target dimension must be >= 1.');
  Expected := Kcomp * (1 + 2 * Dim);
  if pPrevLayer.FOutput.Depth <> Expected then
    FErrorProc('TNNetMixtureDensity requires input depth = K*(1+2*D) = ' +
      IntToStr(Expected) + ' (K=' + IntToStr(Kcomp) + ', D=' + IntToStr(Dim) +
      '), got ' + IntToStr(pPrevLayer.FOutput.Depth) + '.');
  // Backward scratch: D-sized target and K-sized per-component arrays.
  SetLength(FYtBuf, Dim);
  SetLength(FLogCompBuf, Kcomp);
  SetLength(FGammaArrBuf, Kcomp);
  SetLength(FPiArrBuf, Kcomp);
end;

destructor TNNetMixtureDensity.Destroy();
begin
  SetLength(FYtBuf, 0);
  SetLength(FLogCompBuf, 0);
  SetLength(FGammaArrBuf, 0);
  SetLength(FPiArrBuf, 0);
  inherited Destroy();
end;

function TNNetMixtureDensity.ComponentCount(): integer;
begin
  Result := FStruct[0];
end;

function TNNetMixtureDensity.TargetDimension(): integer;
begin
  Result := FStruct[1];
end;

procedure TNNetMixtureDensity.Compute();
var
  StartTime: double;
  Kcomp, Dim, KcompM1, KDM1, X, Y, kk, dd, MaxX, MaxY, BaseS, baseOut0: integer;
  idx, baseS0: integer;
  MaxLogit, SumExp, Ex, RawS: TNeuralFloat;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  // Start from the raw parameter vector (identity passthrough), then transform
  // the mixing logits (softmax) and raw scales (softplus) in place.
  FOutput.CopyNoChecks(FPrevLayer.FOutput);
  Kcomp := FStruct[0];
  Dim := FStruct[1];
  KcompM1 := Kcomp - 1;
  KDM1 := Kcomp * Dim - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  BaseS := Kcomp + Kcomp * Dim; // start of the K*D raw-scale block
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      // Mixing weights: numerically-stable softmax over the first K channels.
      MaxLogit := FOutput.FData[baseOut0 + 0];
      for kk := 1 to KcompM1 do
      begin
        idx := baseOut0 + kk;
        if FOutput.FData[idx] > MaxLogit then MaxLogit := FOutput.FData[idx];
      end;
      SumExp := 0;
      for kk := 0 to KcompM1 do
      begin
        idx := baseOut0 + kk;
        Ex := NeuralExp(FOutput.FData[idx] - MaxLogit);
        FOutput.FData[idx] := Ex;
        SumExp := SumExp + Ex;
      end;
      if SumExp <= 0 then SumExp := 1e-30;
      for kk := 0 to KcompM1 do
      begin
        idx := baseOut0 + kk;
        FOutput.FData[idx] := FOutput.FData[idx] / SumExp;
      end;
      // Means (channels K .. K+K*D-1) are left untransformed.
      // Scales: softplus over the last K*D channels -> strictly positive sigma.
      baseS0 := baseOut0 + BaseS; // #11: raw-scale block base, per (X,Y)
      for dd := 0 to KDM1 do
      begin
        idx := baseS0 + dd;
        RawS := FOutput.FData[idx];
        // softplus(s) = ln(1+exp(s)); guard the exp for large s (== s there).
        if RawS > 30 then
          FOutput.FData[idx] := RawS
        else
          FOutput.FData[idx] := pcr_logf(1 + NeuralExp(RawS));
      end;
    end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

function TNNetMixtureDensity.MixtureNLL(const yTarget: array of TNeuralFloat;
  X: integer = 0; Y: integer = 0): TNeuralFloat;
var
  Kcomp, Dim, KcompM1, DimM1, kk, dd, BaseMu, BaseS, baseOut0, muBase, sBase: integer;
  LogPi, Sigma, Mu, Diff, MaxB, SumExp: TNeuralFloat;
const
  cLog2Pi = 1.8378770664093453; // ln(2*pi)
  cSigEps = 1e-6;
begin
  Kcomp := FStruct[0];
  Dim := FStruct[1];
  KcompM1 := Kcomp - 1;
  DimM1 := Dim - 1;
  BaseMu := Kcomp;
  BaseS := Kcomp + Kcomp * Dim;
  // FLogCompBuf is the persistent per-instance scratch sized in SetPrevLayer;
  // it is dead between calls, so this helper reuses it instead of allocating.
  baseOut0 := FOutput.GetRawPos(X, Y);
  MaxB := -1e30;
  for kk := 0 to KcompM1 do
  begin
    LogPi := pcr_logf(FOutput.FData[baseOut0 + kk] + 1e-30);
    FLogCompBuf[kk] := LogPi;
    muBase := baseOut0 + BaseMu + kk * Dim;
    sBase := baseOut0 + BaseS + kk * Dim;
    for dd := 0 to DimM1 do
    begin
      Mu := FOutput.FData[muBase + dd];
      Sigma := FOutput.FData[sBase + dd];
      if Sigma < cSigEps then Sigma := cSigEps;
      Diff := yTarget[dd] - Mu;
      FLogCompBuf[kk] := FLogCompBuf[kk] -
        (0.5 * cLog2Pi + pcr_logf(Sigma) + (Diff * Diff) / (2 * Sigma * Sigma));
    end;
    if FLogCompBuf[kk] > MaxB then MaxB := FLogCompBuf[kk];
  end;
  SumExp := 0;
  for kk := 0 to KcompM1 do
    SumExp := SumExp + NeuralExp(FLogCompBuf[kk] - MaxB);
  Result := -(MaxB + pcr_logf(SumExp));
end;

procedure TNNetMixtureDensity.SampleMixture(var Sample: array of TNeuralFloat;
  X: integer = 0; Y: integer = 0);
var
  Kcomp, Dim, KcompM1, DimM1, kk, dd, Chosen, BaseMu, BaseS: integer;
  R, Acc, Mu, Sigma: TNeuralFloat;
begin
  Kcomp := FStruct[0];
  Dim := FStruct[1];
  KcompM1 := Kcomp - 1;
  DimM1 := Dim - 1;
  BaseMu := Kcomp;
  BaseS := Kcomp + Kcomp * Dim;
  // Pick a component by its (transformed) mixing weights.
  R := Random;
  Acc := 0;
  Chosen := Kcomp - 1;
  for kk := 0 to KcompM1 do
  begin
    Acc := Acc + FOutput[X, Y, kk];
    if R <= Acc then
    begin
      Chosen := kk;
      break;
    end;
  end;
  // Sample the chosen diagonal Gaussian.
  for dd := 0 to DimM1 do
  begin
    if dd > High(Sample) then break;
    Mu := FOutput[X, Y, BaseMu + Chosen * Dim + dd];
    Sigma := FOutput[X, Y, BaseS + Chosen * Dim + dd];
    Sample[dd] := Mu + Sigma * FOutput.RandomGaussianValue();
  end;
end;

procedure TNNetMixtureDensity.Backpropagate();
var
  StartTime: double;
  Kcomp, Dim, KcompM1, DimM1, X, Y, kk, dd, MaxX, MaxY, BaseMu, BaseS: integer;
  baseOut0, baseErr0, basePrev0, muBase, sBase, muErrBase, sErrBase, sPrevBase: integer;
  kkDim: integer;
  LogPi, Sigma, Mu, Diff, MaxB, SumExp, RawS, SigmoidS: TNeuralFloat;
  Gamma, Pi_k, InvS2, GMu, GSigma: TNeuralFloat;
const
  cLog2Pi = 1.8378770664093453; // ln(2*pi)
  cSigEps = 1e-6;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Kcomp := FStruct[0];
  Dim := FStruct[1];
  KcompM1 := Kcomp - 1;
  DimM1 := Dim - 1;
  BaseMu := Kcomp;
  BaseS := Kcomp + Kcomp * Dim;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      // Recover the D-dim regression target from the first D channels:
      // framework seeded FOutputError := output - target.
      Move(FOutput.FData[baseOut0], FYtBuf[0], Dim * csNeuralFloatSize);
      TNNetVolume.MulAdd(@FYtBuf[0], @FOutputError.FData[baseErr0], -1.0, Dim);
      // Log-responsibilities (stable log-sum-exp over components).
      MaxB := -1e30;
      for kk := 0 to KcompM1 do
      begin
        Pi_k := FOutput.FData[baseOut0 + kk];
        FPiArrBuf[kk] := Pi_k;
        LogPi := pcr_logf(Pi_k + 1e-30);
        FLogCompBuf[kk] := LogPi;
        kkDim := kk * Dim;
        muBase := baseOut0 + BaseMu + kkDim;
        sBase := baseOut0 + BaseS + kkDim;
        for dd := 0 to DimM1 do
        begin
          Mu := FOutput.FData[muBase + dd];
          Sigma := FOutput.FData[sBase + dd];
          if Sigma < cSigEps then Sigma := cSigEps;
          Diff := FYtBuf[dd] - Mu;
          FLogCompBuf[kk] := FLogCompBuf[kk] -
            (0.5 * cLog2Pi + pcr_logf(Sigma) + (Diff * Diff) / (2 * Sigma * Sigma));
        end;
        if FLogCompBuf[kk] > MaxB then MaxB := FLogCompBuf[kk];
      end;
      SumExp := 0;
      for kk := 0 to KcompM1 do
      begin
        FGammaArrBuf[kk] := NeuralExp(FLogCompBuf[kk] - MaxB);
        SumExp := SumExp + FGammaArrBuf[kk];
      end;
      if SumExp <= 0 then SumExp := 1e-30;
      for kk := 0 to KcompM1 do
        FGammaArrBuf[kk] := FGammaArrBuf[kk] / SumExp;
      // Write the exact dNLL/d(raw param) into FOutputError.
      for kk := 0 to KcompM1 do
      begin
        Gamma := FGammaArrBuf[kk];
        Pi_k := FPiArrBuf[kk];
        // Mixing logit: dNLL/da_k = pi_k - gamma_k.
        FOutputError.FData[baseErr0 + kk] := Pi_k - Gamma;
        kkDim := kk * Dim;
        muBase := baseOut0 + BaseMu + kkDim;
        sBase := baseOut0 + BaseS + kkDim;
        muErrBase := baseErr0 + BaseMu + kkDim;
        sErrBase := baseErr0 + BaseS + kkDim;
        sPrevBase := basePrev0 + BaseS + kkDim;
        for dd := 0 to DimM1 do
        begin
          Mu := FOutput.FData[muBase + dd];
          Sigma := FOutput.FData[sBase + dd];
          if Sigma < cSigEps then Sigma := cSigEps;
          Diff := FYtBuf[dd] - Mu;
          InvS2 := 1 / (Sigma * Sigma);
          // Mean: dNLL/dmu = gamma * (mu - y) / sigma^2.
          GMu := Gamma * (Mu - FYtBuf[dd]) * InvS2;
          FOutputError.FData[muErrBase + dd] := GMu;
          // Scale: dNLL/dsigma = gamma*(1/sigma - diff^2/sigma^3); then chain
          // softplus' = sigmoid(rawS), rawS recovered as sigmoid via sigma.
          GSigma := Gamma * (1 / Sigma - (Diff * Diff) * InvS2 / Sigma);
          // softplus: sigma = ln(1+exp(rawS)) => exp(rawS) = exp(sigma)-1,
          // sigmoid(rawS) = (exp(sigma)-1)/exp(sigma) = 1 - exp(-sigma).
          // SigmoidS := 1 - Exp(-Sigma);
          // (equivalently recompute from the raw input for large-s safety)
          RawS := FPrevLayer.FOutput.FData[sPrevBase + dd];
          if RawS > 30 then SigmoidS := 1
          else SigmoidS := 1 / (1 + NeuralExp(-RawS));
          FOutputError.FData[sErrBase + dd] := GSigma * SigmoidS;
        end;
      end;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetEvidentialRegression }

constructor TNNetEvidentialRegression.Create();
begin
  // Default: D = 1 scalar target, lambda = 0.01.
  Create(1, 0.01);
end;

constructor TNNetEvidentialRegression.Create(TargetDim: integer;
  pLambda: TNeuralFloat = 0.01);
begin
  inherited Create();
  if TargetDim < 1 then
    FErrorProc('TNNetEvidentialRegression target dimension must be >= 1.');
  if pLambda < 0 then
    FErrorProc('TNNetEvidentialRegression lambda must be >= 0.');
  FStruct[0] := TargetDim;
  FFloatSt[0] := pLambda;
end;

procedure TNNetEvidentialRegression.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  Dim, Expected: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  Dim := FStruct[0];
  if Dim < 1 then
    FErrorProc('TNNetEvidentialRegression target dimension must be >= 1.');
  Expected := 4 * Dim;
  if pPrevLayer.FOutput.Depth <> Expected then
    FErrorProc('TNNetEvidentialRegression requires input depth = 4*D = ' +
      IntToStr(Expected) + ' (D=' + IntToStr(Dim) + '), got ' +
      IntToStr(pPrevLayer.FOutput.Depth) + '.');
end;

function TNNetEvidentialRegression.TargetDimension(): integer;
begin
  Result := FStruct[0];
end;

function TNNetEvidentialRegression.Lambda(): TNeuralFloat;
begin
  Result := FFloatSt[0];
end;

// Lanczos approximation to ln(Gamma(x)) for x > 0 (g=7, 9 coefficients);
// accurate to ~1e-13 on the well-conditioned x>=1 range the head uses.
function TNNetEvidentialRegression.LnGammaF(x: TNeuralFloat): TNeuralFloat;
const
  cG: array[0..8] of Double = (
    0.99999999999980993, 676.5203681218851, -1259.1392167224028,
    771.32342877765313, -176.61502916214059, 12.507343278686905,
    -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7);
  cSqrt2Pi = 2.5066282746310002; // sqrt(2*pi)
var
  xd, t, a: Double;
  i: integer;
begin
  xd := x;
  if xd < 0.5 then
    // Reflection (not used by the head's bounded params, kept for safety).
    Result := Ln(Pi / Sin(Pi * xd)) - LnGammaF(1 - x)
  else
  begin
    xd := xd - 1;
    a := cG[0];
    t := xd + 7.5;
    for i := 1 to 8 do
      a := a + cG[i] / (xd + i);
    // ln( sqrt(2*pi) * a * t^(xd+0.5) * e^-t )
    Result := Ln(cSqrt2Pi * a) + (xd + 0.5) * Ln(t) - t;
  end;
end;

// digamma(x) = d/dx ln(Gamma(x)), x > 0, via recurrence up to x>=6 then the
// asymptotic series. Well conditioned for the head's alpha (>1) range.
function TNNetEvidentialRegression.DigammaF(x: TNeuralFloat): TNeuralFloat;
var
  xd, r, f: Double;
begin
  xd := x;
  r := 0;
  while xd < 6 do
  begin
    r := r - 1 / xd;
    xd := xd + 1;
  end;
  f := 1 / (xd * xd);
  r := r + Ln(xd) + 1 / (2 * xd)
    - f * (1.0/12.0 - f * (1.0/120.0 - f * (1.0/252.0)));
  Result := r;
end;

procedure TNNetEvidentialRegression.Compute();
var
  StartTime: double;
  Dim, DimM1, X, Y, dd, MaxX, MaxY, B, baseOut0: integer;
  idx1, idx2, idx3: integer;
  RawNu, RawAl, RawBe: TNeuralFloat;

  function SoftPlus(s: TNeuralFloat): TNeuralFloat;
  begin
    if s > 30 then Result := s
    else Result := pcr_logf(1 + NeuralExp(s));
  end;

begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  // Identity passthrough, then transform nu/alpha/beta channels in place;
  // gamma channel is left linear.
  FOutput.CopyNoChecks(FPrevLayer.FOutput);
  Dim := FStruct[0];
  DimM1 := Dim - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      for dd := 0 to DimM1 do
      begin
        B := 4 * dd;
        // gamma = FOutput[B] left as-is.
        idx1 := baseOut0 + B + 1;
        idx2 := idx1 + 1;
        idx3 := idx2 + 1;
        RawNu := FOutput.FData[idx1];
        RawAl := FOutput.FData[idx2];
        RawBe := FOutput.FData[idx3];
        FOutput.FData[idx1] := SoftPlus(RawNu);
        FOutput.FData[idx2] := 1 + SoftPlus(RawAl);
        FOutput.FData[idx3] := SoftPlus(RawBe);
      end;
    end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

function TNNetEvidentialRegression.EvidentialLoss(
  const yTarget: array of TNeuralFloat; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
var
  Dim, DimM1, dd, B: integer;
  Gam, Nu, Al, Be, Delta, Omega, S, Lam, Total: TNeuralFloat;
const
  cMinNu = 1e-6;
  cMinBe = 1e-6;
begin
  Dim := FStruct[0];
  DimM1 := Dim - 1;
  Lam := FFloatSt[0];
  Total := 0;
  for dd := 0 to DimM1 do
  begin
    if dd > High(yTarget) then break;
    B := 4 * dd;
    Gam := FOutput[X, Y, B];
    Nu  := FOutput[X, Y, B + 1]; if Nu < cMinNu then Nu := cMinNu;
    Al  := FOutput[X, Y, B + 2];
    Be  := FOutput[X, Y, B + 3]; if Be < cMinBe then Be := cMinBe;
    Delta := yTarget[dd] - Gam;
    Omega := 2 * Be * (1 + Nu);
    S := Delta * Delta * Nu + Omega;
    Total := Total
      + 0.5 * pcr_logf(Pi / Nu)
      - Al * pcr_logf(Omega)
      + (Al + 0.5) * pcr_logf(S)
      + LnGammaF(Al) - LnGammaF(Al + 0.5)
      + Lam * Abs(Delta) * (2 * Nu + Al);
  end;
  Result := Total;
end;

function TNNetEvidentialRegression.Prediction(d: integer = 0; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
begin
  Result := FOutput[X, Y, 4 * d];
end;

function TNNetEvidentialRegression.AleatoricVar(d: integer = 0; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
var
  Al, Be: TNeuralFloat;
begin
  Be := FOutput[X, Y, 4 * d + 3];
  Al := FOutput[X, Y, 4 * d + 2];
  if Al <= 1 + 1e-6 then Al := 1 + 1e-6;
  Result := Be / (Al - 1);
end;

function TNNetEvidentialRegression.EpistemicVar(d: integer = 0; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
var
  Al, Be, Nu: TNeuralFloat;
begin
  Be := FOutput[X, Y, 4 * d + 3];
  Al := FOutput[X, Y, 4 * d + 2];
  Nu := FOutput[X, Y, 4 * d + 1];
  if Al <= 1 + 1e-6 then Al := 1 + 1e-6;
  if Nu < 1e-6 then Nu := 1e-6;
  Result := Be / (Nu * (Al - 1));
end;

procedure TNNetEvidentialRegression.Backpropagate();
var
  StartTime: double;
  Dim, DimM1, X, Y, dd, MaxX, MaxY, B, baseOut0, baseErr0, basePrev0: integer;
  Yd, Gam, Nu, Al, Be, Delta, Omega, S, Lam, SgnD, AbsD: TNeuralFloat;
  dGam, dNu, dAl, dBe: TNeuralFloat;
  RawNu, RawAl, RawBe, SigNu, SigAl, SigBe: TNeuralFloat;
const
  cMinNu = 1e-6;
  cMinBe = 1e-6;

  function SigmoidOf(s: TNeuralFloat): TNeuralFloat;
  begin
    if s > 30 then Result := 1
    else if s < -30 then Result := 0
    else Result := 1 / (1 + NeuralExp(-s));
  end;

begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Dim := FStruct[0];
  DimM1 := Dim - 1;
  Lam := FFloatSt[0];
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      for dd := 0 to DimM1 do
      begin
        B := 4 * dd;
        // Recover the scalar target from the gamma channel: framework seeded
        // FOutputError := output - target, and gamma is an identity passthrough.
        Gam := FOutput.FData[baseOut0 + B];
        Yd := Gam - FOutputError.FData[baseErr0 + B];
        Nu  := FOutput.FData[baseOut0 + B + 1]; if Nu < cMinNu then Nu := cMinNu;
        Al  := FOutput.FData[baseOut0 + B + 2];
        Be  := FOutput.FData[baseOut0 + B + 3]; if Be < cMinBe then Be := cMinBe;
        Delta := Yd - Gam;
        AbsD := Abs(Delta);
        if Delta > 0 then SgnD := 1
        else if Delta < 0 then SgnD := -1
        else SgnD := 0;
        Omega := 2 * Be * (1 + Nu);
        S := Delta * Delta * Nu + Omega;

        // dL/dgamma (gamma is linear -> no softplus chain).
        dGam := -2 * Nu * (Al + 0.5) * Delta / S
                - Lam * SgnD * (2 * Nu + Al);
        // dL/dnu (before softplus chain).
        dNu := -0.5 / Nu
               - Al * (2 * Be) / Omega
               + (Al + 0.5) * (Delta * Delta + 2 * Be) / S
               + 2 * Lam * AbsD;
        // dL/dalpha (before softplus chain).
        dAl := -pcr_logf(Omega) + pcr_logf(S)
               + DigammaF(Al) - DigammaF(Al + 0.5)
               + Lam * AbsD;
        // dL/dbeta (before softplus chain).
        dBe := -Al * 2 * (1 + Nu) / Omega
               + (Al + 0.5) * 2 * (1 + Nu) / S;

        // softplus chain (softplus' = sigmoid(raw)); alpha = 1+softplus, so the
        // chain factor is identical to nu/beta. Recover raws from prev layer.
        RawNu := FPrevLayer.FOutput.FData[basePrev0 + B + 1];
        RawAl := FPrevLayer.FOutput.FData[basePrev0 + B + 2];
        RawBe := FPrevLayer.FOutput.FData[basePrev0 + B + 3];
        SigNu := SigmoidOf(RawNu);
        SigAl := SigmoidOf(RawAl);
        SigBe := SigmoidOf(RawBe);

        FOutputError.FData[baseErr0 + B]     := dGam;
        FOutputError.FData[baseErr0 + B + 1] := dNu * SigNu;
        FOutputError.FData[baseErr0 + B + 2] := dAl * SigAl;
        FOutputError.FData[baseErr0 + B + 3] := dBe * SigBe;
      end;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetEvidentialClassification }

constructor TNNetEvidentialClassification.Create();
begin
  // Default: K = 2 classes, lambda = 1.0.
  Create(2, 1.0);
end;

constructor TNNetEvidentialClassification.Create(NumClasses: integer;
  pLambda: TNeuralFloat = 1.0);
begin
  inherited Create();
  if NumClasses < 2 then
    FErrorProc('TNNetEvidentialClassification requires NumClasses >= 2.');
  if pLambda < 0 then
    FErrorProc('TNNetEvidentialClassification lambda must be >= 0.');
  FStruct[0] := NumClasses;
  FFloatSt[0] := pLambda;
end;

procedure TNNetEvidentialClassification.SetPrevLayer(pPrevLayer: TNNetLayer);
var
  Kc: integer;
begin
  inherited SetPrevLayer(pPrevLayer);
  Kc := FStruct[0];
  if Kc < 2 then
    FErrorProc('TNNetEvidentialClassification requires NumClasses >= 2.');
  if pPrevLayer.FOutput.Depth <> Kc then
    FErrorProc('TNNetEvidentialClassification requires input depth = NumClasses = ' +
      IntToStr(Kc) + ', got ' + IntToStr(pPrevLayer.FOutput.Depth) + '.');
end;

function TNNetEvidentialClassification.NumClasses(): integer;
begin
  Result := FStruct[0];
end;

function TNNetEvidentialClassification.Lambda(): TNeuralFloat;
begin
  Result := FFloatSt[0];
end;

// Lanczos approximation to ln(Gamma(x)) for x > 0 (g=7, 9 coefficients).
function TNNetEvidentialClassification.LnGammaF(x: TNeuralFloat): TNeuralFloat;
const
  cG: array[0..8] of Double = (
    0.99999999999980993, 676.5203681218851, -1259.1392167224028,
    771.32342877765313, -176.61502916214059, 12.507343278686905,
    -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7);
  cSqrt2Pi = 2.5066282746310002; // sqrt(2*pi)
var
  xd, t, a: Double;
  i: integer;
begin
  xd := x;
  if xd < 0.5 then
    Result := Ln(Pi / Sin(Pi * xd)) - LnGammaF(1 - x)
  else
  begin
    xd := xd - 1;
    a := cG[0];
    t := xd + 7.5;
    for i := 1 to 8 do
      a := a + cG[i] / (xd + i);
    Result := Ln(cSqrt2Pi * a) + (xd + 0.5) * Ln(t) - t;
  end;
end;

// digamma(x) = d/dx ln(Gamma(x)), x > 0, via recurrence up to x>=6 then the
// asymptotic series.
function TNNetEvidentialClassification.DigammaF(x: TNeuralFloat): TNeuralFloat;
var
  xd, r, f: Double;
begin
  xd := x;
  r := 0;
  while xd < 6 do
  begin
    r := r - 1 / xd;
    xd := xd + 1;
  end;
  f := 1 / (xd * xd);
  r := r + Ln(xd) + 1 / (2 * xd)
    - f * (1.0/12.0 - f * (1.0/120.0 - f * (1.0/252.0)));
  Result := r;
end;

// trigamma(x) = d/dx digamma(x) = psi'(x), x > 0, via the same recurrence
// (psi'(x) = psi'(x+1) + 1/x^2) up to x>=6 then the asymptotic series.
function TNNetEvidentialClassification.TrigammaF(x: TNeuralFloat): TNeuralFloat;
var
  xd, r, f: Double;
begin
  xd := x;
  r := 0;
  while xd < 6 do
  begin
    r := r + 1 / (xd * xd);
    xd := xd + 1;
  end;
  f := 1 / (xd * xd);
  // 1/x + 1/(2x^2) + 1/(6x^3) - 1/(30x^5) + ...  =  (1/x)*(1 + 1/(2x) + ...).
  r := r + (1 / xd) * (1 + (1 / (2 * xd))
    + f * (1.0/6.0 - f * (1.0/30.0 - f * (1.0/42.0))));
  Result := r;
end;

procedure TNNetEvidentialClassification.Compute();
var
  StartTime: double;
  Kc, KcM1, X, Y, c, MaxX, MaxY, baseOut0: integer;

  function SoftPlus(s: TNeuralFloat): TNeuralFloat;
  begin
    if s > 30 then Result := s
    else Result := pcr_logf(1 + NeuralExp(s));
  end;

begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  // Identity passthrough, then map each raw channel to alpha = 1 + softplus.
  FOutput.CopyNoChecks(FPrevLayer.FOutput);
  Kc := FStruct[0];
  KcM1 := Kc - 1;
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      for c := 0 to KcM1 do
        FOutput.FData[baseOut0 + c] := 1 + SoftPlus(FOutput.FData[baseOut0 + c]);
    end;
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

function TNNetEvidentialClassification.EvidentialLoss(
  const yTarget: array of TNeuralFloat; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
var
  Kc, KcM1, c: integer;
  Al, Sstr, Pk, Yk, Lam, Err, Kl, AlTil, StilDe, SumAlTilM1: TNeuralFloat;
begin
  Kc := FStruct[0];
  KcM1 := Kc - 1;
  Lam := FFloatSt[0];
  // Strength S.
  Sstr := 0;
  for c := 0 to KcM1 do
    Sstr := Sstr + FOutput[X, Y, c];
  // Bayes-risk expected MSE.
  Err := 0;
  for c := 0 to KcM1 do
  begin
    Al := FOutput[X, Y, c];
    Pk := Al / Sstr;
    if c > High(yTarget) then Yk := 0 else Yk := yTarget[c];
    Err := Err + (Yk - Pk) * (Yk - Pk) + Pk * (1 - Pk) / (Sstr + 1);
  end;
  // KL[ Dir(alphaTilde) || Dir(1) ], alphaTilde_k = y_k + (1-y_k)*alpha_k.
  StilDe := 0;
  SumAlTilM1 := 0;
  for c := 0 to KcM1 do
  begin
    if c > High(yTarget) then Yk := 0 else Yk := yTarget[c];
    AlTil := Yk + (1 - Yk) * FOutput[X, Y, c];
    StilDe := StilDe + AlTil;
    SumAlTilM1 := SumAlTilM1 + (AlTil - 1);
  end;
  Kl := LnGammaF(StilDe) - LnGammaF(Kc);
  for c := 0 to KcM1 do
  begin
    if c > High(yTarget) then Yk := 0 else Yk := yTarget[c];
    AlTil := Yk + (1 - Yk) * FOutput[X, Y, c];
    Kl := Kl - LnGammaF(AlTil)
        + (AlTil - 1) * (DigammaF(AlTil) - DigammaF(StilDe));
  end;
  Result := Err + Lam * Kl;
end;

function TNNetEvidentialClassification.Alpha(c: integer = 0; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
begin
  Result := FOutput[X, Y, c];
end;

function TNNetEvidentialClassification.Prediction(c: integer = 0; X: integer = 0;
  Y: integer = 0): TNeuralFloat;
var
  Kc, KcM1, j: integer;
  Sstr: TNeuralFloat;
begin
  Kc := FStruct[0];
  KcM1 := Kc - 1;
  Sstr := 0;
  for j := 0 to KcM1 do
    Sstr := Sstr + FOutput[X, Y, j];
  Result := FOutput[X, Y, c] / Sstr;
end;

function TNNetEvidentialClassification.Uncertainty(X: integer = 0;
  Y: integer = 0): TNeuralFloat;
var
  Kc, KcM1, j: integer;
  Sstr: TNeuralFloat;
begin
  Kc := FStruct[0];
  KcM1 := Kc - 1;
  Sstr := 0;
  for j := 0 to KcM1 do
    Sstr := Sstr + FOutput[X, Y, j];
  Result := Kc / Sstr;
end;

procedure TNNetEvidentialClassification.Backpropagate();
var
  StartTime: double;
  Kc, KcM1, X, Y, c, MaxX, MaxY, baseOut0, baseErr0, basePrev0: integer;
  Sstr, Lam, Qsum, PkMinusYkPk, Yj, Aj, Pj: TNeuralFloat;
  dErr, dKL, dB, SumAlTilM1, StilDe, AlTilj, Raw, Sig: TNeuralFloat;
  TrigStilDe, TwoOverS, SP1, OneMinusQ, InvSP1Sq: TNeuralFloat;
  idxE: integer;

  function SigmoidOf(s: TNeuralFloat): TNeuralFloat;
  begin
    if s > 30 then Result := 1
    else if s < -30 then Result := 0
    else Result := 1 / (1 + NeuralExp(-s));
  end;

begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Kc := FStruct[0];
  KcM1 := Kc - 1;
  Lam := FFloatSt[0];
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  for X := 0 to MaxX do
    for Y := 0 to MaxY do
    begin
      baseOut0 := FOutput.GetRawPos(X, Y);
      baseErr0 := FOutputError.GetRawPos(X, Y);
      basePrev0 := FPrevLayer.FOutput.GetRawPos(X, Y);
      // Strength S and helper sums shared across the K channels.
      Sstr := 0;
      for c := 0 to KcM1 do
        Sstr := Sstr + FOutput.FData[baseOut0 + c];
      // Q = sum_k p_k^2 ; PkMinusYkPk = sum_k (p_k - y_k)*p_k. The one-hot
      // label is recovered from y_k = alpha_k - FOutputError[k].
      Qsum := 0;
      PkMinusYkPk := 0;
      StilDe := 0;
      SumAlTilM1 := 0;
      for c := 0 to KcM1 do
      begin
        Aj := FOutput.FData[baseOut0 + c];
        Pj := Aj / Sstr;
        Yj := Aj - FOutputError.FData[baseErr0 + c];
        Qsum := Qsum + Pj * Pj;
        PkMinusYkPk := PkMinusYkPk + (Pj - Yj) * Pj;
        AlTilj := Yj + (1 - Yj) * Aj;
        StilDe := StilDe + AlTilj;
        SumAlTilM1 := SumAlTilM1 + (AlTilj - 1);
      end;
      TrigStilDe := TrigammaF(StilDe);

      // Invariants across the K channels (Sstr, Qsum fixed for this cell).
      TwoOverS := 2 / Sstr;
      SP1 := Sstr + 1;
      OneMinusQ := 1 - Qsum;
      InvSP1Sq := 1 / (SP1 * SP1);

      for c := 0 to KcM1 do
      begin
        idxE := baseErr0 + c;
        Aj := FOutput.FData[baseOut0 + c];
        Pj := Aj / Sstr;
        Yj := Aj - FOutputError.FData[idxE];

        // dERR_A/dalpha_j for term A = sum_k (y_k - p_k)^2:
        //   = (2/S)*[ (p_j - y_j) - sum_k (p_k - y_k)*p_k ].
        dErr := TwoOverS * ((Pj - Yj) - PkMinusYkPk);

        // dERR_B/dalpha_j for term B = (1 - Q)/(S+1), Q = sum_k p_k^2:
        //   dQ/dalpha_j = (2/S)*(p_j - Q)
        //   dB/dalpha_j = [ -(dQ/dalpha_j)*(S+1) - (1-Q) ] / (S+1)^2.
        dB := ( -(TwoOverS * (Pj - Qsum)) * SP1 - OneMinusQ ) * InvSP1Sq;
        dErr := dErr + dB;

        // dKL/dalpha_j (chain through alphaTilde_j = y_j + (1-y_j)*alpha_j):
        //   dKL/dalphaTilde_j = (alphaTilde_j-1)*psi'(alphaTilde_j)
        //                       - (sum_k (alphaTilde_k-1))*psi'(StilDe)
        //   dalphaTilde_j/dalpha_j = (1 - y_j).
        AlTilj := Yj + (1 - Yj) * Aj;
        dKL := (1 - Yj) * ( (AlTilj - 1) * TrigammaF(AlTilj)
               - SumAlTilM1 * TrigStilDe );

        // softplus chain: dalpha_j/draw[j] = sigmoid(raw[j]).
        Raw := FPrevLayer.FOutput.FData[basePrev0 + c];
        Sig := SigmoidOf(Raw);
        FOutputError.FData[idxE] := (dErr + Lam * dKL) * Sig;
      end;
    end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetWingLoss }

constructor TNNetWingLoss.Create();
begin
  Create(10.0, 2.0);
end;

constructor TNNetWingLoss.Create(pWidth, pEpsilon: TNeuralFloat);
begin
  inherited Create();
  if pWidth <= 0 then
    FErrorProc('TNNetWingLoss width must be > 0.');
  if pEpsilon <= 0 then
    FErrorProc('TNNetWingLoss epsilon must be > 0.');
  FFloatSt[0] := pWidth;
  FFloatSt[1] := pEpsilon;
end;

procedure TNNetWingLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1: integer;
  Width, Eps, V, AbsV, Grad: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Width := FFloatSt[0];
  if Width <= 0 then Width := 10.0;
  Eps := FFloatSt[1];
  if Eps <= 0 then Eps := 2.0;
  SizeM1 := FOutputError.Size - 1;
  // Framework seeds FOutputError := output - target = r per element.
  for Idx := 0 to SizeM1 do
  begin
    V := FOutputError.FData[Idx];
    AbsV := Abs(V);
    if AbsV < Width then
      // dL/dr = w / (eps + |r|) * sign(r)
      Grad := Width / (Eps + AbsV)
    else
      // dL/dr = sign(r)
      Grad := 1.0;
    if V < 0 then Grad := -Grad;
    FOutputError.FData[Idx] := Grad;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetLabelSmoothingLoss }

constructor TNNetLabelSmoothingLoss.Create();
begin
  Create(0.1);
end;

constructor TNNetLabelSmoothingLoss.Create(pEps: TNeuralFloat);
begin
  inherited Create();
  if (pEps < 0) or (pEps >= 1) then
    FErrorProc('TNNetLabelSmoothingLoss eps must satisfy 0 <= eps < 1.');
  FFloatSt[0] := pEps;
end;

procedure TNNetLabelSmoothingLoss.Backpropagate();
var
  StartTime: double;
  Idx, SizeM1, NumClasses: integer;
  Eps, P, Seeded, Target, SmoothTarget, Uniform: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Eps := FFloatSt[0];
  if (Eps < 0) or (Eps >= 1) then Eps := 0.1;
  // Per (X,Y) position the target is one-hot over Depth, so NumClasses = Depth.
  NumClasses := FOutput.Depth;
  if NumClasses < 1 then NumClasses := 1;
  Uniform := Eps / NumClasses;
  SizeM1 := FOutputError.Size - 1;
  for Idx := 0 to SizeM1 do
  begin
    P := FOutput.FData[Idx];
    Seeded := FOutputError.FData[Idx];
    // Framework seeds FOutputError := output - target = p - t. Recover t,
    // build the smoothed target t' = (1-eps)*t + eps/NumClasses, then write
    // the smoothed softmax cross-entropy gradient p - t'.
    Target := P - Seeded;
    SmoothTarget := (1.0 - Eps) * Target + Uniform;
    FOutputError.FData[Idx] := P - SmoothTarget;
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetEntropyRegularizer }

constructor TNNetEntropyRegularizer.Create();
begin
  Create(0.01);
end;

constructor TNNetEntropyRegularizer.Create(pLambda: TNeuralFloat);
begin
  inherited Create();
  FFloatSt[0] := pLambda;
end;

procedure TNNetEntropyRegularizer.Backpropagate();
const
  cEntropyEps = 1e-7;
var
  StartTime: double;
  Idx, SizeM1: integer;
  Lambda, P: TNeuralFloat;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  Lambda := FFloatSt[0];
  SizeM1 := FOutputError.Size - 1;
  // Add the entropy-regularization gradient: d(-lambda * H(p))/dp_i =
  // lambda * (log(p_i) + 1). Offset p_i by eps inside the log to avoid
  // NaN when p_i is exactly zero.
  for Idx := 0 to SizeM1 do
  begin
    P := FOutput.FData[Idx];
    FOutputError.FData[Idx] := FOutputError.FData[Idx] +
      Lambda * (pcr_logf(P + cEntropyEps) + 1.0);
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  inherited BackpropagateNoTest();
end;

{ TNNetL2Normalize }

constructor TNNetL2Normalize.Create();
begin
  Create(0, 1e-8);
end;

constructor TNNetL2Normalize.Create(pEpsilon: TNeuralFloat);
begin
  // Preserves the historical axis-0 (per-(x,y)-over-depth) behavior.
  Create(0, pEpsilon);
end;

constructor TNNetL2Normalize.Create(pAxis: integer);
begin
  Create(pAxis, 1e-8);
end;

constructor TNNetL2Normalize.Create(pAxis: integer; pEpsilon: TNeuralFloat);
begin
  inherited Create();
  FStruct[0] := pAxis;
  FFloatSt[0] := pEpsilon;
  FInvNorms := TNNetVolume.Create();
end;

destructor TNNetL2Normalize.Destroy();
begin
  SetLength(FSumSqBuf, 0);
  SetLength(FDotBuf, 0);
  FInvNorms.Free;
  {$IFDEF OpenCL}
  if Assigned(FL2NormCL) then FreeAndNil(FL2NormCL);
  {$ENDIF}
  inherited Destroy();
end;

procedure TNNetL2Normalize.SetPrevLayer(pPrevLayer: TNNetLayer);
begin
  inherited SetPrevLayer(pPrevLayer);
  if FStruct[0] = 1 then
    // Full-volume mode caches a single reciprocal norm for the whole sample.
    FInvNorms.ReSize(1, 1, 1)
  else if FStruct[0] = 2 then
    // Per-channel mode caches one reciprocal norm per depth channel.
    FInvNorms.ReSize(1, 1, FOutput.Depth)
  else
    FInvNorms.ReSize(FOutput.SizeX, FOutput.SizeY, 1);
  // Per-channel scratch (sum-of-squares forward, dot backward), one per depth.
  SetLength(FSumSqBuf, FOutput.Depth);
  SetLength(FDotBuf, FOutput.Depth);
  {$IFDEF OpenCL}
  FShouldOpenCL := false; // bandwidth-bound: GPU < CPU at every size (OpenCLForwardBenchmark ~0.22x), pin to CPU. Old verdict: Int64(FOutput.Size) >= cNeuralOpenCLMinWork
  {$ENDIF}
end;

procedure TNNetL2Normalize.Compute();
var
  StartTime: double;
begin
  StartTime := Now();
  {$IFDEF OpenCL} if Assigned(FPrevLayer) then FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  {$IFDEF OpenCL}
  // Device forward for the per-depth-column mode (axis 0): the cai_l2norm_perdepth
  // kernel reduces each (x,y) position's depth run and scales by rsqrt(sum+eps),
  // keeping the activation resident on the GPU between offloaded conv/embedding
  // stacks. Forward-only; the per-channel/full-volume modes and all backward
  // passes stay on the CPU path (which also caches FInvNorms for backward).
  if WillOpenCL() then
  begin
    Inc(FForwardGPUCnt);
    ComputeOpenCL();
    FForwardTime := FForwardTime + (Now() - StartTime);
    exit;
  end
  else Inc(FForwardCPUCnt);
  {$ENDIF}
  if FStruct[0] = 1
    then ComputeFullVolume()
  else if FStruct[0] = 2
    then ComputePerChannel()
    else ComputePerDepth();
  FForwardTime := FForwardTime + (Now() - StartTime);
end;

procedure TNNetL2Normalize.ComputePerDepth();
var
  CntX, CntY, MaxX, MaxY, Cnt: integer;
  LocalPrevOutput: TNNetVolume;
  SumSq, InvN, Eps: TNeuralFloat;
  PrevPtr, OutPtr: TNeuralFloatArrPtr;
begin
  LocalPrevOutput := FPrevLayer.FOutput;
  Eps := FFloatSt[0];
  if Eps <= 0 then Eps := 1e-8;
  MaxX := LocalPrevOutput.SizeX - 1;
  MaxY := LocalPrevOutput.SizeY - 1;
  Cnt := LocalPrevOutput.Depth; // contiguous depth run length
  for CntX := 0 to MaxX do
  begin
    for CntY := 0 to MaxY do
    begin
      PrevPtr := LocalPrevOutput.GetRawPtr(CntX, CntY);
      OutPtr := FOutput.GetRawPtr(CntX, CntY);
      SumSq := TNNetVolume.DotProduct(PrevPtr, PrevPtr, Cnt);
      InvN := pcr_rsqrtf(SumSq + Eps);
      FInvNorms[CntX, CntY, 0] := InvN;
      system.Move(PrevPtr^, OutPtr^, Cnt * csNeuralFloatSize);
      TNNetVolume.Mul(OutPtr, InvN, Cnt);
    end;
  end;
end;

procedure TNNetL2Normalize.ComputeFullVolume();
var
  N: integer;
  LocalPrevOutput: TNNetVolume;
  SumSq, InvN, Eps: TNeuralFloat;
begin
  // Reduce sum-of-squares over the ENTIRE flattened sample so the whole
  // volume has unit L2 norm: y_i = x_i / sqrt(sum_k x_k^2 + eps).
  LocalPrevOutput := FPrevLayer.FOutput;
  Eps := FFloatSt[0];
  if Eps <= 0 then Eps := 1e-8;
  N := LocalPrevOutput.Size;
  SumSq := LocalPrevOutput.GetSumSqr();
  InvN := pcr_rsqrtf(SumSq + Eps);
  FInvNorms.FData[0] := InvN;
  system.Move(LocalPrevOutput.FData[0], FOutput.FData[0], N * csNeuralFloatSize);
  TNNetVolume.Mul(FOutput.GetRawPtr(), InvN, N);
end;

procedure TNNetL2Normalize.ComputePerChannel();
var
  CntX, CntY, CntD, MaxX, MaxY, MaxD, Depth: integer;
  LocalPrevOutput: TNNetVolume;
  Eps: TNeuralFloat;
  SumSqPtr, InvNPtr, PrevPtr, OutPtr: TNeuralFloatArrPtr;
begin
  // For each depth channel d independently, reduce sum-of-squares over all
  // (x,y) positions so that channel's spatial map has unit L2 norm:
  //   n_d = sqrt(sum_{x,y} x[x,y,d]^2 + eps); y[x,y,d] = x[x,y,d] / n_d.
  // Transpose-free AVX: each (x,y) owns a depth-CONTIGUOUS run, so the
  // per-channel sum-of-squares accumulates as a depth-aligned vector op
  // FSumSqBuf[d] += x[d]*x[d] (TVolume.MulAdd's 3-pointer depth form), and the
  // scale pass is the element-wise FInvNorms[d] multiply of each depth run --
  // both use the same AVX path the per-DEPTH / full-volume modes already take,
  // without ever gathering a stride-Depth column.
  LocalPrevOutput := FPrevLayer.FOutput;
  Eps := FFloatSt[0];
  if Eps <= 0 then Eps := 1e-8;
  MaxX := LocalPrevOutput.SizeX - 1;
  MaxY := LocalPrevOutput.SizeY - 1;
  MaxD := LocalPrevOutput.Depth - 1;
  Depth := LocalPrevOutput.Depth;
  SumSqPtr := addr(FSumSqBuf[0]);
  InvNPtr := FInvNorms.GetRawPtr(0, 0);
  FillChar(FSumSqBuf[0], (MaxD + 1) * csNeuralFloatSize, 0);
  for CntX := 0 to MaxX do
    for CntY := 0 to MaxY do
    begin
      PrevPtr := LocalPrevOutput.GetRawPtr(CntX, CntY);
      // FSumSqBuf[d] += x[d]*x[d] across the contiguous depth run.
      TNNetVolume.MulAdd(SumSqPtr, PrevPtr, PrevPtr, Depth);
    end;
  for CntD := 0 to MaxD do
    FInvNorms.FData[CntD] := pcr_rsqrtf(FSumSqBuf[CntD] + Eps);
  for CntX := 0 to MaxX do
    for CntY := 0 to MaxY do
    begin
      PrevPtr := LocalPrevOutput.GetRawPtr(CntX, CntY);
      OutPtr := FOutput.GetRawPtr(CntX, CntY);
      // y[d] = x[d] * invN[d] across the contiguous depth run.
      system.Move(PrevPtr^, OutPtr^, Depth * csNeuralFloatSize);
      TNNetVolume.Mul(OutPtr, InvNPtr, Depth);
    end;
end;

procedure TNNetL2Normalize.Backpropagate();
var
  StartTime: double;
begin
  StartTime := Now();
  Inc(FBackPropCallCurrentCnt);
  if FBackPropCallCurrentCnt < FDepartingBranchesCnt then exit;
  TestBackPropCallCurrCnt();
  if Assigned(FPrevLayer) and
    (FPrevLayer.OutputError.Size > 0) and
    (FPrevLayer.OutputError.Size = FPrevLayer.Output.Size) then
  begin
    if FStruct[0] = 1
      then BackpropagateFullVolume()
    else if FStruct[0] = 2
      then BackpropagatePerChannel()
      else BackpropagatePerDepth();
  end;
  FBackwardTime := FBackwardTime + (Now() - StartTime);
  FPrevLayer.Backpropagate();
end;

procedure TNNetL2Normalize.BackpropagatePerDepth();
var
  CntX, CntY, MaxX, MaxY, N: integer;
  Dot, InvN: TNeuralFloat;
  YPtr, GyPtr, PrevErrPtr: TNeuralFloatArrPtr;
begin
  // Per spatial position (X,Y), apply the L2-normalize Jacobian along Depth:
  //   dL/dx_i = (1/n) * (dL/dy_i - y_i * sum_j y_j * dL/dy_j)
  // which is the (I - y y^T) / n form (||y||=1 after the forward pass).
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  N := FOutput.Depth; // contiguous depth run length
  for CntX := 0 to MaxX do
  begin
    for CntY := 0 to MaxY do
    begin
      YPtr := FOutput.GetRawPtr(CntX, CntY);
      GyPtr := FOutputError.GetRawPtr(CntX, CntY);
      PrevErrPtr := FPrevLayer.OutputError.GetRawPtr(CntX, CntY);
      InvN := FInvNorms[CntX, CntY, 0];
      Dot := TNNetVolume.DotProduct(YPtr, GyPtr, N);
      // prevErr += InvN*gy - (InvN*Dot)*y
      TNNetVolume.MulAdd(PrevErrPtr, GyPtr, InvN, N);
      TNNetVolume.MulAdd(PrevErrPtr, YPtr, -(InvN * Dot), N);
    end;
  end;
end;

procedure TNNetL2Normalize.BackpropagateFullVolume();
var
  N: integer;
  Dot, InvN: TNeuralFloat;
  YPtr, GyPtr, PrevErrPtr: TNeuralFloatArrPtr;
begin
  // Apply the L2-normalize Jacobian over the WHOLE flattened sample:
  //   dL/dx_i = (1/n) * (dL/dy_i - y_i * sum_k y_k * dL/dy_k)
  // i.e. (I - y y^T) / n with ||y||=1 after the forward pass.
  N := FOutput.Size;
  InvN := FInvNorms.FData[0];
  YPtr := FOutput.GetRawPtr();
  GyPtr := FOutputError.GetRawPtr();
  PrevErrPtr := FPrevLayer.OutputError.GetRawPtr();
  Dot := TNNetVolume.DotProduct(YPtr, GyPtr, N);
  // prevErr += InvN*gy - (InvN*Dot)*y
  TNNetVolume.MulAdd(PrevErrPtr, GyPtr, InvN, N);
  TNNetVolume.MulAdd(PrevErrPtr, YPtr, -(InvN * Dot), N);
end;

procedure TNNetL2Normalize.BackpropagatePerChannel();
var
  CntX, CntY, CntD, MaxX, MaxY, MaxD: integer;
  Pos, idx: integer;
  Yi, InvN: TNeuralFloat;
begin
  // For each channel d, apply the L2-normalize Jacobian over its (x,y) map:
  //   dL/dx_i = invN_d * (gy_i - y_i * sum_j y_j * gy_j)
  // with i,j ranging over the spatial positions of channel d, invN_d the
  // cached reciprocal norm and ||y_channel||=1 after the forward pass.
  MaxX := FOutput.SizeX - 1;
  MaxY := FOutput.SizeY - 1;
  MaxD := FOutput.Depth - 1;
  FillChar(FDotBuf[0], (MaxD + 1) * csNeuralFloatSize, 0);
  for CntX := 0 to MaxX do
    for CntY := 0 to MaxY do
    begin
      Pos := FOutput.GetRawPos(CntX, CntY);
      TNNetVolume.MulAdd(@FDotBuf[0], @FOutput.FData[Pos], @FOutputError.FData[Pos], MaxD + 1);
    end;
  for CntX := 0 to MaxX do
    for CntY := 0 to MaxY do
    begin
      Pos := FOutput.GetRawPos(CntX, CntY);
      for CntD := 0 to MaxD do
      begin
        idx := Pos + CntD; // #4
        Yi := FOutput.FData[idx];
        InvN := FInvNorms.FData[CntD];
        FPrevLayer.OutputError.FData[idx] :=
          FPrevLayer.OutputError.FData[idx] +
          InvN * (FOutputError.FData[idx] - Yi * FDotBuf[CntD]);
      end;
    end;
end;

{$IFDEF OpenCL}
function TNNetL2Normalize.WillOpenCL(): boolean;
begin
  Result := (FStruct[0] = 0) and Assigned(FL2NormCL) and FHasOpenCL
            and (FShouldOpenCL or FForceOpenCL);
end;

procedure TNNetL2Normalize.DisableOpenCL();
begin
  inherited DisableOpenCL();
  FreeAndNil(FL2NormCL);
end;

procedure TNNetL2Normalize.EnableOpenCL(DotProductKernel: TNeuralKernel);
begin
  FHasOpenCL := true;
  if not Assigned(FL2NormCL) then
    FL2NormCL := TNNetL2NormCL.Create(FNN);
end;

// Device per-depth-column L2 normalization forward (axis 0): reduce each (x,y)
// position's depth run to its L2 norm and scale by rsqrt(sum + eps), faithful to
// the scalar ComputePerDepth() above (InvScale = 1.0: plain L2, no mean
// subtraction, no gain). Forward-only; backward stays on the CPU path.
procedure TNNetL2Normalize.ComputeOpenCL();
var
  Eps: TNeuralFloat;
begin
  {$IFDEF OpenCL} FPrevLayer.ForceOutputOnRAM(); {$ENDIF}
  Eps := FFloatSt[0];
  if Eps <= 0 then Eps := 1e-8;
  FL2NormCL.Normalize(FPrevLayer.FOutput, FOutput,
    FOutput.SizeX * FOutput.SizeY, FOutput.Depth, 1.0, Eps);
end;
{$ENDIF}

