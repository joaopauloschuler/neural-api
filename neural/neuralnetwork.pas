    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      Neuron := FNeurons[Cnt];
      Result := Result +
        Neuron.FBiasInertia +
        Neuron.FBiasInertia2 +
        Neuron.FBackInertia.GetSum() +
