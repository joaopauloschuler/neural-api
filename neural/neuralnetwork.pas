  /// Gaussian reparameterization trick for a continuous-latent VAE
  /// (Kingma & Welling 2014, "Auto-Encoding Variational Bayes").
  // Splits the input along the channel (depth) axis into two equal halves:
  // the first half is mu, the second half is log_var (each of depth D/2).
  // Output depth = input depth / 2. The layer emits the reparameterized
  // sample
  //   z = mu + sigma * eps,   sigma = exp(0.5 * log_var),   eps ~ N(0,1).
  // eps is drawn ONCE per forward pass, FROZEN into FEps, and REUSED in the
  // matching backward pass (exactly the fixed-noise pattern of
  // TNNetGumbelSoftmax / TNNetDropout: stochastic forward, deterministic
  // gradient that reuses the stored draw). Sampling is ON by default
  // (Enabled = true) since a VAE samples during both training and Compute;
  // EnableDropouts does NOT toggle this layer. Set Enabled := false manually
  // for deterministic mean-only inference: the layer emits z = mu (eps forced
  // to 0), the usual VAE inference convention.
  //
  // Backward (gradient g = dL/dz arrives on FOutputError):
  //   dz/dmu       = 1                  -> dL/dmu      = g
  //   dz/dlog_var  = 0.5 * sigma * eps  -> dL/dlog_var = g * 0.5 * sigma * eps
  //
  // KL-COMPOSITION DECISION: this layer contributes ONLY the reconstruction
  // (reparameterization) gradient. The standard-normal-prior KL term
  //   KL = -0.5 * sum(1 + log_var - mu^2 - exp(log_var))
  // is NOT added here. It is supplied by a SEPARATE loss head
  // (TNNetVAEKLDivergence) attached to the (mu|log_var) tensor BEFORE this
  // layer, mirroring how the codebase keeps loss heads separate from
  // transform layers (TNNetKLDivergence, TNNetPonderCostLoss). This keeps the
  // composition clean: the encoder forks into (a) reparameterize -> decoder ->
  // reconstruction loss and (b) the KL head, and the two gradients sum at the
  // (mu|log_var) fork. No trainable params.
  // Coded by Claude (AI).
  TNNetGaussianReparameterize = class(TNNetLayer)
  protected
    FEnabled: boolean;
    FEps: TNNetVolume; // frozen N(0,1) draw, sampled in Compute, reused in Backpropagate
    procedure SetPrevLayer(pPrevLayer: TNNetLayer); override;
  public
    constructor Create(); override;
    destructor Destroy(); override;
    procedure Compute(); override;
    procedure Backpropagate(); override;
    // Sampling toggle. true (default) = stochastic z = mu + sigma*eps;
    // false = deterministic mean-only inference z = mu.
    property Enabled: boolean read FEnabled write FEnabled;
    property Eps: TNNetVolume read FEps;
  end;

  /// Standard-normal-prior KL divergence loss head for a continuous-latent VAE.
  // Companion penalty head for TNNetGaussianReparameterize. Its input is the
  // (mu | log_var) tensor (the SAME tensor the reparameterize layer consumes):
  // the first half of the depth is mu, the second half is log_var. The forward
  // pass is an identity passthrough. Like TNNetKLDivergence / TNNetCenterLoss
  // it is a self-contained penalty with NO external target, so it IGNORES the
  // framework-seeded residual and overwrites FOutputError with the analytic
  // gradient of the per-element Gaussian-to-N(0,1) KL
  //   KL = -0.5 * sum(1 + log_var - mu^2 - exp(log_var))
  //   dKL/dmu      = mu
  //   dKL/dlog_var = 0.5 * (exp(log_var) - 1)
  // scaled by FFloatSt[0] (the KL weight / beta, default 1.0; the VAE
  // free-bits or beta-VAE knob). beta round-trips via Save/Load.
  // Coded by Claude (AI).
  TNNetVAEKLDivergence = class(TNNetIdentity)
  public
    constructor Create(); overload; override;
    constructor Create(pBeta: TNeuralFloat); reintroduce; overload;
    procedure Backpropagate(); override;
  end;

  /// Pairwise cosine similarity along the depth-half-split.
