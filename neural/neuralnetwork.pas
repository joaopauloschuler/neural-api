  FStruct[0] := ContentIdx;
  FStruct[1] := StyleIdx;
  FAdaEpsilon := 1e-5;
  FContentMean := TNNetVolume.Create();
  FContentInvStd := TNNetVolume.Create();
  FStyleMean := TNNetVolume.Create();
  FStyleStd := TNNetVolume.Create();
  FNormContent := TNNetVolume.Create();
