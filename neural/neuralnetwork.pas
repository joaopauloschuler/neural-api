function TNNetLayer.SupportsLowMemory(): boolean;
begin
  // Default: no per-neuron CPU forward path, so low-memory mode is unsupported.
  Result := False;
end;

// TNNetLayerThreading: the layer-side execution ancestor (see the class
// declaration). Coded by Claude (AI).

function TNNetLayerThreading.WillOpenCL(): boolean;
begin
  // Default: generic layers do not dispatch to an OpenCL kernel. Declared
  // unconditionally (outside {$IFDEF OpenCL}) so the scheduler's routing
  // code needs no conditional compilation; the overrides live inside the
  // layers' {$IFDEF OpenCL} blocks, so a non-OpenCL build correctly reports
  // False for every layer.
  Result := False;
end;

function TNNetLayerThreading.ChunkEligible(): boolean;
begin
  // Default: not chunk-decomposable.
  Result := False;
end;

function TNNetLayerThreading.WillThread(): boolean;
begin
  // Chunk-eligible AND a parallel pass is currently active. The serial path
  // leaves FParallelActive False, so this is False in serial execution - the
  // invariant that keeps all chunking inside the scheduler.
  Result := ChunkEligible() and (FNN <> nil) and FNN.FParallelActive;
end;

procedure TNNetLayerThreading.ComputeRange(StartRange, FinRange: integer);
begin
  // Must be overridden together with WillThread; reaching this body means a
  // WillThread override has no matching ComputeRange.
  raise Exception.Create(ClassName +
    '.ComputeRange is not implemented (WillThread/ComputeRange mismatch).');
end;

function TNNetLayerThreading.ChunkWorkCount(): integer;
begin
  // Default: not chunkable (ChunkEligible is False here).
  Result := 0;
end;

function TNNetLayer.ActiveLowMemory(): boolean;
begin
  Result := FLowMemory and SupportsLowMemory()
  {$IFDEF OpenCL} and not WillOpenCL() {$ENDIF};
end;

{$IFDEF OpenCL}
procedure TNNetLayer.ForceOpenCL(pForce: boolean);
begin
  FForceOpenCL := pForce;
end;
{$ENDIF}

procedure TNNetLayer.InitDefault();
begin
  InitGlorotBengioUniform();
end;

procedure TNNetLayer.Fill(value: TNeuralFloat);
var
  MaxNeuronPos: integer;
  Cnt: integer;
begin
  if (FNeurons.Count > 0) then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      FArrNeurons[Cnt].Fill(Value);  // #10: array mirror
    end;
  end;
  AfterWeightUpdate();
end;

procedure TNNetLayer.ClearDeltas();
var
  MaxNeuronPos: integer;
  Cnt: integer;
begin
  // Inference-only (SetTrainable(false)): the training volumes are freed.
  if not FIsTrainable then exit;
  if (FNeurons.Count > 0) then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      FArrNeurons[Cnt].ClearDelta();  // #10: array mirror
    end;
  end;
end;

procedure TNNetLayer.AddNeurons(NeuronNum: integer);
var
  I: integer;
begin
  for I := 1 to NeuronNum do
  begin
    FNeurons.Add(TNNetNeuron.Create());
  end;
  AfterWeightUpdate();
  // Keep the fast array mirror length in sync with the neuron count so the
  // safetensors/GGUF loaders/savers can index FArrNeurons before any forward
  // pass has triggered the lazy rebuild. (Coded by Claude (AI).)
  BuildArrNeurons();
end;

procedure TNNetLayer.AddMissingNeurons(NeuronNum: integer);
begin
  if FNeurons.Count < NeuronNum then
  begin
    AddNeurons(NeuronNum - FNeurons.Count);
  end;
  AfterWeightUpdate();
end;

procedure TNNetLayer.SetNumWeightsForAllNeurons(NumWeights: integer);
var
  MaxNeuronPos: integer;
  Cnt: integer;
begin
  if (FNeurons.Count > 0) and (FCanSetNumWeightsForAllNeurons) then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      FNeurons[Cnt].Weights.ReSize(NumWeights,1,1);
      // Inference-only layers skip the training-only buffers (see
      // SetTrainable), avoiding the ~5x weight-footprint allocation.
      if FIsTrainable then
      begin
        FNeurons[Cnt].BackInertia.ReSize(NumWeights,1,1);
        FNeurons[Cnt].Delta.ReSize(NumWeights,1,1);
      end;
    end;
    AfterWeightUpdate();
  end;
end;

procedure TNNetLayer.SetNumWeightsForAllNeurons(x, y, d: integer);
var
  MaxNeuronPos: integer;
  Cnt: integer;
  N: TNNetNeuron;
begin
  if (FNeurons.Count > 0) and (FCanSetNumWeightsForAllNeurons) then
  begin
    MaxNeuronPos := FNeurons.Count-1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      N := FNeurons[Cnt];  // #7: bind the list element once
      N.Weights.ReSize(x,y,d);
      // Inference-only layers skip the training-only buffers (see
      // SetTrainable), avoiding the ~5x weight-footprint allocation.
      if FIsTrainable then
      begin
        N.BackInertia.ReSize(x,y,d);
        N.Delta.ReSize(x,y,d);
      end;
    end;
    AfterWeightUpdate();
    // Keep the fast array mirror valid right after construction so the
    // safetensors/GGUF loaders/savers can index FArrNeurons before any
    // forward pass has triggered the lazy rebuild. (Coded by Claude (AI).)
    BuildArrNeurons();
  end;
end;

procedure TNNetLayer.SetNumWeightsForAllNeurons(Origin: TNNetVolume);
begin
  SetNumWeightsForAllNeurons(Origin.SizeX, Origin.SizeY, Origin.Depth);
end;

function TNNetLayer.GetMaxWeight(): TNeuralFloat;
begin
  Result := FNeurons.GetMaxWeight();
end;

function TNNetLayer.GetMaxAbsWeight(): TNeuralFloat;
begin
  Result := FNeurons.GetMaxAbsWeight();
end;

function TNNetLayer.GetMinWeight(): TNeuralFloat;
begin
  Result := FNeurons.GetMinWeight();
end;

function TNNetLayer.GetMaxDelta(): TNeuralFloat;
var
  MaxNeuronPos: integer;
  Cnt: integer;
  MaxValue: TNeuralFloat;
begin
  if FNeurons.Count > 0 then
  begin
    Result := FArrNeurons[0].Delta.GetMax();
    if FNeurons.Count > 1 then
    begin
      MaxNeuronPos := FNeurons.Count-1;
      // #4: neuron 0 is the seed above; start at 1 (max(a,a)=a, bit-identical).
      for Cnt := 1 to MaxNeuronPos do
      begin
        MaxValue := FArrNeurons[Cnt].Delta.GetMax();
        if MaxValue > Result then Result := MaxValue;
      end;
    end;
  end
  else
  begin
    Result := 0;
  end;
end;

function TNNetLayer.GetMaxAbsoluteDelta(): TNeuralFloat;
var
  Cnt: integer;
  MaxValue: TNeuralFloat;
  MaxNeurons: integer;
begin
  MaxNeurons := FNeurons.Count - 1;
  if MaxNeurons >= 0 then
  begin
    Result := FArrNeurons[0].Delta.GetMaxAbs();
    if MaxNeurons > 0 then
    begin
      // #4: neuron 0 is the seed above; start at 1 (max(a,a)=a, bit-identical).
      for Cnt := 1 to MaxNeurons do
      begin
        MaxValue := FArrNeurons[Cnt].Delta.GetMaxAbs();
        if MaxValue > Result then Result := MaxValue;
      end;
    end;
  end
  else
  begin
    Result := 0;
  end;
end;

function TNNetLayer.GetDeltaNorm(): TNeuralFloat;
var
  Cnt: integer;
  TotalNorm: TNeuralFloat;
  MaxNeurons: integer;
  Neuron: TNNetNeuron;
begin
  MaxNeurons := FNeurons.Count - 1;
  TotalNorm := 0;
  if MaxNeurons >= 0 then
  begin
    for Cnt := 0 to MaxNeurons do
    begin
      Neuron := FNeurons[Cnt];
      TotalNorm := TotalNorm +
        Neuron.Delta.GetSumSqr() +
        Neuron.FBiasDelta * Neuron.FBiasDelta;
    end;
    Result := Sqrt(TotalNorm);
  end
  else
  begin
    Result := 0;
  end;
end;

function TNNetLayer.GetWeightNorm(): TNeuralFloat;
var
  Cnt: integer;
  TotalNorm: TNeuralFloat;
  MaxNeurons: integer;
  Neuron: TNNetNeuron;
begin
  MaxNeurons := FNeurons.Count - 1;
  TotalNorm := 0;
  if MaxNeurons >= 0 then
  begin
    for Cnt := 0 to MaxNeurons do
    begin
      Neuron := FNeurons[Cnt];
      TotalNorm := TotalNorm +
        Neuron.FWeights.GetSumSqr() +
        Neuron.Bias * Neuron.Bias;
    end;
    Result := Sqrt(TotalNorm);
  end
  else
  begin
    Result := 0;
  end;
end;

procedure TNNetLayer.NormalizeMaxAbsoluteDeltaPerNeuron(MaxDelta: TNeuralFloat);
var
  Cnt: integer;
  MaxValue: TNeuralFloat;
  MaxNeurons: integer;
  D: TNNetVolume;
begin
  MaxNeurons := FNeurons.Count - 1;
  if MaxNeurons >= 0 then
  begin
    for Cnt := 0 to MaxNeurons do
    begin
      D := FNeurons[Cnt].Delta;  // #7: bind the Delta chain once
      MaxValue := D.GetMaxAbs();
      if (MaxDelta <> MaxValue) and (MaxValue>0) then
      begin
        D.Mul(MaxDelta/MaxValue);
      end;
    end;
  end
end;

function TNNetLayer.GetMinDelta(): TNeuralFloat;
var
  MaxNeuronPos: integer;
  Cnt: integer;
  MinValue: TNeuralFloat;
begin
  if FNeurons.Count > 0 then
  begin
    Result := FArrNeurons[0].Delta.GetMin();
    if FNeurons.Count > 1 then
    begin
      MaxNeuronPos := FNeurons.Count-1;
      // #4: neuron 0 is the seed above; start at 1 (min(a,a)=a, bit-identical).
      for Cnt := 1 to MaxNeuronPos do
      begin
        MinValue := FArrNeurons[Cnt].Delta.GetMin();
        if MinValue < Result then Result := MinValue;
      end;
    end;
  end
  else
  begin
    Result := 0;
  end;
end;

function TNNetLayer.ForceMaxAbsoluteDelta(vMax: TNeuralFloat): TNeuralFloat;
var
  MaxNeuronPos: integer;
  Cnt: integer;
  MaxValue, MulValue: TNeuralFloat;
  D: TNNetVolume;
begin
  Result := 1;
  if FNeurons.Count > 0 then
  begin
    MaxNeuronPos := FNeurons.Count - 1;
    for Cnt := 0 to MaxNeuronPos do
    begin
      D := FNeurons[Cnt].Delta;  // #7: bind the Delta chain once
      MaxValue := D.GetMaxAbs();
      if MaxValue > vMax then
      begin
        MulValue := vMax/MaxValue;
        D.Mul(MulValue);
        if MulValue < Result then Result := MulValue;
      end;
    end;
  end
end;

function TNNetLayer.ForceMaxAbsoluteWeight(vMax: TNeuralFloat): TNeuralFloat;
var
  V: TNeuralFloat;
begin
  V := Self.GetMaxAbsWeight();
  if (V <> vMax) and (V>0) then
  begin
    Self.MulWeights(vMax/V);
  end;
  Result := V;
end;

procedure TNNetLayer.GetMinMaxAtDepth(pDepth: integer; var pMin, pMax: TNeuralFloat);
var
  MaxNeuronPos: integer;
  Cnt: integer;
  localMin, localMax: TNeuralFloat;
begin
  if FNeurons.Count > 0 then
  begin
    FNeurons[0].Weights.GetMinMaxAtDepth(pDepth, localMin, localMax);
    pMin := localMin;
    pMax := localMax;
    if FNeurons.Count > 1 then
    begin
      MaxNeuronPos := FNeurons.Count-1;
      for Cnt := 1 to MaxNeuronPos do
      begin
        FNeurons[Cnt].Weights.GetMinMaxAtDepth(pDepth, localMin, localMax);
        pMin := Min(pMin, localMin);
        pMax := Max(pMax, localMax);
      end;
    end;
  end
end;

function TNNetLayer.GetWeightSum(): TNeuralFloat;
