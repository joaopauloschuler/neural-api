procedure TNNetLayer.ApplyActivationFunctionToOutput();
begin
  // Whole-buffer case. Preserve the former Copy/CopyRelu ReSize safety for
  // every activation (was implicit only on the Identity/ReLU branches).
  if FOutput.Size <> FOutputRaw.Size then FOutput.ReSize(FOutputRaw);
  if FOutput.Size > 0 then
    ApplyActivationFunctionToOutputRange(0, FOutput.Size - 1);
end;

procedure TNNetLayer.ApplyActivationFunctionToOutputRange(pFirst, pLast: integer);
const
  cInv6 = 1.0 / 6.0; // #5: FPC won't reciprocal a float /6 on its own
var
  OutputCnt: integer;
  x: TNeuralFloat;
begin
  if pLast < pFirst then exit;
  {$IFDEF FPC}
  if FActivationFn = @Identity then
  begin
    Move(FOutputRaw.FData[pFirst], FOutput.FData[pFirst],
      (pLast - pFirst + 1) * csNeuralFloatSize);
  end
  else
  if FActivationFn = @RectifiedLinearUnit then
  begin
    // Batched AVX2 relu-copy over the slice (falls back to a scalar loop on
    // non-AVX builds). dst[i] := max(src[i], 0); bit-exact vs the scalar form.
    TNNetVolume.Relu(@FOutput.FData[pFirst], @FOutputRaw.FData[pFirst],
      pLast - pFirst + 1);
  end
  else
  if FActivationFn = @Sigmoid then
  begin
    // Batched AVX2 kernel over the slice (Sigmoid falls back to a scalar
    // pcr-equivalent loop on non-AVX builds). Parity with scalar Sigmoid() is
    // within ~1e-6.
    TNNetVolume.Sigmoid(@FOutput.FData[pFirst], @FOutputRaw.FData[pFirst],
      pLast - pFirst + 1);
  end
  else
  if FActivationFn = @HiperbolicTangent then
  begin
    TNNetVolume.Tanh(@FOutput.FData[pFirst], @FOutputRaw.FData[pFirst],
      pLast - pFirst + 1);
  end
  else
  if FActivationFn = @HardSwish then
  begin
    for OutputCnt := pFirst to pLast do
    begin
      x := FOutputRaw.FData[OutputCnt];
      if x > 3 then
        FOutput.FData[OutputCnt] := x
      else if x < -3 then
        FOutput.FData[OutputCnt] := 0
      else
        FOutput.FData[OutputCnt] := x*(x + 3)*cInv6;
    end;
  end
  else
  begin
    for OutputCnt := pFirst to pLast do
      FOutput.FData[OutputCnt] := FActivationFn(FOutputRaw.FData[OutputCnt]);
  end;
  {$ELSE}
  for OutputCnt := pFirst to pLast do
    FOutput.FData[OutputCnt] := FActivationFn(FOutputRaw.FData[OutputCnt]);
  {$ENDIF}
end;

