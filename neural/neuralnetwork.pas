function NeuralInt8QuantizableClass(pLayer: TNNetLayer): boolean;
begin
  Result :=
    (pLayer.ClassType = TNNetConvolution) or
    (pLayer.ClassType = TNNetConvolutionLinear) or
    (pLayer.ClassType = TNNetConvolutionReLU) or
    // Rectangular convs inherit the square conv's im2col forward unchanged
    // (the flattened FeatureSizeX*FeatureSizeY*InDepth row is what the int8
    // codes quantize); WinogradEligible already rejects non-3x3 shapes and
    // the device im2col parameterizes X/Y extents separately.
    (pLayer.ClassType = TNNetConvolutionRectangular) or
    (pLayer.ClassType = TNNetConvolutionRectangularReLU) or
    // Activation-only conv aliases: their constructors set FActivationFn and
    // add nothing else, and the int8 forward is activation-agnostic (it ends
    // in ApplyActivationFunctionToOutput), so the shared storage applies.
    (pLayer.ClassType = TNNetConvolutionSwish) or
    (pLayer.ClassType = TNNetConvolutionHardSwish) or
    (pLayer.ClassType = TNNetPointwiseConv) or
    (pLayer.ClassType = TNNetPointwiseConvLinear) or
    (pLayer.ClassType = TNNetPointwiseConvReLU) or
    (pLayer.ClassType = TNNetFullConnect) or
    (pLayer.ClassType = TNNetFullConnectLinear) or
    (pLayer.ClassType = TNNetFullConnectReLU) or
    (pLayer.ClassType = TNNetFullConnectSigmoid) or
    // Empty alias subclasses (TNNetDense = class(TNNetFullConnect); etc.)
    // add no code of their own, so the shared int8 storage and forward
    // apply verbatim.
    (pLayer.ClassType = TNNetLayerFullConnect) or
    (pLayer.ClassType = TNNetLayerFullConnectReLU) or
    (pLayer.ClassType = TNNetDense) or
    (pLayer.ClassType = TNNetDenseReLU) or
    // Depthwise convs share the int8 storage; their fused forward
    // (ComputeInt8CPU/MulAddInt8) streams the codes per spatial tap and
    // applies the per-neuron scale once per output element.
    (pLayer.ClassType = TNNetDepthwiseConv) or
    (pLayer.ClassType = TNNetDepthwiseConvLinear) or
    (pLayer.ClassType = TNNetDepthwiseConvReLU) or
    // Grouped convs share the int8 storage; their fused forward
    // (GroupedDotProductsTiledInt8) streams the codes against the
    // grouped im2col input with per-row scales.
    (pLayer.ClassType = TNNetGroupedConvolutionLinear) or
    (pLayer.ClassType = TNNetGroupedConvolutionReLU) or
    (pLayer.ClassType = TNNetGroupedPointwiseConvLinear) or
    (pLayer.ClassType = TNNetGroupedPointwiseConvReLU) or
    (pLayer.ClassType = TNNetGroupedPointwiseConvHardSwish) or
    // Fused MoE expert banks. They leave FShouldConcatWeights false, so they
    // carry their own int8 forward (ComputeExpertsQuantizedInt8 /
    // ComputeMixtureQuantizedInt8) over the shared FQuantTable storage. Row
    // width is the source depth for the gate|up bank and the expert width for
    // the down bank, which is what the row-streaming importers expect.
    (pLayer.ClassType = TNNetMoEExpertBankGateUp) or
    (pLayer.ClassType = TNNetMoEExpertBankDown);
end;

procedure TNNet.QuantizeWeightsInt8();
var
  LayerCnt: integer;
  CurrentLayer: TNNetLayer;
  LastLayerIdx: integer;
begin
  // Self-arm the construction-time flag: the importers sweep per block
  // while STILL BUILDING, so every layer attached after the first sweep
  // arms its int8 container directly instead of allocating FP32 rows that
  // this sweep would only shrink again (see ArmBuildQuantInt8Storage).
  FBuildQuantInt8 := true;
  LastLayerIdx := GetLastLayerIdx();
  for LayerCnt := 0 to LastLayerIdx do
  begin
    CurrentLayer := FLayers[LayerCnt];
    // Eligibility lives in NeuralInt8QuantizableClass - the same predicate
    // the construction-time arming uses, so the two can never drift.
    if NeuralInt8QuantizableClass(CurrentLayer) then
    begin
      TNNetLayerConcatedWeights(CurrentLayer).QuantizeWeightsInt8();
    end
    // The embedding stores its vocab table outside the concated-weights
    // storage and carries its own int8 container. The positional subclass
    // quantizes the same inherited token table (its positional table is
    // computed sinusoidal data, not weights).
    else if (CurrentLayer.ClassType = TNNetEmbedding) or
       (CurrentLayer.ClassType = TNNetTokenAndPositionalEmbedding) then
    begin
      TNNetEmbedding(CurrentLayer).QuantizeWeightsInt8();
    end;
  end;
end;

function TNNet.ResizeTokenEmbeddings(NewVocabSize: integer): TNNetEmbedding;
var
  EmbLayer: TNNetEmbedding;
  Head: TNNetConvolutionBase;
  LastLayer: TNNetLayer;
  LayerCnt, RowCnt, ColCnt, rowBase: integer;
  OldVocab, EmbSize, CopyRows: integer;
  OldW, OldHeadW: TNNetVolume;
  MeanRow: array of TNeuralFloat;
  OldBias: array of TNeuralFloat;
  MeanBias: TNeuralFloat;
  HeadVecSize: integer;
  LastLayerIdx: integer;
  EmbSizeM1, OldVocabM1, CopyRowsM1, NewVocabSizeM1, HeadVecSizeM1: integer;
  EmbWasFrozen, EmbWasQuant, HeadWasFrozen, HeadWasQuant: boolean;
  W, HW: TNNetVolume;
begin
  Result := nil;
  if NewVocabSize <= 0 then
  begin
    FErrorProc('ResizeTokenEmbeddings: new vocab size must be positive, got '
      + IntToStr(NewVocabSize) + '.');
    exit;
  end;
  // Locate the FIRST embedding layer (TNNetTokenAndPositionalEmbedding is a
  // descendant and is matched too).
  EmbLayer := nil;
  NewVocabSizeM1 := NewVocabSize - 1;
  LastLayerIdx := GetLastLayerIdx();
  for LayerCnt := 0 to LastLayerIdx do
  begin
    if FLayers[LayerCnt] is TNNetEmbedding then
    begin
      EmbLayer := TNNetEmbedding(FLayers[LayerCnt]);
      break;
    end;
  end;
  if EmbLayer = nil then
  begin
    FErrorProc('ResizeTokenEmbeddings: no TNNetEmbedding layer found.');
    exit;
  end;
  OldVocab := EmbLayer.VocabSize;
  EmbSize := EmbLayer.EmbeddingSize;
  OldVocabM1 := OldVocab - 1;
  EmbSizeM1 := EmbSize - 1;
  Result := EmbLayer;
  if NewVocabSize = OldVocab then exit;

  // LM-head detection: the LAST layer, when it is a pointwise convolution
  // with exactly OldVocab output channels. Heads buried mid-net are NOT
  // resized (downstream layers would need a shape re-propagation); every
  // importer in neuralpretrained.pas ends the net with the LM head.
  Head := nil;
  LastLayer := GetLastLayer();
  if (LastLayer <> EmbLayer) and (LastLayer is TNNetConvolutionBase) and
     TNNetConvolutionBase(LastLayer).Pointwise and
     (LastLayer.Neurons.Count = OldVocab) then
    Head := TNNetConvolutionBase(LastLayer);

  // ---------------- Embedding table ----------------
  EmbWasQuant := EmbLayer.WeightsQuantizedInt8;
  if EmbWasQuant then EmbLayer.DequantizeWeightsInt8();
  W := EmbLayer.Neurons[0].Weights;
  EmbWasFrozen := EmbLayer.Neurons[0].Delta.Size < W.Size;
  OldW := TNNetVolume.Create;
  try
    OldW.Copy(W);
    // Mean of the existing rows (HF convention for new token rows).
    SetLength(MeanRow, EmbSize);
    for ColCnt := 0 to EmbSizeM1 do MeanRow[ColCnt] := 0;
    for RowCnt := 0 to OldVocabM1 do
    begin
      rowBase := RowCnt * EmbSize;
      for ColCnt := 0 to EmbSizeM1 do
        MeanRow[ColCnt] := MeanRow[ColCnt] +
          OldW.FData[rowBase + ColCnt];
    end;
    for ColCnt := 0 to EmbSizeM1 do
      MeanRow[ColCnt] := MeanRow[ColCnt] / OldVocab;
    EmbLayer.SetNumWeightsForAllNeurons(NewVocabSize, 1, EmbSize);
    CopyRows := Min(OldVocab, NewVocabSize);
    CopyRowsM1 := CopyRows - 1;
    // Contiguous block copy of the retained rows (#13).
    if CopyRows > 0 then
      Move(OldW.FData[0], W.FData[0], CopyRows * EmbSize * csNeuralFloatSize);
    for RowCnt := CopyRows to NewVocabSizeM1 do
    begin
      rowBase := RowCnt * EmbSize;
      Move(MeanRow[0], W.FData[rowBase], EmbSize * csNeuralFloatSize);
    end;
  finally
    OldW.Free;
  end;
  EmbLayer.FVocabSize := NewVocabSize;
  EmbLayer.FStruct[0] := NewVocabSize;
  if EmbWasFrozen then EmbLayer.SetTrainable(False);
  EmbLayer.AfterWeightUpdate();
  if EmbWasQuant then EmbLayer.QuantizeWeightsInt8();

  // ---------------- LM head ----------------
  if Head <> nil then
  begin
    HeadWasQuant := Head.WeightsQuantizedInt8;
    if HeadWasQuant then Head.DequantizeWeightsInt8();
    HeadVecSize := Head.Neurons[0].Weights.Size;
    HeadVecSizeM1 := HeadVecSize - 1;
    HeadWasFrozen :=
      Head.Neurons[0].Delta.Size < Head.Neurons[0].Weights.Size;
    OldHeadW := TNNetVolume.Create;
    try
      // Snapshot existing rows + biases and their means BEFORE mutating.
      OldHeadW.ReSize(OldVocab, 1, HeadVecSize);
      SetLength(OldBias, OldVocab);
      SetLength(MeanRow, HeadVecSize);
      for ColCnt := 0 to HeadVecSizeM1 do MeanRow[ColCnt] := 0;
      MeanBias := 0;
      for RowCnt := 0 to OldVocabM1 do
      begin
        HW := Head.Neurons[RowCnt].Weights;
        rowBase := RowCnt * HeadVecSize;
        // Snapshot the row (contiguous copy) and fold it into the running mean.
        Move(HW.FData[0], OldHeadW.FData[rowBase], HeadVecSize * csNeuralFloatSize);
        TNNetVolume.Add(@MeanRow[0], HW.GetRawPtr(0), HeadVecSize);
        OldBias[RowCnt] := Head.Neurons[RowCnt].BiasWeight;
        MeanBias := MeanBias + Head.Neurons[RowCnt].BiasWeight;
      end;
      for ColCnt := 0 to HeadVecSizeM1 do
        MeanRow[ColCnt] := MeanRow[ColCnt] / OldVocab;
      MeanBias := MeanBias / OldVocab;
      // Adjust the neuron count, then rebuild the layer geometry through
      // SetPrevLayer: output volumes, vector sizes, concatenated-weight
      // caches and tiling all derive from FNeurons.Count there. It re-inits
      // the weights (InitDefault), so the snapshot is written back below.
      // FShouldConcatWeights must be OFF while the neuron count disagrees
      // with the output volumes: AddNeurons/SetNumWeightsForAllNeurons call
      // AfterWeightUpdate, and BuildBiasOutput would write FNeurons.Count
      // bias floats per position into FBiasOutput rows still pitched at
      // OldVocab (heap overflow). SetPrevLayer resizes the volumes and then
      // switches the flag back on before its InitDefault rebuilds caches.
      Head.FShouldConcatWeights := false;
      if NewVocabSize > OldVocab then
        Head.AddNeurons(NewVocabSize - OldVocab)
      else
        for RowCnt := OldVocabM1 downto NewVocabSize do
          Head.FNeurons.Delete(RowCnt);
      Head.FStruct[0] := NewVocabSize;
      Head.SetPrevLayer(Head.FPrevLayer);
      CopyRows := Min(OldVocab, NewVocabSize);
      CopyRowsM1 := CopyRows - 1;
      for RowCnt := 0 to CopyRowsM1 do
      begin
        HW := Head.Neurons[RowCnt].Weights;
        rowBase := RowCnt * HeadVecSize;
        Move(OldHeadW.FData[rowBase], HW.FData[0], HeadVecSize * csNeuralFloatSize);
        Head.Neurons[RowCnt].BiasWeight := OldBias[RowCnt];
      end;
      for RowCnt := CopyRows to NewVocabSizeM1 do
      begin
        HW := Head.Neurons[RowCnt].Weights;
        Move(MeanRow[0], HW.FData[0], HeadVecSize * csNeuralFloatSize);
        Head.Neurons[RowCnt].BiasWeight := MeanBias;
      end;
    finally
      OldHeadW.Free;
    end;
    if HeadWasFrozen then Head.SetTrainable(False);
    Head.FlushWeightCache();
    if HeadWasQuant then Head.QuantizeWeightsInt8();
  end;
end;

